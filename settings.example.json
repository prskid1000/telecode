{
  "telegram": {
    "bot_token": "YOUR_BOT_TOKEN",
    "group_id": -100YOUR_GROUP_ID,
    "allowed_user_ids": [],
    "auto_start": false,
    "auto_restart": true
  },

  "paths": {
    "store_path": "./data/telecode.json",
    "logs_dir": "./data/logs"
  },

  "streaming": {
    "interval_sec": 0.8,
    "max_message_length": 3800,
    "idle_timeout_sec": 1800,
    "idle_sec": 2.0,
    "max_wait_sec": 5.0,
    "dump_raw_pty": false
  },

  "voice": {
    "stt": {
      "enabled": false,
      "base_url": "http://127.0.0.1:6600/v1"
    },
    "tts": {
      "enabled": false,
      "base_url": "http://127.0.0.1:6600/v1"
    }
  },

  "capture": {
    "image_interval": 15,
    "video_interval": 60
  },

  "heartbeat": {
    "enabled": false,
    "tick_seconds": 60,
    "ephemeral_ttl_seconds": 3600,
    "max_concurrent_fires": 2,
    "min_fire_gap_seconds": 60
  },

  "mcp_server": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 1236,
    "cors_origins": [],
    "tts_url": "http://127.0.0.1:6600",
    "stt_url": "http://127.0.0.1:6600"
  },

  "docgraph": {
    "binary": "",

    "host": {
      "enabled": false,
      "auto_start": false,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 5500,
      "debounce": 500
    },

    "roots": [
      { "path": "", "watch": false }
    ],

    "_roots_note": "Extra per-root config lives in <root>/.docgraph/ — not in settings.json. Adding/removing a root auto-restarts the host so the new workspace slug is registered.",
    "_repos_note": "Extra local paths to index into the SAME graph as a root: <root>/.docgraph/repos.json  [ \"/path/to/sibling\" ]. Use for monorepos / sibling projects. Editable via tray 'Extra local paths' panel.",
    "_links_note": "External URLs to crawl+index alongside the code: <root>/.docgraph/links.json. Each entry: { \"url\": \"https://…\", \"depth\": 1, \"max_pages\": 50, \"ttl_hours\": 24 }. depth=0 = seed page only; depth=1 = seed + all direct links. max_pages caps BFS (0 = unlimited). Editable via tray 'External links' panel.",

    "llm": {
      "model": "",
      "host": "localhost",
      "port": 1235,
      "format": "openai",
      "max_tokens": 150,
      "max_tokens_wiki": 4096,
      "max_tokens_chat": 0,
      "api_key": "",
      "timeout": 60,
      "docstrings": false,
      "wiki": false,
      "prompts": {
        "docstring": "",
        "wiki": ""
      }
    },

    "embeddings": {
      "model": "",
      "gpu": false,
      "idle_unload_sec": 0
    },

    "rerank": {
      "model": "",
      "default": false,
      "gpu": false,
      "idle_unload_sec": 0
    },

    "index": {
      "workers": 0,
      "embed_batch_size": 0
    },

    "wiki": {
      "depth": 12
    }
  },

  "llamacpp": {
    "enabled": false,
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 1234,
    "auto_start": false,
    "idle_unload_sec": 300,
    "ready_timeout_sec": 120,
    "api_key": "",

    "default_model": "your-model",

    "_comment_defaults":
      "Values below mirror llama-server v9243 upstream defaults so this file shows 'do nothing' baselines. Tune per machine in your live settings.json.",

    "threads": -1,
    "threads_batch": -1,
    "batch_size": 2048,
    "ubatch_size": 512,
    "parallel": -1,
    "cont_batching": true,

    "cpu_strict": 0,
    "cpu_strict_batch": 0,
    "prio": 0,
    "prio_batch": 0,
    "poll": 50,
    "poll_batch": 50,
    "threads_http": -1,

    "mlock": false,
    "no_mmap": false,
    "direct_io": false,
    "no_host": false,
    "repack": true,
    "op_offload": true,
    "check_tensors": false,
    "skip_chat_parsing": false,

    "n_predict": -1,
    "timeout": 600,
    "api_prefix": "",
    "media_path": "",
    "metrics": false,
    "props": false,
    "slots": true,

    "_comment_server_mode":
      "Set embedding=true OR rerank=true (mutually exclusive with chat mode) to repurpose llama-server as an embedding/reranker endpoint. Leave both false for normal chat completions. pooling only applies in embedding mode.",
    "embedding": false,
    "rerank": false,
    "pooling": "",

    "main_gpu": 0,
    "tensor_split": "",
    "split_mode": "layer",
    "numa": "",

    "seed": -1,
    "keep": 0,

    "kv_offload": true,
    "kv_unified": false,
    "cache_prompt": true,
    "cache_idle_slots": true,
    "context_shift": false,
    "warmup": true,
    "cache_ram": 8192,
    "swa_full": false,
    "ctx_checkpoints": 32,
    "checkpoint_every_n_tokens": 8192,
    "sleep_idle_seconds": 0,
    "slot_save_path": "",

    "_comment_spec_type":
      "spec_type accepts a comma-separated list (v9243+). Values: none, draft-simple, draft-eagle3, draft-mtp, ngram-simple, ngram-map-k, ngram-map-k4v, ngram-mod, ngram-cache. Set spec_default=true instead to let the server auto-pick based on model heads.",
    "spec_type": "",
    "spec_default": false,

    "_comment_spec_ngram":
      "Per-mode ngram knobs. spec_ngram_size_n/_m/_min_hits feed the (lookup-N, draft-M, min-hits) triplet of ngram-simple / ngram-map-k / ngram-map-k4v. spec_ngram_mod_* feed ngram-mod's (n-min, n-max, n-match) which has different semantics. 0 = use server default.",
    "spec_ngram_size_n": 0,
    "spec_ngram_size_m": 0,
    "spec_ngram_min_hits": 0,
    "spec_ngram_mod_n_min": 0,
    "spec_ngram_mod_n_max": 0,
    "spec_ngram_mod_n_match": 0,
    "threads_draft": 0,
    "threads_batch_draft": 0,

    "models": {
      "your-model": {
        "path": "/absolute/path/to/model.gguf",
        "mmproj": "",
        "mmproj_offload": true,
        "image_min_tokens": 0,
        "image_max_tokens": 0,
        "preload": false,

        "ctx_size": 0,
        "n_gpu_layers": 99,

        "flash_attn": true,

        "cache_type_k": "f16",
        "cache_type_v": "f16",
        "cache_reuse": 0,

        "n_cpu_moe": 0,
        "cpu_moe": false,

        "rope_scaling": "",
        "rope_freq_base": 0,
        "rope_freq_scale": 0,
        "yarn_orig_ctx": 0,
        "yarn_ext_factor": 0,
        "yarn_attn_factor": 0,
        "yarn_beta_slow": 0,
        "yarn_beta_fast": 0,

        "device": "",
        "override_tensor": "",
        "override_kv": "",

        "chat_template": "",
        "chat_template_file": "",
        "jinja": true,

        "_comment_draft":
          "v9243 reduced spec-draft-n-max default 16->3 and spec-draft-p-min default 0.75->0.00. cpu_moe_draft / n_cpu_moe_draft mirror the main-model MoE-offload knobs but for the draft model.",
        "draft_model": "",
        "n_gpu_layers_draft": 0,
        "cache_type_k_draft": "",
        "cache_type_v_draft": "",
        "device_draft": "",
        "cpu_moe_draft": false,
        "n_cpu_moe_draft": 0,
        "draft_n": 3,
        "draft_n_min": 0,
        "draft_p_min": 0,
        "draft_p_split": 0.10,
        "spec_draft_override_tensor": "",
        "lookup_cache_static": "",
        "lookup_cache_dynamic": "",

        "_comment_reasoning":
          "reasoning: 'on'|'off'|'auto'|'' (empty = use server default which is 'auto'). reasoning_budget caps the number of thinking tokens. reasoning_format controls how thoughts are returned (none / deepseek / deepseek-legacy).",
        "reasoning": "",
        "reasoning_budget": -1,
        "reasoning_budget_message": -1,
        "reasoning_format": "",

        "lora": "",
        "lora_scale": 1.0,

        "grammar": "",
        "grammar_file": "",

        "extra_args": [
          ["--example-extra-flag", "value"]
        ],

        "inference_defaults": {
          "temperature": 0.6,
          "top_p": 0.95,
          "top_k": 20,
          "presence_penalty": 1.0,
          "reasoning": {
            "enabled": true,
            "start": "<think>",
            "end": "</think>",
            "emit_thinking_blocks": true
          }
        }
      }
    },

    "_comment_inference":
      "Inference defaults below are PROXY-APPLIED per-request body fields (NOT spawn-time CLI flags). Override hierarchy: request body > models.<name>.inference_defaults > llamacpp.inference. Per-model defaults are the preferred place to set per-model sampler tuning — only set knobs here for global fallbacks. Sampler rows in the tray UI live under the per-model form for the same reason.",

    "inference": {
      "temperature": 0.6,
      "top_p": 0.95,
      "top_k": 20,
      "min_p": 0,
      "repeat_penalty": 1.0,
      "presence_penalty": 0.0,
      "frequency_penalty": 0.0,
      "max_tokens": null,
      "stop": [],
      "context_overflow": "truncate_middle",
      "drop_prior_thinking": true,

      "reasoning": {
        "enabled": true,
        "start": "<think>",
        "end": "</think>",
        "emit_thinking_blocks": true
      },

      "reasoning_effort_map": {
        "_doc":     "thinking_budget_tokens: key present -> cap thinking at that many tokens (auto-clamped to >=1). Key absent -> unlimited thinking (model decides). Matches Anthropic/OpenAI body conventions.",
        "none":     {"thinking_budget_tokens": 1},
        "minimal":  {"thinking_budget_tokens": 1},
        "low":      {"thinking_budget_tokens": 1024},
        "medium":   {"thinking_budget_tokens": 4096},
        "high":     {"thinking_budget_tokens": 16384},
        "xhigh":    {"thinking_budget_tokens": 65536},
        "max":      {},
        "adaptive": {"thinking_budget_tokens": 16384}
      },

      "structured_output": { "enabled": false, "schema": null, "grammar": null }
    },

    "extra_args": []
  },

  "proxy": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 1235,
    "protocols": ["anthropic", "openai"],
    "debug": false,

    "tool_search": false,
    "strip_reminders": false,
    "auto_load_tools": false,
    "sort_tools": false,
    "location": "",
    "max_roundtrips": 15,
    "ping_interval": 10,

    "core_tools": ["Bash", "Edit", "Read", "Write", "Glob", "Grep", "Agent", "Skill"],
    "cors_origins": [],

    "model_mapping": {
      "claude-opus-4-6": "your-model",
      "claude-sonnet-4-6": "your-model"
    },

    "client_profiles": [
      {
        "name": "e2e-test",
        "match": {"header": "User-Agent", "contains": "telecode-e2e"},
        "tool_search": false,
        "inject_date_location": false,
        "strip_reminders": false,
        "auto_load_tools": false,
        "inject_managed": []
      },
      {
        "name": "office",
        "match": {"header": "Referer", "contains": "pivot.claude.ai"},
        "system_instruction": "office.md",
        "tool_search": false,
        "inject_date_location": false,
        "strip_reminders": false,
        "auto_load_tools": false,
        "core_tools": [],
        "inject_managed": ["code_execution", "web_search"],
        "strip_tool_names": []
      },
      {
        "name": "claude-code",
        "match": {"header": "User-Agent", "contains": "claude-cli"},
        "system_instruction": "system.md",
        "tool_search": true,
        "inject_date_location": true,
        "strip_reminders": true,
        "auto_load_tools": true,
        "core_tools": ["Bash", "Edit", "Read", "Write", "Glob", "Grep", "Agent", "Skill"],
        "inject_managed": [
          "web_search"
        ],
        "strip_tool_names": []
      }
    ]
  },

  "tools": {
    "claude": {
      "name": "Claude Code",
      "icon": "\ud83d\udfe3",
      "startup_cmd": ["claude"],
      "flags": ["--dangerously-skip-permissions"],
      "env": { "ANTHROPIC_API_KEY": "" },
      "session": { "resume_id": "" }
    },
    "claude-local": {
      "name": "Claude Code (Local)",
      "icon": "\ud83d\udfe4",
      "startup_cmd": ["claude"],
      "flags": ["--dangerously-skip-permissions", "--max-turns", "100"],
      "env": {
        "ANTHROPIC_BASE_URL": "http://localhost:1235",
        "ANTHROPIC_AUTH_TOKEN": "local",
        "ANTHROPIC_MODEL": "your-model",
        "DISABLE_PROMPT_CACHING": "1"
      },
      "session": { "resume_id": "" }
    },
    "codex": {
      "name": "Codex CLI",
      "icon": "\ud83d\udfe2",
      "startup_cmd": ["codex"],
      "flags": [],
      "env": {"OPENAI_API_KEY": ""},
      "session": {}
    },
    "codex-local": {
      "name": "Codex CLI (Local)",
      "icon": "\ud83d\udfe0",
      "startup_cmd": ["codex"],
      "flags": ["--oss", "-m", "qwen3.5-9b"],
      "env": {},
      "session": {}
    },
    "shell": {
      "name": "Bash",
      "icon": "\ud83d\udc1a",
      "startup_cmd": ["bash", "--norc", "--noprofile"],
      "flags": [],
      "env": {},
      "session": {},
      "streaming": { "idle_sec": 0.5, "max_wait_sec": 2.5 }
    },
    "powershell": {
      "name": "PowerShell",
      "icon": "\ud83d\udd37",
      "startup_cmd": ["powershell.exe", "-NoProfile", "-NoLogo"],
      "flags": [],
      "env": {},
      "session": {},
      "streaming": { "idle_sec": 0.5, "max_wait_sec": 2.5 }
    },
    "computer": {
      "name": "Computer Control",
      "icon": "\ud83d\udda5\ufe0f",
      "api": {
        "base_url": "http://localhost:1235/v1",
        "api_key": "local",
        "model": "your-model",
        "format": "openai"
      },
      "capture_interval": 3,
      "max_history": 20,
      "system_prompt": ""
    }
  }
}

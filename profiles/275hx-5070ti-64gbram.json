  "proxy": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 1235,
    "protocols": [
      "anthropic",
      "openai"
    ],
    "cors_origins": [
      "https://pivot.claude.ai"
    ],
    "model_mapping": {
      "claude-opus-5": "qwen3.6-35b-a3b",
      "claude-sonnet-5": "qwen3.8-27b"
    },
    "client_profiles": [
      {
        "name": "e2e-test",
        "match": {
          "header": "User-Agent",
          "contains": "telecode-e2e"
        },
        "tool_search": false,
        "inject_date_location": false,
        "strip_reminders": false,
        "auto_load_tools": false,
        "inject_managed": [
          "code_execution",
          "docgraph_call_graph",
          "docgraph_cypher",
          "docgraph_definition",
          "docgraph_explore",
          "docgraph_file_map",
          "docgraph_git_blame",
          "docgraph_git_changes",
          "docgraph_git_recent",
          "docgraph_impact_of",
          "docgraph_list_roots",
          "docgraph_neighborhood",
          "docgraph_references",
          "docgraph_rules_for",
          "docgraph_search",
          "docgraph_test_impact",
          "web_search"
        ],
        "keep_claude_md": -1
      },
      {
        "name": "office",
        "match": {
          "header": "Referer",
          "contains": "pivot.claude.ai"
        },
        "system_instruction": "office.md",
        "tool_search": true,
        "inject_date_location": true,
        "inject_managed": [
          "code_execution",
          "web_search"
        ],
        "auto_load_tools": true,
        "strip_reminders": true,
        "sort_tools": true,
        "strip_skills": true,
        "strip_mcp_instructions": true,
        "keep_claude_md": 0,
        "keep_memory": 0
      },
      {
        "name": "claude-code",
        "match": {
          "header": "User-Agent",
          "contains": "claude-cli"
        },
        "system_instruction": "system.md",
        "tool_search": true,
        "strip_reminders": true,
        "auto_load_tools": true,
        "inject_date_location": true,
        "inject_managed": [
          "web_search",
          "docgraph_list_roots",
          "docgraph_search",
          "docgraph_definition",
          "docgraph_references",
          "docgraph_call_graph",
          "docgraph_file_map",
          "docgraph_neighborhood",
          "docgraph_explore",
          "docgraph_impact_of",
          "docgraph_test_impact",
          "docgraph_git_changes",
          "docgraph_git_blame",
          "docgraph_git_recent",
          "docgraph_rules_for",
          "docgraph_cypher"
        ],
        "core_tools": [
          "Bash",
          "Edit",
          "Read",
          "Write",
          "Glob",
          "Grep",
          "Agent",
          "Skill"
        ],
        "sort_tools": true,
        "keep_claude_md": 2,
        "strip_skills": false,
        "strip_mcp_instructions": false,
        "strip_client_system_prompt": true
      }
    ],
    "debug": true,
    "tool_search": true,
    "auto_load_tools": true,
    "strip_reminders": true,
    "mid_system_messages": "demote",
    "max_roundtrips": 15,
    "sort_tools": true,
    "keep_claude_md": -1,
    "strip_client_system_prompt": false,
    "strip_skills": false,
    "strip_mcp_instructions": false

+/**
+ * Frame slides (telecode / TeleDesign).
+ *
+ * A page's top-level frames are its slides, in layer order (first child = slide 1).
+ * TeleDesign's Slides panel lists them, reorders them (one undo step, optionally
+ * lining them up left to right so the canvas reads in slide order too) and
+ * presents / exports them through the regular export_image / export_pdf tools.
+ */
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+import type { EditorStore } from '@/app/editor/session'
+
+import { boardKeyOf } from './boards'
+
+const SLIDE_TYPES = new Set(['FRAME', 'COMPONENT', 'COMPONENT_SET', 'SECTION', 'INSTANCE'])
+const GAP = 100
+
+function isSlide(node: SceneNode | undefined): node is SceneNode {
+  return !!node && SLIDE_TYPES.has(node.type) && node.visible !== false
+}
+
+export function listSlides(store: EditorStore, pageId: string) {
+  const page = store.graph.getNode(pageId)
+  if (!page || page.type !== 'CANVAS') throw new Error(`Page not found: ${pageId}`)
+  const out = []
+  for (const id of page.childIds) {
+    const node = store.graph.getNode(id)
+    if (!isSlide(node)) continue
+    const board = boardKeyOf(node)
+    out.push({
+      id: node.id,
+      name: node.name,
+      type: node.type,
+      index: out.length + 1,
+      x: node.x,
+      y: node.y,
+      width: node.width,
+      height: node.height,
+      ...(board ? { board } : {})
+    })
+  }
+  return { page_id: page.id, page_name: page.name, slides: out }
+}
+
+export async function reorderSlides(
+  store: EditorStore,
+  pageId: string,
+  ids: unknown,
+  arrange: boolean
+) {
+  if (!Array.isArray(ids) || !ids.every((id) => typeof id === 'string')) {
+    throw new Error('"ids" must be an array of node ids')
+  }
+  const graph = store.graph
+  const page = graph.getNode(pageId)
+  if (!page || page.type !== 'CANVAS') throw new Error(`Page not found: ${pageId}`)
+  const current = page.childIds.filter((id) => isSlide(graph.getNode(id)))
+  const wanted = (ids as string[]).filter((id, i, all) => current.includes(id) && all.indexOf(id) === i)
+  const order = [...wanted, ...current.filter((id) => !wanted.includes(id))]
+  // The slots the slides occupy among all the page's children stay theirs.
+  const slots = page.childIds.flatMap((id, i) => (current.includes(id) ? [i] : []))
+
+  const before = store.snapshotPage()
+  await store.runMutationWithLayout(() => {
+    order.forEach((id, i) => {
+      graph.reorderChild(id, page.id, slots[i])
+    })
+    if (arrange && order.length) {
+      const nodes = order.map((id) => graph.getNode(id)!).filter(Boolean)
+      let x = Math.min(...nodes.map((n) => n.x))
+      const y = Math.min(...nodes.map((n) => n.y))
+      for (const n of nodes) {
+        graph.updateNode(n.id, { x: Math.round(x), y: Math.round(y) })
+        x += n.width + GAP
+      }
+    }
+  }, page.id)
+  const after = store.snapshotPage()
+  store.pushUndoEntry({
+    label: 'Reorder slides',
+    forward: () => store.restorePageFromSnapshot(after),
+    inverse: () => store.restorePageFromSnapshot(before)
+  })
+  store.requestRender()
+  return listSlides(store, page.id)
+}

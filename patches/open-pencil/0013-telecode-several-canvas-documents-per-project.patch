new file mode 100644
index 00000000..bfa73489
--- /dev/null
+++ b/tests/engine/app/telecode/storage.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, test } from 'bun:test'
+
+import {
+  parseTelecodeDocumentId,
+  telecodeDocumentId
+} from '@/app/integrations/telecode/storage'
+
+const PID = '0123456789abcdef0123456789abcdef'
+
+describe('telecode storage document ids', () => {
+  test('a bare project id is its default document', () => {
+    expect(parseTelecodeDocumentId(PID)).toEqual({ projectId: PID, docId: null })
+    expect(telecodeDocumentId(PID, null)).toBe(PID)
+  })
+
+  test('project/doc round-trips', () => {
+    const id = telecodeDocumentId(PID, 'wireframes-2')
+    expect(id).toBe(`${PID}/wireframes-2`)
+    expect(parseTelecodeDocumentId(id)).toEqual({ projectId: PID, docId: 'wireframes-2' })
+  })
+
+  test('anything else is refused', () => {
+    for (const bad of ['', 'x', `${PID}/`, `${PID}/UPPER`, `${PID}/a/b`, `${PID}/../x`, `../${PID}`]) {
+      expect(() => parseTelecodeDocumentId(bad)).toThrow()
+    }
+  })
+})

index 00000000..157e1f1f
--- /dev/null
+++ b/src/app/integrations/telecode/placeholders.ts
@@ -0,0 +1,115 @@
+/**
+ * "Working…" placeholders (telecode / TeleDesign).
+ *
+ * An agent marks a frame it is still building, the way pen.dev's `placeholder: true`
+ * does: the mark is shared plugin data (`telecode` / `placeholder` = JSON
+ * {label, at}) on the node, so it survives a reload, and the TeleDesign shell draws
+ * a hatched "working…" badge over the frame (td-editor:placeholders). The shell
+ * clears every mark when the agent's turn ends; a mark older than STALE_MS is
+ * treated as abandoned (a turn that crashed) and ignored.
+ */
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+import { makeFigmaFromStore } from '@/app/automation/bridge/figma-factory'
+import type { EditorStore } from '@/app/editor/session'
+
+export const PLACEHOLDER_NAMESPACE = 'telecode'
+export const PLACEHOLDER_FIELD = 'placeholder'
+const ENCODED = `${PLACEHOLDER_NAMESPACE}/${PLACEHOLDER_FIELD}`
+export const STALE_MS = 2 * 60 * 60 * 1000
+
+const listeners = new Set<() => void>()
+
+export function onPlaceholdersChanged(listener: () => void): () => void {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+function emit(): void {
+  for (const listener of listeners) listener()
+}
+
+export function placeholderOf(node: SceneNode): { label: string; at: number } | null {
+  const entry = node.pluginData.find(
+    (e) =>
+      e.pluginId === PLACEHOLDER_NAMESPACE && (e.key === ENCODED || e.key === PLACEHOLDER_FIELD)
+  )
+  if (!entry?.value) return null
+  try {
+    const parsed = JSON.parse(entry.value) as { label?: unknown; at?: unknown }
+    const at = typeof parsed.at === 'number' ? parsed.at : 0
+    return { label: typeof parsed.label === 'string' ? parsed.label : 'Working…', at }
+  } catch {
+    return { label: 'Working…', at: 0 }
+  }
+}
+
+function pageOf(store: EditorStore, node: SceneNode | undefined): string | null {
+  let current = node
+  while (current) {
+    if (current.type === 'CANVAS') return current.id
+    current = current.parentId ? store.graph.getNode(current.parentId) : undefined
+  }
+  return null
+}
+
+async function write(store: EditorStore, nodeId: string, value: string): Promise<void> {
+  const pageId = store.state.currentPageId
+  await store.runMutationWithLayout(() => {
+    makeFigmaFromStore(store, pageId)
+      .getNodeById(nodeId)
+      ?.setSharedPluginData(PLACEHOLDER_NAMESPACE, PLACEHOLDER_FIELD, value)
+  }, pageId)
+}
+
+export async function setPlaceholder(store: EditorStore, nodeId: string, label?: string) {
+  const node = store.graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  if (node.type === 'CANVAS') throw new Error('Mark a frame, not a page')
+  const text = (typeof label === 'string' && label.trim() ? label.trim() : 'Working…').slice(0, 80)
+  await write(store, nodeId, JSON.stringify({ label: text, at: Date.now() }))
+  store.requestRender()
+  emit()
+  return { node_id: nodeId, label: text }
+}
+
+export async function clearPlaceholders(store: EditorStore, nodeId?: string) {
+  const ids: string[] = []
+  if (nodeId) {
+    const node = store.graph.getNode(nodeId)
+    if (node && placeholderOf(node)) ids.push(node.id)
+  } else {
+    for (const node of store.graph.getAllNodes()) if (placeholderOf(node)) ids.push(node.id)
+  }
+  for (const id of ids) await write(store, id, '')
+  if (ids.length) {
+    store.requestRender()
+    emit()
+  }
+  return { cleared: ids.length, ids }
+}
+
+export function listPlaceholders(store: EditorStore, pageId?: string) {
+  const now = Date.now()
+  const out = []
+  for (const node of store.graph.getAllNodes()) {
+    const mark = placeholderOf(node)
+    if (!mark) continue
+    const page = pageOf(store, node)
+    if (pageId && page !== pageId) continue
+    const abs = store.graph.getAbsolutePosition(node.id)
+    out.push({
+      node_id: node.id,
+      name: node.name,
+      label: mark.label,
+      at: mark.at,
+      stale: !mark.at || now - mark.at > STALE_MS,
+      page_id: page,
+      x: abs.x,
+      y: abs.y,
+      width: node.width,
+      height: node.height
+    })
+  }
+  return out
+}

+/**
+ * Component slots (telecode / TeleDesign), scene-graph side.
+ *
+ * A slot is a frame inside a component marked with shared plugin data
+ * `telecode` / `slot` = its name. Each instance holds a clone of that frame; an
+ * instance "fills" the slot by listing the name in its own plugin data
+ * `telecode` / `slots` = {"filled": [names]} and putting its own children into
+ * the clone. Two rules follow, and this module is where they live:
+ *
+ *  - instance sync never re-clones the component's default content into a
+ *    filled slot (`isFilledSlotClone`, checked by `syncChildren`);
+ *  - the .fig writer exports a filled slot's children as real nodes under the
+ *    instance, flagged `isSlotContent` (the .fig schema's own field) and tagged
+ *    with the slot name, and the reader puts them back into the clone after the
+ *    instance is populated — see `slotContentRoots` / `attachSlotContent`.
+ */
+import type { SceneGraph, SceneNode } from './'
+
+export const SLOT_NAMESPACE = 'telecode'
+export const SLOT_FIELD = 'slot'
+export const SLOTS_FIELD = 'slots'
+export const IN_SLOT_FIELD = 'in-slot'
+
+function pluginValue(node: SceneNode | undefined, field: string): string | null {
+  if (!node) return null
+  const encoded = `${SLOT_NAMESPACE}/${field}`
+  const entry = node.pluginData.find(
+    (e) => e.pluginId === SLOT_NAMESPACE && (e.key === encoded || e.key === field)
+  )
+  return entry?.value ? entry.value : null
+}
+
+/** The slot name of a component's slot frame, or of an instance's clone of one. */
+export function slotNameOf(graph: SceneGraph, node: SceneNode | undefined): string | null {
+  if (!node) return null
+  const own = pluginValue(node, SLOT_FIELD)
+  if (own && node.type !== 'INSTANCE') return own
+  if (node.type === 'INSTANCE') return null
+  const main = node.componentId ? graph.getNode(node.componentId) : undefined
+  return main && main.type !== 'INSTANCE' ? pluginValue(main, SLOT_FIELD) : null
+}
+
+/** Nearest INSTANCE ancestor (the instance whose component the node's clone comes from). */
+export function owningInstance(graph: SceneGraph, node: SceneNode | undefined): SceneNode | undefined {
+  let current = node?.parentId ? graph.getNode(node.parentId) : undefined
+  while (current) {
+    if (current.type === 'INSTANCE') return current
+    if (current.type === 'CANVAS') return undefined
+    current = current.parentId ? graph.getNode(current.parentId) : undefined
+  }
+  return undefined
+}
+
+export function filledSlotsOf(instance: SceneNode | undefined): string[] {
+  const raw = pluginValue(instance, SLOTS_FIELD)
+  if (!raw) return []
+  try {
+    const parsed = JSON.parse(raw) as { filled?: unknown }
+    return Array.isArray(parsed.filled) ? parsed.filled.filter((x): x is string => typeof x === 'string') : []
+  } catch {
+    return []
+  }
+}
+
+/** A slot clone inside an instance whose content is the instance's own. */
+export function isFilledSlotClone(graph: SceneGraph, node: SceneNode | undefined): boolean {
+  if (!node || node.type === 'INSTANCE') return false
+  const name = slotNameOf(graph, node)
+  if (!name) return false
+  return filledSlotsOf(owningInstance(graph, node)).includes(name)
+}
+
+/** Slot clones of `instance` (not those of nested instances), by slot name. */
+export function slotClones(graph: SceneGraph, instance: SceneNode): Map<string, SceneNode> {
+  const out = new Map<string, SceneNode>()
+  const walk = (id: string) => {
+    const node = graph.getNode(id)
+    if (!node) return
+    for (const childId of node.childIds) {
+      const child = graph.getNode(childId)
+      if (!child || child.type === 'INSTANCE') continue
+      const name = slotNameOf(graph, child)
+      if (name && !out.has(name)) out.set(name, child)
+      walk(childId)
+    }
+  }
+  walk(instance.id)
+  return out
+}
+
+/** For the .fig writer: {root node, slot name} for every filled slot's content of `instance`. */
+export function slotContentRoots(graph: SceneGraph, instance: SceneNode): Array<{ node: SceneNode; slot: string }> {
+  const filled = new Set(filledSlotsOf(instance))
+  if (!filled.size) return []
+  const out: Array<{ node: SceneNode; slot: string }> = []
+  for (const [slot, clone] of slotClones(graph, instance)) {
+    if (!filled.has(slot)) continue
+    for (const childId of clone.childIds) {
+      const child = graph.getNode(childId)
+      if (child && !child.internalOnly) out.push({ node: child, slot })
+    }
+  }
+  return out
+}
+
+export function inSlotOf(node: { pluginData?: Array<{ pluginId: string; key: string; value: string }> }): string | null {
+  const encoded = `${SLOT_NAMESPACE}/${IN_SLOT_FIELD}`
+  const entry = node.pluginData?.find(
+    (e) => e.pluginId === SLOT_NAMESPACE && (e.key === encoded || e.key === IN_SLOT_FIELD)
+  )
+  return entry?.value || null
+}
+
+/**
+ * For the .fig reader: after `instance` is populated, give its filled slots their
+ * content: returns the (emptied) clone to attach the stored subtree to.
+ */
+export function prepareFilledSlot(graph: SceneGraph, instance: SceneNode, slot: string): SceneNode | null {
+  const clone = slotClones(graph, instance).get(slot)
+  if (!clone) return null
+  // Call once per slot, before its stored content is attached: everything the
+  // population cloned in is the component's default content.
+  for (const childId of [...clone.childIds]) graph.deleteNode(childId)
+  return clone
+}

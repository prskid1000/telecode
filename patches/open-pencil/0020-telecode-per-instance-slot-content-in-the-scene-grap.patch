+
+/**
+ * Put filled-slot content (telecode slots) back into the instances it belongs
+ * to: populate the instance if the lazy import skipped it, empty the slot clone
+ * of the component's default content once, build the stored subtree in it.
+ */
+function attachImportedSlotContent(
+  graph: SceneGraph,
+  pending: Array<{ ncId: string; instanceId: string }>,
+  changeMap: Map<string, NodeChange>,
+  guidToNodeId: Map<string, string>,
+  blobs: Uint8Array[],
+  createSceneNode: (ncId: string, parentId: string) => void
+): void {
+  const prepared = new Map<string, SceneNode | null>()
+  const created: string[] = []
+  for (const { ncId, instanceId } of pending) {
+    const instance = graph.getNode(instanceId)
+    const nc = changeMap.get(ncId) as NodeChange & { pluginData?: Array<{ pluginID: string; key: string; value: string }> }
+    if (!instance || !nc) continue
+    const slot = inSlotOf({
+      pluginData: (nc.pluginData ?? []).map((e) => ({ pluginId: e.pluginID, key: e.key, value: e.value }))
+    })
+    if (!slot) continue
+    if (instance.childIds.length === 0) {
+      graph.preserveSourceMetadataDuring(() => {
+        populateAndApplyOverrides(graph, changeMap as Map<string, InstanceNodeChange>, guidToNodeId, blobs, [instanceId])
+      })
+      linkImportedInstanceChildren(graph)
+    }
+    const key = `${instanceId}\u0000${slot}`
+    if (!prepared.has(key)) prepared.set(key, prepareFilledSlot(graph, instance, slot))
+    const clone = prepared.get(key)
+    if (!clone) continue
+    createSceneNode(ncId, clone.id)
+    const root = guidToNodeId.get(ncId)
+    const node = root ? graph.getNode(root) : undefined
+    if (!node) continue
+    // The slot name was only the file's link; the node is ordinary content now.
+    node.pluginData = node.pluginData.filter((e) => inSlotOf({ pluginData: [e] }) === null)
+    created.push(node.id)
+  }
+  // Content may hold instances of its own.
+  if (created.length) {
+    graph.preserveSourceMetadataDuring(() => {
+      populateAndApplyOverrides(graph, changeMap as Map<string, InstanceNodeChange>, guidToNodeId, blobs, created)
+    })
+  }
+}

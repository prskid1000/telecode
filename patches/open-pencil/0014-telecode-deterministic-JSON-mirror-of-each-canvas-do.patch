diff --git a/src/app/integrations/telecode/mirror.ts b/src/app/integrations/telecode/mirror.ts
new file mode 100644
index 00000000..23ed563b
--- /dev/null
+++ b/src/app/integrations/telecode/mirror.ts
@@ -0,0 +1,238 @@
+/**
+ * Git-friendly JSON mirror of a canvas document (telecode / TeleDesign).
+ *
+ * A .fig is a binary Kiwi + Zstd + ZIP container: useless in a diff. After every
+ * save the TeleDesign host writes this mirror next to it (docs/<doc>.fig.json) so a
+ * version compare, a code review or `git diff` can show what changed. It is a
+ * read-only mirror: nothing ever loads it back.
+ *
+ * Deterministic by construction:
+ *  - node ids are session-local (a .fig import renumbers them), so none is written;
+ *    a node is referred to by its name path (`Page 1/Card/Title`, `Card[2]` for the
+ *    second sibling with the same name), variables as `$Collection/name`, modes and
+ *    collections by name;
+ *  - a field equal to the default for its node type is left out, derived caches
+ *    (geometry blobs, text pictures, layout results) are never written;
+ *  - numbers are rounded to 1e-4 and object keys are sorted (the proxy
+ *    re-serialises the payload canonically as well).
+ */
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+import { createDefaultNode } from '@open-pencil/scene-graph/node-defaults'
+
+export const MIRROR_FORMAT = 'teledesign-canvas-mirror'
+export const MIRROR_VERSION = 1
+
+/** Structure, identity and derived caches: never part of a node's mirrored props. */
+const SKIPPED_FIELDS = new Set<string>([
+  'id',
+  'type',
+  'name',
+  'parentId',
+  'childIds',
+  'source',
+  'derivedLayout',
+  'fillGeometry',
+  'strokeGeometry',
+  'textPicture',
+  'derivedTextGlyphs',
+  'expanded'
+])
+
+type Json = null | boolean | number | string | Json[] | { [key: string]: Json }
+
+const defaultsCache = new Map<string, Record<string, Json>>()
+
+function round(value: number): number {
+  if (!Number.isFinite(value)) return 0
+  const r = Math.round(value * 10000) / 10000
+  return Object.is(r, -0) ? 0 : r
+}
+
+function bytesToBase64(bytes: Uint8Array): string {
+  let bin = ''
+  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i])
+  return btoa(bin)
+}
+
+function sortedObject(entries: Array<[string, Json]>): { [key: string]: Json } {
+  entries.sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+  return Object.fromEntries(entries)
+}
+
+interface Refs {
+  nodes: Map<string, string>
+  variables: Map<string, string>
+  collections: Map<string, string>
+  modes: Map<string, string>
+}
+
+function normalize(value: unknown, refs: Refs, depth = 0): Json {
+  if (depth > 64) return null
+  if (value === null || value === undefined) return null
+  if (typeof value === 'number') return round(value)
+  if (typeof value === 'boolean') return value
+  if (typeof value === 'string') {
+    return refs.nodes.get(value) ?? refs.variables.get(value) ?? value
+  }
+  if (value instanceof Uint8Array) return { base64: bytesToBase64(value) }
+  if (value instanceof Map) {
+    return normalize(Object.fromEntries(value), refs, depth + 1)
+  }
+  if (value instanceof Set) return normalize([...value], refs, depth + 1)
+  if (Array.isArray(value)) return value.map((item) => normalize(item, refs, depth + 1))
+  if (typeof value === 'object') {
+    const entries: Array<[string, Json]> = []
+    for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+      if (item === undefined || typeof item === 'function') continue
+      const mappedKey = refs.nodes.get(key) ?? refs.variables.get(key) ?? key
+      entries.push([mappedKey, normalize(item, refs, depth + 1)])
+    }
+    return sortedObject(entries)
+  }
+  return null
+}
+
+function defaultsFor(type: SceneNode['type']): Record<string, Json> {
+  let cached = defaultsCache.get(type)
+  if (!cached) {
+    const node = createDefaultNode(() => 'default', type) as unknown as Record<string, unknown>
+    const empty: Refs = { nodes: new Map(), variables: new Map(), collections: new Map(), modes: new Map() }
+    cached = {}
+    for (const [key, value] of Object.entries(node)) {
+      if (!SKIPPED_FIELDS.has(key)) cached[key] = normalize(value, empty)
+    }
+    defaultsCache.set(type, cached)
+  }
+  return cached
+}
+
+function same(a: Json, b: Json): boolean {
+  return JSON.stringify(a) === JSON.stringify(b)
+}
+
+/** Name paths for every node, unique among siblings (`Name`, `Name[2]`, …). */
+function nodePaths(graph: SceneGraph): Map<string, string> {
+  const out = new Map<string, string>()
+  const walk = (parentId: string, prefix: string) => {
+    const counts = new Map<string, number>()
+    for (const child of graph.getChildren(parentId)) {
+      const base = (child.name || child.type).replaceAll('/', '∕')
+      const n = (counts.get(base) ?? 0) + 1
+      counts.set(base, n)
+      const segment = n === 1 ? base : `${base}[${n}]`
+      const path = prefix ? `${prefix}/${segment}` : segment
+      out.set(child.id, `@${path}`)
+      walk(child.id, path)
+    }
+  }
+  walk(graph.rootId, '')
+  return out
+}
+
+function buildRefs(graph: SceneGraph): Refs {
+  const collections = new Map<string, string>()
+  const modes = new Map<string, string>()
+  for (const collection of graph.variableCollections.values()) {
+    collections.set(collection.id, collection.name)
+    for (const mode of collection.modes) modes.set(mode.modeId, mode.name)
+  }
+  const variables = new Map<string, string>()
+  for (const variable of graph.variables.values()) {
+    variables.set(variable.id, `$${collections.get(variable.collectionId) ?? '?'}/${variable.name}`)
+  }
+  return { nodes: nodePaths(graph), variables, collections, modes }
+}
+
+function nodeProps(node: SceneNode, refs: Refs): { [key: string]: Json } {
+  const defaults = defaultsFor(node.type)
+  const entries: Array<[string, Json]> = []
+  const record = node as unknown as Record<string, unknown>
+  for (const [key, value] of Object.entries(record)) {
+    if (SKIPPED_FIELDS.has(key)) continue
+    let normalized: Json
+    if (key === 'variableModes') {
+      // {collectionId: modeId} → {Collection: Mode}
+      normalized = sortedObject(
+        Object.entries((value ?? {}) as Record<string, string>).map(([collectionId, modeId]) => [
+          refs.collections.get(collectionId) ?? collectionId,
+          refs.modes.get(modeId) ?? modeId
+        ])
+      )
+    } else {
+      normalized = normalize(value, refs)
+    }
+    if (key in defaults && same(normalized, defaults[key])) continue
+    entries.push([key, normalized])
+  }
+  return sortedObject(entries)
+}
+
+function nodeTree(graph: SceneGraph, node: SceneNode, refs: Refs): { [key: string]: Json } {
+  const children = graph.getChildren(node.id).map((child) => nodeTree(graph, child, refs))
+  const out: Array<[string, Json]> = [
+    ['name', node.name],
+    ['type', node.type],
+    ['props', nodeProps(node, refs)]
+  ]
+  if (children.length) out.push(['children', children])
+  return sortedObject(out)
+}
+
+function variablesMirror(graph: SceneGraph, refs: Refs): { [key: string]: Json } {
+  const out: Array<[string, Json]> = []
+  for (const collection of graph.variableCollections.values()) {
+    const variables: Array<[string, Json]> = []
+    for (const id of collection.variableIds) {
+      const variable = graph.variables.get(id)
+      if (!variable) continue
+      const values = sortedObject(
+        Object.entries(variable.valuesByMode).map(([modeId, value]) => [
+          refs.modes.get(modeId) ?? modeId,
+          value && typeof value === 'object' && 'aliasId' in value
+            ? { alias: refs.variables.get(value.aliasId) ?? value.aliasId }
+            : normalize(value, refs)
+        ])
+      )
+      const entry: Array<[string, Json]> = [
+        ['type', variable.type],
+        ['values', values]
+      ]
+      if (variable.description) entry.push(['description', variable.description])
+      variables.push([variable.name, sortedObject(entry)])
+    }
+    out.push([
+      collection.name,
+      sortedObject([
+        ['default_mode', refs.modes.get(collection.defaultModeId) ?? collection.defaultModeId],
+        ['modes', collection.modes.map((m) => m.name)],
+        ['variables', sortedObject(variables)]
+      ])
+    ])
+  }
+  return sortedObject(out)
+}
+
+/** The whole document as a deterministic, id-free JSON value. */
+export function documentMirror(graph: SceneGraph, meta: { doc?: string | null } = {}) {
+  const refs = buildRefs(graph)
+  const pages = graph.getPages().map((page) =>
+    sortedObject([
+      ['name', page.name],
+      ['nodes', graph.getChildren(page.id).map((child) => nodeTree(graph, child, refs))]
+    ])
+  )
+  return sortedObject([
+    ['format', MIRROR_FORMAT],
+    ['version', MIRROR_VERSION],
+    ['doc', meta.doc ?? null],
+    ['note', 'Read-only JSON mirror of the .fig beside it, for diffs. Never loaded; edit the canvas instead.'],
+    ['variables', variablesMirror(graph, refs)],
+    ['images', [...graph.images.keys()].sort()],
+    ['pages', pages]
+  ])
+}
+
+/** documentMirror as canonical text (sorted keys, 1-space indent, trailing newline). */
+export function documentMirrorText(graph: SceneGraph, meta: { doc?: string | null } = {}): string {
+  return `${JSON.stringify(documentMirror(graph, meta), null, 1)}\n`
+}
diff --git a/tests/engine/app/telecode/mirror.test.ts b/tests/engine/app/telecode/mirror.test.ts
new file mode 100644
index 00000000..eab8c96c
--- /dev/null
+++ b/tests/engine/app/telecode/mirror.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/core'
+
+import { documentMirror, documentMirrorText } from '@/app/integrations/telecode/mirror'
+
+function build(graph: SceneGraph) {
+  const page = graph.getPages()[0].id
+  graph.addCollection({
+    id: 'c1',
+    name: 'Theme',
+    modes: [
+      { modeId: 'm1', name: 'Light' },
+      { modeId: 'm2', name: 'Dark' }
+    ],
+    defaultModeId: 'm1',
+    variableIds: []
+  })
+  graph.addVariable({
+    id: 'v1',
+    name: 'bg',
+    type: 'COLOR',
+    collectionId: 'c1',
+    valuesByMode: { m1: { r: 1, g: 1, b: 1, a: 1 }, m2: { r: 0.1, g: 0.1, b: 0.1, a: 1 } },
+    description: '',
+    hiddenFromPublishing: false
+  })
+  const card = graph.createNode('FRAME', page, {
+    name: 'Card',
+    x: 10.123456,
+    y: 20,
+    width: 300,
+    height: 200,
+    variableModes: { c1: 'm2' },
+    boundVariables: { 'fills/0/color': 'v1' }
+  })
+  graph.createNode('TEXT', card.id, { name: 'Title', text: 'Hello' })
+  graph.createNode('TEXT', card.id, { name: 'Title', text: 'Again' })
+  return card
+}
+
+describe('telecode document mirror', () => {
+  test('is id-free and names nodes, variables and modes', () => {
+    const graph = new SceneGraph()
+    build(graph)
+    const mirror = documentMirror(graph, { doc: 'main' }) as Record<string, any>
+    const text = JSON.stringify(mirror)
+    for (const node of graph.getAllNodes()) expect(text).not.toContain(`"${node.id}"`)
+    const card = mirror.pages[0].nodes[0]
+    expect(card.name).toBe('Card')
+    expect(card.props.x).toBe(10.1235)
+    expect(card.props.variableModes).toEqual({ Theme: 'Dark' })
+    expect(card.props.boundVariables).toEqual({ 'fills/0/color': '$Theme/bg' })
+    // Defaults are left out; the two same-named siblings are both there.
+    expect(card.props.rotation).toBeUndefined()
+    expect(card.children.map((c: any) => c.props.text)).toEqual(['Hello', 'Again'])
+    expect(mirror.variables.Theme.modes).toEqual(['Light', 'Dark'])
+    expect(mirror.variables.Theme.variables.bg.values.Dark).toEqual({ a: 1, b: 0.1, g: 0.1, r: 0.1 })
+  })
+
+  test('is byte-identical for the same content with different node ids', () => {
+    const a = new SceneGraph()
+    build(a)
+    const b = new SceneGraph()
+    // Burn some ids so every node in b gets a different one.
+    for (let i = 0; i < 7; i++) b.createNode('RECTANGLE', b.getPages()[0].id, {})
+    for (const child of [...b.getChildren(b.getPages()[0].id)]) b.deleteNode(child.id)
+    build(b)
+    expect(documentMirrorText(b)).toBe(documentMirrorText(a))
+  })
+
+  test('keys are sorted at every level', () => {
+    const graph = new SceneGraph()
+    build(graph)
+    const check = (value: unknown) => {
+      if (Array.isArray(value)) return value.forEach(check)
+      if (value && typeof value === 'object') {
+        const keys = Object.keys(value)
+        expect(keys).toEqual([...keys].sort())
+        Object.values(value).forEach(check)
+      }
+    }
+    check(documentMirror(graph))
+  })
+})

+  // Git-friendly JSON mirror of the document, written next to its .fig after each save.
+  let mirrorTimer = 0
+  let lastMirror = ''
+  function queueMirror(): void {
+    window.clearTimeout(mirrorTimer)
+    mirrorTimer = window.setTimeout(() => void uploadMirror(), 400)
+  }
+
+  async function uploadMirror(): Promise<void> {
+    if (!store || !openDocId) return
+    let text: string
+    try {
+      text = documentMirrorText(store.graph, { doc: openDocId })
+    } catch (error) {
+      console.warn('[TeleDesign] JSON mirror not built:', error)
+      return
+    }
+    if (text === lastMirror) return
+    try {
+      const res = await fetch(
+        `${config.apiOrigin}/api/design/projects/${config.projectId}/docs/${openDocId}/canvas.json`,
+        { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: text }
+      )
+      if (res.ok) lastMirror = text
+      else console.warn('[TeleDesign] JSON mirror not saved: HTTP', res.status)
+    } catch (error) {
+      console.warn('[TeleDesign] JSON mirror not saved:', error)
+    }
+  }

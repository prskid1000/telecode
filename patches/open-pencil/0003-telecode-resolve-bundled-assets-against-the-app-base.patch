-    const base = 'env' in import.meta ? import.meta.env.BASE_URL : '/'
-    const prefix = base === '/' ? '' : base.replace(/\/$/, '')
-    return `${prefix}/${file}`
+    return bundledAssetURL(file)
   }
 

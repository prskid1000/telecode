@@ -17,9 +18,7 @@ export async function getCanvasKit(options?: CanvasKitOptions): Promise<CanvasKi
       const ckPath = import.meta.resolve('canvaskit-wasm')
       return decodeURIComponent(new URL(file, ckPath).pathname)

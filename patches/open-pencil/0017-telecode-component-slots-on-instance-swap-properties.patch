+/** Editor-side wrappers for component slots (see slots.ts): one undo step each. */
+import { renderJSX } from '@open-pencil/core/design-jsx'
+import type { FigmaAPI } from '@open-pencil/core/figma-api'
+
+import { makeFigmaFromStore } from '@/app/automation/bridge/figma-factory'
+import { ensureGraphFonts } from '@/app/editor/fonts'
+import type { EditorStore } from '@/app/editor/session'
+
+import { fillSlot, type SlotContent } from './slots'
+
+export async function slotMutation<T>(
+  store: EditorStore,
+  label: string,
+  operation: (figma: FigmaAPI) => T | Promise<T>
+): Promise<T> {
+  const pageId = store.state.currentPageId
+  const before = store.snapshotPage()
+  const result = await store.runMutationWithLayout(
+    () => operation(makeFigmaFromStore(store, pageId)),
+    pageId
+  )
+  const after = store.snapshotPage()
+  store.pushUndoEntry({
+    label,
+    forward: () => store.restorePageFromSnapshot(after),
+    inverse: () => store.restorePageFromSnapshot(before)
+  })
+  store.requestRender()
+  return result
+}
+
+export async function fillSlotInEditor(
+  store: EditorStore,
+  instanceId: string,
+  slot: string,
+  content: SlotContent
+) {
+  const result = await slotMutation(store, 'Fill slot', (figma) =>
+    fillSlot(store.graph, figma, instanceId, slot, content, renderJSX)
+  )
+  const filled =
+    result.kind === 'instance' ? result.slots.find((s) => s.name === slot)?.content_component_id : null
+  if (filled) await ensureGraphFonts(store.graph, [filled], store.renderer)
+  return result
+}

+import { beforeAll, describe, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec } from '@open-pencil/core'
+import { renderJSX } from '@open-pencil/core/design-jsx'
+import { parseFigBuffer } from '@open-pencil/fig'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { importNodeChanges } from '#core/kiwi/fig/import'
+
+import {
+  createSlot,
+  describeSlots,
+  fillSlot,
+  listAllSlots,
+  resetSlot
+} from '@/app/integrations/telecode/slots'
+
+beforeAll(async () => {
+  await initCodec()
+})
+
+function card() {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const figma = new FigmaAPI(graph)
+  const comp = graph.createNode('COMPONENT', page.id, { name: 'Card', width: 240, height: 200 })
+  graph.createNode('TEXT', comp.id, { name: 'Title', width: 200, height: 20 })
+  const body = graph.createNode('FRAME', comp.id, { name: 'Body', x: 20, y: 40, width: 200, height: 120 })
+  graph.createNode('RECTANGLE', body.id, { name: 'Placeholder', width: 50, height: 50 })
+  const a = graph.createInstance(comp.id, page.id, { x: 400 })!
+  return { graph, figma, page, comp, body, a }
+}
+
+const tree = (g: SceneGraph, id: string, d = 0): string[] => {
+  const n = g.getNode(id)!
+  return [`${'  '.repeat(d)}${n.type} ${n.name}`, ...n.childIds.flatMap((c) => tree(g, c, d + 1))]
+}
+
+describe('component slots', () => {
+  test('create: the frame becomes an exposed instance of a default-content component', () => {
+    const { graph, figma, comp, body, a } = card()
+    const info = createSlot(graph, figma, body.id)
+    expect(info.kind).toBe('component')
+    expect(info.slots).toHaveLength(1)
+    const slot = info.slots[0]
+    expect(slot.name).toBe('Body')
+    expect(slot.default_component).toBe('Card / Body / Default')
+    const node = graph.getNode(slot.node_id)!
+    expect(node.type).toBe('INSTANCE')
+    expect([node.x, node.y, node.width, node.height]).toEqual([20, 40, 200, 120])
+    expect(graph.getNode(comp.id)!.childIds.indexOf(node.id)).toBe(1)
+    expect(graph.getNode(body.id)).toBeUndefined()
+    // Existing instances follow, still showing the default content.
+    expect(tree(graph, a.id).join('\n')).toContain('RECTANGLE Placeholder')
+    expect(tree(graph, a.id).join('\n')).not.toContain('FRAME Body')
+    expect(describeSlots(graph, a.id).slots[0]).toMatchObject({ name: 'Body', filled: false })
+    expect(() => createSlot(graph, figma, comp.childIds[0], 'Body')).toThrow(/already has a property/)
+    // The frame's children keep their place inside the slot (not their absolute position).
+    const defaults = graph.getNode(slot.default_component_id!)!
+    const placeholder = graph.getNode(defaults.childIds[0])!
+    expect([placeholder.name, placeholder.x, placeholder.y]).toEqual(['Placeholder', 0, 0])
+    // A layer outside any component has no slots: an empty answer, not an error.
+    const loose = graph.createNode('RECTANGLE', graph.getPages()[0].id, { name: 'Loose' })
+    expect(describeSlots(graph, loose.id)).toMatchObject({ kind: 'none', slots: [] })
+  })
+
+  test('fill with layers / JSX / a component, reset, and orphan cleanup', async () => {
+    const { graph, figma, page, body, a } = card()
+    createSlot(graph, figma, body.id)
+    const b = graph.createInstance(graph.getNode(a.id)!.componentId!, page.id, { x: 800 })!
+    const loose = graph.createNode('ELLIPSE', page.id, { name: 'Avatar', x: 0, y: 600, width: 30, height: 30 })
+
+    let state = await fillSlot(graph, figma, a.id, 'Body', { nodeIds: [loose.id] })
+    expect(state.slots[0]).toMatchObject({ filled: true, content_component: 'Card / Body' })
+    const firstContent = state.slots[0].content_component_id!
+    expect(tree(graph, a.id).join('\n')).toContain('ELLIPSE Avatar')
+    expect([graph.getNode(loose.id)!.x, graph.getNode(loose.id)!.y]).toEqual([0, 0])
+    expect(tree(graph, a.id).join('\n')).not.toContain('Placeholder')
+    expect(tree(graph, b.id).join('\n')).toContain('Placeholder')
+
+    state = await fillSlot(graph, figma, a.id, 'Body', { jsx: '<Rectangle name="Hero" w={80} h={40} bg="#f00" />' }, renderJSX)
+    expect(tree(graph, a.id).join('\n')).toContain('RECTANGLE Hero')
+    // The first content component was ours and is unused now: gone.
+    expect(graph.getNode(firstContent)).toBeUndefined()
+
+    const shared = state.slots[0].content_component_id!
+    await fillSlot(graph, figma, b.id, 'Body', { componentId: shared })
+    expect(tree(graph, b.id).join('\n')).toContain('RECTANGLE Hero')
+
+    state = resetSlot(graph, figma, a.id, 'Body')
+    expect(state.slots[0].filled).toBe(false)
+    expect(graph.getNode(shared)).toBeDefined() // b still shows it
+    resetSlot(graph, figma, b.id)
+    expect(graph.getNode(shared)).toBeUndefined()
+
+    await expect(fillSlot(graph, figma, a.id, 'Nope', { componentId: shared })).rejects.toThrow(/no slot "Nope"/)
+    const all = listAllSlots(graph)
+    expect(all.components.map((c) => c.name)).toEqual(['Card'])
+    // The library section holds only the default content now.
+    const library = [...graph.getAllNodes()].find((n) => n.type === 'SECTION')!
+    expect(library.name).toBe('Slot content')
+    expect(library.childIds.map((id) => graph.getNode(id)!.name)).toEqual(['Card / Body / Default'])
+  })
+
+  test('slot content survives a .fig round trip', async () => {
+    const { graph, figma, page, body, a } = card()
+    createSlot(graph, figma, body.id)
+    const loose = graph.createNode('ELLIPSE', page.id, { name: 'Avatar', width: 30, height: 30 })
+    await fillSlot(graph, figma, a.id, 'Body', { nodeIds: [loose.id] })
+    const bytes = await exportFigFile(graph)
+    const parsed = parseFigBuffer(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength))
+    const g2 = importNodeChanges(parsed.nodeChanges, parsed.blobs, undefined, { populate: 'all' })
+    const i2 = [...g2.getAllNodes()].find((n) => n.type === 'INSTANCE' && n.name === 'Card')!
+    expect(tree(g2, i2.id).join('\n')).toContain('ELLIPSE Avatar')
+    const s = describeSlots(g2, i2.id).slots
+    expect(s).toHaveLength(1)
+    expect(s[0]).toMatchObject({ name: 'Body', filled: true, content_component: 'Card / Body' })
+  })
+})

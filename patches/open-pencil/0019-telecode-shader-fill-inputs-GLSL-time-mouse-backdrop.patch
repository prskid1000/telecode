+    const def = { kind: 'shader', sksl: `uniform shader backdrop; // @backdrop
+half4 main(float2 p) { half4 b = backdrop.eval(p); return half4(b.g, b.r, 1.0 - b.a, 1.0); }` }
+    const glass = graph.createNode('RECTANGLE', page.id, { name: 'Glass', x: 0, y: 0, width: 100, height: 100, fills: [linked('2:2')], pluginData: [defData('2:2', def)] })
+    const px = draw([red.id, glass.id])

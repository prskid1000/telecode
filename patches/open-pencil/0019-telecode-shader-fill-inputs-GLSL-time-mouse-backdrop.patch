+
+/** GLSL for WebGL from a GLSL source the user wrote (declarations Shadertoy leaves implicit added). */
+export function glslForWebGL(source: string): string {
+  const lines = preprocess(source)
+  let body = lines.map((l) => l.replace(/^\s*precision\s+\w+\s+\w+\s*;/, '')).join('\n')
+  const declared = parseUniforms(body)
+  const has = (name: string) => declared.some((u) => u.name === name)
+  const uses = (name: string) => new RegExp(`\\b${name}\\b`).test(body)
+  const head = ['precision highp float;']
+  if (!has('iResolution') && uses('iResolution')) head.push('uniform vec3 iResolution;')
+  if (!has('iTime') && uses('iTime')) head.push('uniform float iTime;')
+  if (!has('iTimeDelta') && uses('iTimeDelta')) head.push('uniform float iTimeDelta;')
+  if (!has('iMouse') && uses('iMouse')) head.push('uniform vec4 iMouse;')
+  if (!has('iFrame') && uses('iFrame')) head.push('uniform float iFrame;')
+  if (!has('iChannel0') && uses('iChannel0')) head.push('uniform sampler2D iChannel0;')
+  body = body.replace(/\btexture\s*\(/g, 'texture2D(')
+  if (needsSdf(body)) {
+    head.push('uniform sampler2D _td_sdf;', 'uniform float _td_sdf_range;', 'uniform vec2 _td_size;')
+    // Textures are uploaded flipped (UNPACK_FLIP_Y), so GL coordinates sample directly.
+    head.push('float sdf(vec2 p) { return (texture2D(_td_sdf, p / _td_size).r - 0.5) * 2.0 * _td_sdf_range; }')
+  }
+  const tail = /\bvoid\s+mainImage\s*\(/.test(body)
+    ? ['void main() { vec4 c = vec4(0.0); mainImage(c, gl_FragCoord.xy); gl_FragColor = vec4(c.rgb * c.a, c.a); }']
+    : []
+  return [...head, body, ...tail].join('\n')
+}

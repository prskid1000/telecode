+
+  test('clear errors for what cannot be translated, with the author’s line numbers', async () => {
+    expect(() => translateGLSL('void mainImage(out vec4 c, in vec2 p) {\n  if (p.x > 1.0) discard;\n}')).toThrow(/line 2: `discard`/)
+    expect(() => translateGLSL('void mainImage(out vec4 c, in vec2 p) { c = vec4(dFdx(p.x)); }')).toThrow(/derivatives/)
+    expect(() => translateGLSL('#if 1\n#endif\nvoid main(){}')).toThrow(/line 1: #if is not supported/)
+    expect(() => translateGLSL('void helper() { vec4 x = gl_FragCoord; }\nvoid main() { gl_FragColor = vec4(1.0); }')).toThrow(/only supported inside main/)
+    expect(() => translateGLSL('vec4 f() { return vec4(1.0); }')).toThrow(/mainImage/)
+    const ck = await initCanvasKit()
+    const bad = normalizeProceduralFill({ kind: 'shader', glsl: 'void mainImage(out vec4 c, in vec2 p) {\n  c = vec4(nope);\n}' })
+    if (bad.kind !== 'shader') throw new Error('shader expected')
+    const r = compileShaderDef(ck, bad)
+    expect(r.error).toMatch(/line 2:.*nope/)
+    const refused = prepareShader(normalizeProceduralFill({ kind: 'shader', glsl: 'void mainImage(out vec4 c, in vec2 p) { discard; }' }) as never)
+    expect(refused.error).toMatch(/^GLSL not translated: line 1: `discard`/)
+  })
+})

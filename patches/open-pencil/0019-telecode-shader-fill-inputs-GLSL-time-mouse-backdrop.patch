+const SKSL_TYPES: Array<[RegExp, string]> = [
+  [/\bhalf([234])x\1\b|\bfloat([234])x\2\b/g, 'mat$1$2'],
+  [/\b(?:half|float)([234])\b/g, 'vec$1'],

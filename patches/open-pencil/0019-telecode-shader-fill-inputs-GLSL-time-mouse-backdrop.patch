+    const node = graph.createNode('RECTANGLE', page.id, { x: 0, y: 0, width: 100, height: 100, fills: [linked('2:1')], pluginData: [defData('2:1', def)] })
+    setProceduralTime(0.25)
+    setProceduralMouse({ x: 30, y: 70 })
+    let px = draw([node.id])
+    expect(px(5, 5)[0]).toBeGreaterThan(55)
+    expect(px(5, 5)[0]).toBeLessThan(75)

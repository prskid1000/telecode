@@ -0,0 +1,483 @@
+/**
+ * Shader sources for procedural fills: GLSL → SkSL (what the renderer runs) and
+ * SkSL → GLSL ES 1.0 (what an exported HTML page runs in WebGL), plus the
+ * uniform annotations both share.
+ *
+ * GLSL accepted: a Shadertoy-style `void mainImage(out vec4 fragColor, in vec2
+ * fragCoord)` or a plain `void main()` writing `gl_FragColor` (reading
+ * `gl_FragCoord`), `uniform` float / vecN declarations, the Shadertoy inputs
+ * `iResolution iTime iTimeDelta iMouse iChannel0`, `texture` / `texture2D` on a
+ * sampler uniform, object- and function-like `#define`, and `#ifdef GL_ES`
+ * blocks. SkSL itself understands GLSL's type names, `out` parameters and
+ * global variables, so the translation is about the entry point, the inputs and
+ * the preprocessor. Anything it cannot map (`discard`, derivatives, `#if`,
+ * `gl_FragData`, samplers other than the backdrop, `gl_FragCoord` outside
+ * `main`) is refused with the line it is on.
+ *
+ * Uniform annotations — a comment after the declaration, pen.dev style:
+ *   uniform vec4 base;    // @color @label Base colour @default #ff5500
+ *   uniform float speed;  // @min 0 @max 4 @step 0.1 @default 1
+ *   uniform float t;      // @time        (seconds since the page started)
+ *   uniform vec2 m;       // @mouse       (pointer in the node's pixels)
+ *   uniform vec2 size;    // @resolution  (the node's size in pixels)
+ *   uniform sampler2D bg; // @backdrop    (what is painted behind the layer)
+ * Conventional names bind without annotations: u_size / iResolution, u_time /
+ * iTime, u_mouse / iMouse, backdrop / iChannel0. `sdf(p)` — the signed distance
+ * in pixels from `p` to the layer's own outline, negative inside — is provided
+ * when a shader calls it without defining it (`@sdf`).
+ */
+
+export type ShaderLang = 'sksl' | 'glsl'
+
+export type UniformRole = 'resolution' | 'time' | 'mouse' | 'backdrop' | 'sdf' | 'value'
+
+export interface UniformSpec {
+  name: string
+  /** Declared type as written (float, vec2, float4, half3, sampler2D, shader…). */
+  type: string
+  /** Float components (0 for samplers / child shaders). */
+  floats: number
+  role: UniformRole
+  color: boolean
+  label?: string
+  min?: number
+  max?: number
+  step?: number
+  default?: number[]
+}
+
+export class ShaderTranslateError extends Error {
+  readonly line: number
+  constructor(message: string, line: number) {
+    super(line > 0 ? `line ${line}: ${message}` : message)
+    this.name = 'ShaderTranslateError'
+    this.line = line
+  }
+}
+
+const FLOATS: Record<string, number> = {
+  float: 1, half: 1, int: 1,
+  vec2: 2, float2: 2, half2: 2, ivec2: 2, int2: 2,
+  vec3: 3, float3: 3, half3: 3, ivec3: 3, int3: 3,
+  vec4: 4, float4: 4, half4: 4, ivec4: 4, int4: 4,
+  mat2: 4, float2x2: 4, half2x2: 4,
+  mat3: 9, float3x3: 9, half3x3: 9,
+  mat4: 16, float4x4: 16, half4x4: 16
+}
+
+const CONVENTIONAL: Record<string, UniformRole> = {
+  u_size: 'resolution', iResolution: 'resolution', u_resolution: 'resolution',
+  u_time: 'time', iTime: 'time',
+  u_mouse: 'mouse', iMouse: 'mouse',
+  backdrop: 'backdrop', iChannel0: 'backdrop', u_backdrop: 'backdrop'
+}
+
+function parseNumbers(text: string): number[] | undefined {
+  const t = text.trim()
+  const hex = t.match(/^#([0-9a-f]{3,8})$/i)
+  if (hex) {
+    const h = hex[1].length <= 4 ? [...hex[1]].map((c) => c + c).join('') : hex[1]
+    const n = (i: number) => Number.parseInt(h.slice(i, i + 2), 16) / 255
+    return [n(0), n(2), n(4), h.length >= 8 ? n(6) : 1]
+  }
+  const nums = t.split(/[\s,]+/).map(Number).filter((x) => Number.isFinite(x))
+  return nums.length ? nums : undefined
+}
+
+/** Uniform declarations (with annotations) in a GLSL or SkSL source. */
+export function parseUniforms(source: string): UniformSpec[] {
+  const out: UniformSpec[] = []
+  // Several declarations may share a line; a trailing // comment annotates the last one.
+  const re = /\buniform\s+(?:(?:lowp|mediump|highp)\s+)?(\w+)\s+(\w+)\s*(?:\[[^\]]*\])?\s*;(?:[ \t]*\/\/([^\n]*))?/g
+  let m: RegExpExecArray | null
+  while ((m = re.exec(source))) {
+    const [, type, name, comment = ''] = m
+    const isChild = type === 'shader' || type === 'sampler2D'
+    const tags = new Map<string, string>()
+    for (const t of comment.matchAll(/@(\w+)([^@]*)/g)) tags.set(t[1].toLowerCase(), t[2].trim())
+    let role: UniformRole = CONVENTIONAL[name] ?? 'value'
+    if (tags.has('time')) role = 'time'
+    else if (tags.has('mouse')) role = 'mouse'
+    else if (tags.has('resolution')) role = 'resolution'
+    else if (tags.has('backdrop')) role = 'backdrop'
+    else if (tags.has('sdf')) role = 'sdf'
+    if (isChild && role === 'value') role = 'value'
+    const floats = isChild ? 0 : (FLOATS[type] ?? 1)
+    const range = tags.get('range') ? parseNumbers(tags.get('range') ?? '') : undefined
+    const spec: UniformSpec = {
+      name,
+      type,
+      floats,
+      role,
+      color: tags.has('color') || (!isChild && (floats === 3 || floats === 4) && /colou?r|^col\b|tint/i.test(name))
+    }
+    if (tags.get('label')) spec.label = tags.get('label')
+    const min = tags.get('min') ?? (range ? String(range[0]) : undefined)
+    const max = tags.get('max') ?? (range ? String(range[1]) : undefined)
+    if (min !== undefined && Number.isFinite(Number(min))) spec.min = Number(min)
+    if (max !== undefined && Number.isFinite(Number(max))) spec.max = Number(max)
+    if (tags.get('step') && Number.isFinite(Number(tags.get('step')))) spec.step = Number(tags.get('step'))
+    if (tags.get('default')) spec.default = parseNumbers(tags.get('default') ?? '')
+    out.push(spec)
+  }
+  return out
+}
+
+export function detectLang(source: string): ShaderLang {
+  if (/\bmainImage\s*\(/.test(source) || /\bgl_Frag(Color|Coord)\b/.test(source) || /\bvoid\s+main\s*\(\s*(void)?\s*\)/.test(source) || /\bsampler2D\b/.test(source) || /^\s*#\s*(version|define|ifdef)\b/m.test(source)) {
+    return 'glsl'
+  }
+  return 'sksl'
+}
+
+// ── Preprocessor ─────────────────────────────────────────────────────────
+
+interface Macro {
+  params: string[] | null
+  body: string
+}
+
+function expandMacros(line: string, macros: Map<string, Macro>, lineNo: number, depth = 0): string {
+  if (!macros.size || depth > 16) return line
+  let changed = false
+  let out = ''
+  let i = 0
+  while (i < line.length) {
+    const m = /[A-Za-z_]\w*/y
+    m.lastIndex = i
+    const word = m.exec(line)
+    if (!word || word.index !== i || (i > 0 && /\w/.test(line[i - 1]))) {
+      out += line[i]
+      i++
+      continue
+    }
+    const name = word[0]
+    const macro = macros.get(name)
+    i += name.length
+    if (!macro) {
+      out += name
+      continue
+    }
+    if (macro.params === null) {
+      out += `(${macro.body})`
+      changed = true
+      continue
+    }
+    let j = i
+    while (line[j] === ' ' || line[j] === '\t') j++
+    if (line[j] !== '(') {
+      out += name
+      continue
+    }
+    // Collect arguments up to the matching parenthesis.
+    let level = 0
+    const args: string[] = []
+    let cur = ''
+    let k = j
+    for (; k < line.length; k++) {
+      const c = line[k]
+      if (c === '(') {
+        if (level++ > 0) cur += c
+      } else if (c === ')') {
+        if (--level === 0) break
+        cur += c
+      } else if (c === ',' && level === 1) {
+        args.push(cur)
+        cur = ''
+      } else cur += c
+    }
+    if (level !== 0) throw new ShaderTranslateError(`unbalanced parentheses in a call to macro ${name}`, lineNo)
+    if (cur.trim() || args.length) args.push(cur)
+    if (args.length !== macro.params.length) {
+      throw new ShaderTranslateError(`macro ${name} takes ${macro.params.length} argument(s), got ${args.length}`, lineNo)
+    }
+    let body = macro.body
+    macro.params.forEach((p, idx) => {
+      body = body.replace(new RegExp(`\\b${p}\\b`, 'g'), `(${args[idx].trim()})`)
+    })
+    out += `(${body})`
+    i = k + 1
+    changed = true
+  }
+  return changed ? expandMacros(out, macros, lineNo, depth + 1) : out
+}
+
+/** Run the preprocessor; returns one output line per input line (line numbers stay). */
+function preprocess(source: string): string[] {
+  const lines = source.replace(/\r\n?/g, '\n').split('\n')
+  const macros = new Map<string, Macro>()
+  const out: string[] = []
+  const skip: boolean[] = []
+  for (let n = 0; n < lines.length; n++) {
+    let line = lines[n]
+    const lineNo = n + 1
+    // Join continuation lines of a directive.
+    while (/^\s*#/.test(line) && line.endsWith('\\') && n + 1 < lines.length) {
+      line = line.slice(0, -1) + ' ' + lines[++n]
+      out.push('')
+    }
+    const d = line.match(/^\s*#\s*(\w+)\s*(.*)$/)
+    const skipping = skip.includes(true)
+    if (d) {
+      const [, dir, rest] = d
+      if (dir === 'ifdef' || dir === 'ifndef') {
+        const defined = rest.trim() === 'GL_ES' ? false : macros.has(rest.trim())
+        skip.push(dir === 'ifdef' ? !defined : defined)
+      } else if (dir === 'else') {
+        if (!skip.length) throw new ShaderTranslateError('#else without #ifdef', lineNo)
+        skip[skip.length - 1] = !skip[skip.length - 1]
+      } else if (dir === 'endif') {
+        if (!skip.length) throw new ShaderTranslateError('#endif without #ifdef', lineNo)
+        skip.pop()
+      } else if (skipping) {
+        // inside a skipped block
+      } else if (dir === 'define') {
+        const fm = rest.match(/^([A-Za-z_]\w*)\(([^)]*)\)\s*(.*)$/)
+        const om = rest.match(/^([A-Za-z_]\w*)\s*(.*)$/)
+        if (fm) macros.set(fm[1], { params: fm[2].split(',').map((p) => p.trim()).filter(Boolean), body: fm[3] })
+        else if (om) macros.set(om[1], { params: null, body: om[2] })
+        else throw new ShaderTranslateError(`cannot read #define ${rest}`, lineNo)
+      } else if (dir === 'undef') {
+        macros.delete(rest.trim())
+      } else if (dir === 'version' || dir === 'extension' || dir === 'pragma' || dir === 'line') {
+        // dropped
+      } else {
+        throw new ShaderTranslateError(`#${dir} is not supported (only #define, #undef, #ifdef/#ifndef/#else/#endif)`, lineNo)
+      }
+      out.push('')
+      continue
+    }
+    if (skipping) {
+      out.push('')
+      continue
+    }
+    out.push(expandMacros(line, macros, lineNo))
+  }
+  if (skip.length) throw new ShaderTranslateError('#ifdef without #endif', lines.length)
+  return out
+}
+
+function stripComments(line: string): string {
+  return line.replace(/\/\/.*$/, '')
+}
+
+// ── GLSL → SkSL ──────────────────────────────────────────────────────────
+
+export interface TranslatedShader {
+  /** The SkSL the renderer compiles. */
+  sksl: string
+  /** Lines of prelude before the user's first line (to map compiler errors back). */
+  lineOffset: number
+  uniforms: UniformSpec[]
+  usesTime: boolean
+  usesMouse: boolean
+  usesBackdrop: boolean
+  usesSdf: boolean
+  warnings: string[]
+}
+
+const UNSUPPORTED: Array<[RegExp, string]> = [
+  [/\bdiscard\b/, '`discard` has no SkSL equivalent — return a transparent colour instead'],
+  [/\b(dFdx|dFdy|fwidth)\s*\(/, 'derivatives (dFdx/dFdy/fwidth) are not available in SkSL runtime effects'],
+  [/\bgl_FragData\b/, 'gl_FragData (multiple render targets) is not supported'],
+  [/\bgl_PointCoord\b/, 'gl_PointCoord is not available'],
+  [/\b(textureLod|texelFetch|textureSize|textureGrad)\s*\(/, 'only texture()/texture2D() sampling is supported'],
+  [/\biChannel[123]\b/, 'only iChannel0 (bound to the backdrop) is available'],
+  [/\biChannelResolution\b|\biDate\b|\biSampleRate\b|\biFrameRate\b/, 'this Shadertoy input is not provided (iResolution, iTime, iTimeDelta, iMouse, iChannel0 are)']
+]
+
+const SDF_HELPER = [
+  'uniform shader _td_sdf;',
+  'uniform float _td_sdf_range;',
+  'float sdf(float2 p) { return (_td_sdf.eval(p).r - 0.5) * 2.0 * _td_sdf_range; }'
+]
+
+function needsSdf(code: string): boolean {
+  return /\bsdf\s*\(/.test(code) && !/\bfloat\s+sdf\s*\(/.test(code)
+}
+
+/** Translate GLSL (Shadertoy `mainImage` or `void main()`) into an SkSL runtime effect. */
+export function translateGLSL(source: string): TranslatedShader {
+  const lines = preprocess(source)
+  const warnings: string[] = []
+  lines.forEach((line, i) => {
+    const code = stripComments(line)
+    for (const [re, message] of UNSUPPORTED) {
+      if (re.test(code)) throw new ShaderTranslateError(message, i + 1)
+    }
+  })
+  let body = lines.map((l) => l.replace(/^\s*precision\s+\w+\s+\w+\s*;/, '')).join('\n')
+  const declared = parseUniforms(body)
+  const has = (name: string) => declared.some((u) => u.name === name) || new RegExp(`\\b(float|vec\\d|int)\\s+${name}\\b`).test(body)
+  const uses = (name: string) => new RegExp(`\\b${name}\\b`).test(body)
+
+  // Samplers become child shaders sampled in pixels; texture(s, uv) takes 0..1 uv
+  // with y up (GL convention), so the helper flips and scales.
+  const samplers = declared.filter((u) => u.type === 'sampler2D').map((u) => u.name)
+  if (uses('iChannel0') && !samplers.includes('iChannel0')) samplers.push('iChannel0')
+  body = body.replace(/^\s*uniform\s+(?:(?:lowp|mediump|highp)\s+)?sampler2D\s+(\w+)\s*;/gm, '')
+  for (const s of samplers) {
+    body = body.replace(new RegExp(`\\b(texture2D|texture)\\s*\\(\\s*${s}\\s*,`, 'g'), `_td_tex_${s}(`)
+  }
+  if (/\b(texture2D|texture)\s*\(/.test(body)) {
+    const line = body.split('\n').findIndex((l) => /\b(texture2D|texture)\s*\(/.test(stripComments(l))) + 1
+    throw new ShaderTranslateError('texture() on something that is not a declared sampler', line)
+  }
+
+  const prelude: string[] = []
+  const add = (decl: string) => prelude.push(decl)
+  const resName = has('iResolution') ? null : uses('iResolution') ? 'iResolution' : null
+  if (resName) add('uniform float3 iResolution;')
+  if (!has('iTime') && uses('iTime')) add('uniform float iTime;')
+  if (!has('iTimeDelta') && uses('iTimeDelta')) add('uniform float iTimeDelta; // @delta')
+  if (!has('iMouse') && uses('iMouse')) add('uniform float4 iMouse;')
+  if (!has('iFrame') && uses('iFrame')) add('uniform float iFrame; // @frame')
+  // The entry point needs the node size for the y flip.
+  const sizeUniform = declared.find((u) => u.role === 'resolution')?.name ?? (resName || has('iResolution') ? 'iResolution' : null)
+  const sizeExpr = sizeUniform ? `${sizeUniform}.y` : '_td_size.y'
+  if (!sizeUniform) add('uniform float2 _td_size; // @resolution')
+  for (const s of samplers) {
+    const res = sizeUniform ? `${sizeUniform}.xy` : '_td_size'
+    add(`uniform shader ${s};`)
+    add(`float4 _td_tex_${s}(float2 uv) { return float4(${s}.eval(float2(uv.x, 1.0 - uv.y) * ${res})); }`)
+  }
+  if (needsSdf(body)) {
+    // GL coordinates (y up) → the renderer's pixels (y down).
+    prelude.push('uniform shader _td_sdf;', 'uniform float _td_sdf_range;')
+    prelude.push(`float sdf(float2 p) { return (_td_sdf.eval(float2(p.x, ${sizeExpr} - p.y)).r - 0.5) * 2.0 * _td_sdf_range; }`)
+  }
+
+  let entry: string
+  if (/\bvoid\s+mainImage\s*\(/.test(body)) {
+    entry = `half4 main(float2 _td_p) { float4 _td_c = float4(0.0); mainImage(_td_c, float2(_td_p.x, ${sizeExpr} - _td_p.y)); return half4(_td_c.rgb * _td_c.a, _td_c.a); }`
+  } else if (/\bvoid\s+main\s*\(\s*(void)?\s*\)/.test(body)) {
+    // gl_FragColor / gl_FragCoord become parameters of the renamed main.
+    const mainAt = body.search(/\bvoid\s+main\s*\(/)
+    const before = body.slice(0, mainAt)
+    if (/\bgl_FragCoord\b/.test(before)) {
+      const line = before.split('\n').findIndex((l) => /\bgl_FragCoord\b/.test(l)) + 1
+      throw new ShaderTranslateError('gl_FragCoord is only supported inside main()', line)
+    }
+    body =
+      before +
+      body
+        .slice(mainAt)
+        .replace(/\bvoid\s+main\s*\(\s*(void)?\s*\)/, 'void _td_main(inout float4 _td_color, float4 _td_coord)')
+        .replace(/\bgl_FragColor\b/g, '_td_color')
+        .replace(/\bgl_FragCoord\b/g, '_td_coord')
+    entry = `half4 main(float2 _td_p) { float4 _td_c = float4(0.0); _td_main(_td_c, float4(_td_p.x, ${sizeExpr} - _td_p.y, 0.0, 1.0)); return half4(_td_c.rgb * _td_c.a, _td_c.a); }`
+  } else {
+    throw new ShaderTranslateError('GLSL needs `void mainImage(out vec4 fragColor, in vec2 fragCoord)` or `void main()`', 0)
+  }
+  const sksl = [...prelude, body, entry].join('\n')
+  const uniforms = parseUniforms(sksl)
+  return {
+    sksl,
+    lineOffset: prelude.length,
+    uniforms,
+    usesTime: uniforms.some((u) => u.role === 'time'),
+    usesMouse: uniforms.some((u) => u.role === 'mouse'),
+    usesBackdrop: uniforms.some((u) => u.role === 'backdrop') || samplers.length > 0,
+    usesSdf: /\b_td_sdf\b/.test(sksl),
+    warnings
+  }
+}
+
+/** An SkSL source as the renderer compiles it (sdf helper injected when used). */
+export function prepareSKSL(source: string): TranslatedShader {
+  const prelude = needsSdf(source) ? [...SDF_HELPER] : []
+  const sksl = [...prelude, source].join('\n')
+  const uniforms = parseUniforms(sksl)
+  return {
+    sksl,

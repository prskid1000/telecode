+import { describe, expect, test } from 'bun:test'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { CanvasKit } from 'canvaskit-wasm'
+
+import type { Fill } from '@open-pencil/scene-graph'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import {
+  compileShaderDef,
+  distanceField,
+  glslForWebGL,
+  normalizeProceduralFill,
+  parseUniforms,
+  prepareShader,
+  rasterizeProceduralFill,
+  setProceduralMouse,
+  setProceduralRasterizer,
+  setProceduralTime,
+  shaderControls,
+  skslToGLSL,
+  translateGLSL
+} from '#core/canvas/gradients/procedural'
+import { SkiaRenderer } from '#core/canvas/renderer'
+import { renderNodesToSVG } from '#core/io/formats/svg'
+
+import { expectDefined } from '#tests/helpers/assert'
+
+let cachedCk: CanvasKit | null = null
+async function initCanvasKit(): Promise<CanvasKit> {
+  if (cachedCk) return cachedCk
+  const CanvasKitInit = (await import('canvaskit-wasm/full')).default
+  const dir = dirname(fileURLToPath(import.meta.resolve('canvaskit-wasm/full')))
+  cachedCk = await CanvasKitInit({ locateFile: (file: string) => join(dir, file) })
+  return cachedCk
+}
+
+const linked = (id: string, type: Fill['type'] = 'CUSTOM'): Fill => ({ type, color: { r: 0, g: 0, b: 1, a: 1 }, opacity: 1, visible: true, customEffectId: id })
+const defData = (id: string, def: unknown) => ({ pluginId: 'telecode', key: `telecode/fill:${id}`, value: JSON.stringify(def) })
+
+async function scene(size = 100) {
+  const ck = await initCanvasKit()
+  const renderer = new SkiaRenderer(ck, expectDefined(ck.MakeSurface(size, size), 'surface'))
+  const graph = new SceneGraph()
+  const page = expectDefined(graph.getPages()[0], 'page')
+  const draw = (ids: string[]) => {
+    const canvas = renderer.surface.getCanvas()
+    canvas.clear(ck.TRANSPARENT)
+    for (const id of ids) {
+      canvas.save()
+      const n = graph.getNode(id)!
+      canvas.translate(n.x, n.y)
+      renderer.renderShape(canvas, n, graph)
+      canvas.restore()
+    }
+    renderer.surface.flush()
+    const image = renderer.surface.makeImageSnapshot()
+    const pixels = expectDefined(
+      image.readPixels(0, 0, { width: size, height: size, colorType: ck.ColorType.RGBA_8888, alphaType: ck.AlphaType.Unpremul, colorSpace: ck.ColorSpace.SRGB }),
+      'pixels'
+    )
+    image.delete()
+    return (x: number, y: number) => Array.from(pixels.slice((y * size + x) * 4, (y * size + x) * 4 + 4))
+  }
+  return { ck, renderer, graph, page, draw }
+}
+
+const near = (a: number[], b: number[], tol = 12) => a.slice(0, b.length).every((v, i) => Math.abs(v - b[i]) <= tol)
+
+describe('GLSL → SkSL', () => {
+  test('Shadertoy mainImage with #define, iResolution, uniforms and y-up coordinates', async () => {
+    const t = translateGLSL(`#version 300 es
+precision highp float;
+#define HALF 0.5
+#define PICK(a, b, t) mix(a, b, step(HALF, t))
+uniform vec4 top; // @color @label Top
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+  vec2 uv = fragCoord / iResolution.xy;
+  fragColor = PICK(vec4(1.0, 0.0, 0.0, 1.0), top, uv.y);
+}`)
+    expect(t.uniforms.map((u) => [u.name, u.role])).toEqual([['iResolution', 'resolution'], ['top', 'value']])
+    expect(t.uniforms[1]).toMatchObject({ color: true, label: 'Top', floats: 4 })
+    const { renderer, graph, page, draw } = await scene()
+    const def = { kind: 'shader', glsl: t && `#define HALF 0.5
+uniform vec4 top; // @color
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+  vec2 uv = fragCoord / iResolution.xy;
+  fragColor = mix(vec4(1.0, 0.0, 0.0, 1.0), top, step(HALF, uv.y));
+}`, uniforms: { top: '#00ff00' } }
+    const node = graph.createNode('RECTANGLE', page.id, { width: 100, height: 100, fills: [linked('1:1')], pluginData: [defData('1:1', def)] })
+    const px = draw([node.id])
+    // GL's y is up: the top half is "top" (green), the bottom half red.
+    expect(near(px(50, 10), [0, 255, 0, 255])).toBe(true)
+    expect(near(px(50, 90), [255, 0, 0, 255])).toBe(true)
+    renderer.destroy()
+  })
+
+  test('void main() with gl_FragColor / gl_FragCoord', async () => {
+    const { renderer, graph, page, draw } = await scene()
+    const def = { kind: 'shader', source: `precision mediump float;
+uniform vec2 u_size;
+void main() { gl_FragColor = gl_FragCoord.x < u_size.x * 0.5 ? vec4(0.0, 0.0, 1.0, 1.0) : vec4(1.0, 1.0, 0.0, 1.0); }` }
+    expect(normalizeProceduralFill(def)).toMatchObject({ lang: 'glsl' })
+    const node = graph.createNode('RECTANGLE', page.id, { width: 100, height: 100, fills: [linked('1:2')], pluginData: [defData('1:2', def)] })
+    const px = draw([node.id])

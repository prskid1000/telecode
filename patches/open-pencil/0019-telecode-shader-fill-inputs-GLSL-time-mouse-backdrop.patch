+describe('export', () => {
+  test('SkSL → GLSL ES 1.0 and GLSL for WebGL', () => {
+    const g = skslToGLSL(`uniform float2 u_size;
+uniform shader backdrop;
+uniform float4 tint;
+half4 main(float2 p) { half4 b = backdrop.eval(p); return half4(b.rgb * tint.rgb, 1.0); }`)
+    expect(g).toContain('uniform sampler2D backdrop;')
+    expect(g).toContain('vec4 _td_entry(vec2 p)')
+    expect(g).toContain('_td_sample_backdrop(p)')
+    expect(g).toContain('gl_FragColor = _td_entry(')
+    expect(g).not.toMatch(/\bhalf4\b|\bfloat2\b/)
+    const w = glslForWebGL('void mainImage(out vec4 c, in vec2 f) { c = vec4(f / iResolution.xy, sin(iTime), 1.0); }')
+    expect(w).toContain('uniform vec3 iResolution;')
+    expect(w).toContain('uniform float iTime;')
+    expect(w).toContain('mainImage(c, gl_FragCoord.xy)')
+  })

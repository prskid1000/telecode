+/** Resolve a variable as seen by `nodeId`: every collection in its own (inherited) mode. */
+export function resolveVariableForNode(
+  graph: SceneGraph,
+  nodeId: string,
+  variableId: string
+): VariableValue | undefined {
+  const variable = graph.variables.get(variableId)
+  if (!variable) return undefined
+  const modeFor = (collectionId: string) => getNodeVariableModeId(graph, nodeId, collectionId)
+  return resolveVariable(graph, variableId, modeFor(variable.collectionId), undefined, modeFor)
+}

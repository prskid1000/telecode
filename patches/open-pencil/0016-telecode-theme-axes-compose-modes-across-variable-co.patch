diff --git a/src/app/integrations/telecode/themes.ts b/src/app/integrations/telecode/themes.ts
new file mode 100644
index 00000000..2b071d66
--- /dev/null
+++ b/src/app/integrations/telecode/themes.ts
@@ -0,0 +1,125 @@
+/**
+ * Theme axes (telecode / TeleDesign).
+ *
+ * open-pencil already models what pen.dev calls theme axes: every variable
+ * collection is one axis (Mode: Light/Dark, Density: Compact/Comfortable, …), each
+ * node may pin a mode per collection (`variableModes`), and a node without one
+ * inherits its nearest ancestor's, falling back to the collection's active mode.
+ * Two things were missing, and this module plus the scene-graph patch add them:
+ *
+ *  - composition: an alias into another collection now resolves in that
+ *    collection's mode for the node (scene-graph `resolveVariableForNode`), so a
+ *    Density variable can alias Mode-dependent values and follow both axes;
+ *  - a way to set and read a frame's theme per axis (explicit vs inherited), for
+ *    agents (telecode_theme_set / telecode_theme_get) and the TeleDesign shell.
+ */
+import type { SceneNode, VariableCollection } from '@open-pencil/scene-graph'
+
+import type { EditorStore } from '@/app/editor/session'
+
+export interface ThemeAxis {
+  collection: string
+  collection_id: string
+  modes: string[]
+  default_mode: string
+  active_mode: string
+}
+
+function modeName(collection: VariableCollection, modeId: string): string {
+  return collection.modes.find((m) => m.modeId === modeId)?.name ?? modeId
+}
+
+function findCollection(store: EditorStore, ref: string): VariableCollection | undefined {
+  const byId = store.graph.variableCollections.get(ref)
+  if (byId) return byId
+  for (const collection of store.graph.variableCollections.values()) {
+    if (collection.name === ref) return collection
+  }
+  return undefined
+}
+
+export function listAxes(store: EditorStore): ThemeAxis[] {
+  return [...store.graph.variableCollections.values()].map((collection) => ({
+    collection: collection.name,
+    collection_id: collection.id,
+    modes: collection.modes.map((m) => m.name),
+    default_mode: modeName(collection, collection.defaultModeId),
+    active_mode: modeName(collection, store.graph.getActiveModeId(collection.id))
+  }))
+}
+
+/** A node's theme: the modes it pins itself, and what every axis resolves to for it (and from where). */
+export function themeOf(store: EditorStore, nodeId: string) {
+  const node = store.graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  const explicit: Record<string, string> = {}
+  const resolved: Record<string, { mode: string; from: string | null; from_id: string | null }> = {}
+  for (const collection of store.graph.variableCollections.values()) {
+    const own = node.variableModes[collection.id]
+    if (own) explicit[collection.name] = modeName(collection, own)
+    let from: SceneNode | undefined
+    let current: SceneNode | undefined = node
+    while (current) {
+      if (current.variableModes[collection.id]) {
+        from = current
+        break
+      }
+      current = current.parentId ? store.graph.getNode(current.parentId) : undefined
+    }
+    const modeId = store.graph.getNodeVariableModeId(node.id, collection.id)
+    resolved[collection.name] = {
+      mode: modeName(collection, modeId),
+      from: from ? (from.type === 'CANVAS' ? `page ${from.name}` : from.name) : null,
+      from_id: from?.id ?? null
+    }
+  }
+  return { node_id: node.id, name: node.name, explicit, resolved, axes: listAxes(store) }
+}
+
+/**
+ * Pin (mode name) or clear (null / "") a node's mode per axis. Keys are collection
+ * names (or ids); values are mode names (or ids). One undo step.
+ */
+export async function setTheme(store: EditorStore, nodeId: string, modes: Record<string, unknown>) {
+  const node = store.graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  if (!modes || typeof modes !== 'object' || Array.isArray(modes)) throw new Error('"modes" must be {Collection: Mode | null}')
+  const next = { ...node.variableModes }
+  for (const [ref, value] of Object.entries(modes)) {
+    const collection = findCollection(store, ref)
+    if (!collection) throw new Error(`No variable collection "${ref}"`)
+    if (value === null || value === '' || value === undefined) {
+      delete next[collection.id]
+      continue
+    }
+    if (typeof value !== 'string') throw new Error(`Mode for "${ref}" must be a mode name`)
+    const mode = collection.modes.find((m) => m.name === value || m.modeId === value)
+    if (!mode) {
+      throw new Error(`Collection "${collection.name}" has no mode "${value}" (${collection.modes.map((m) => m.name).join(', ')})`)
+    }
+    next[collection.id] = mode.modeId
+  }
+  const before = store.snapshotPage()
+  store.graph.updateNode(nodeId, { variableModes: next })
+  const after = store.snapshotPage()
+  store.pushUndoEntry({
+    label: 'Set theme',
+    forward: () => store.restorePageFromSnapshot(after),
+    inverse: () => store.restorePageFromSnapshot(before)
+  })
+  store.requestRender()
+  return themeOf(store, nodeId)
+}
+
+/** The document-wide mode per axis (what an un-themed node shows). */
+export function setActiveModes(store: EditorStore, modes: Record<string, unknown>) {
+  for (const [ref, value] of Object.entries(modes ?? {})) {
+    const collection = findCollection(store, ref)
+    if (!collection) throw new Error(`No variable collection "${ref}"`)
+    const mode = collection.modes.find((m) => m.name === value || m.modeId === value)
+    if (!mode) throw new Error(`Collection "${collection.name}" has no mode "${String(value)}"`)
+    store.graph.setActiveMode(collection.id, mode.modeId)
+  }
+  store.requestRender()
+  return listAxes(store)
+}
diff --git a/tests/engine/app/telecode/themes.test.ts b/tests/engine/app/telecode/themes.test.ts
new file mode 100644
index 00000000..2d2c25dd
--- /dev/null
+++ b/tests/engine/app/telecode/themes.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/core'
+
+import type { EditorStore } from '@/app/editor/session'
+import { setTheme, themeOf } from '@/app/integrations/telecode/themes'
+
+const DARK = { r: 0.1, g: 0.1, b: 0.1, a: 1 }
+const LIGHT = { r: 1, g: 1, b: 1, a: 1 }
+const DARK_DENSE = { r: 0.2, g: 0.2, b: 0.2, a: 1 }
+const LIGHT_DENSE = { r: 0.9, g: 0.9, b: 0.9, a: 1 }
+
+/** Mode (Light/Dark) × Density (Comfortable/Compact); `surface` depends on both. */
+function twoAxes() {
+  const graph = new SceneGraph()
+  graph.addCollection({
+    id: 'mode',
+    name: 'Mode',
+    modes: [
+      { modeId: 'light', name: 'Light' },
+      { modeId: 'dark', name: 'Dark' }
+    ],
+    defaultModeId: 'light',
+    variableIds: []
+  })
+  graph.addCollection({
+    id: 'density',
+    name: 'Density',
+    modes: [
+      { modeId: 'comfy', name: 'Comfortable' },
+      { modeId: 'compact', name: 'Compact' }
+    ],
+    defaultModeId: 'comfy',
+    variableIds: []
+  })
+  const add = (id: string, collectionId: string, valuesByMode: Record<string, unknown>, type = 'COLOR') =>
+    graph.addVariable({
+      id,
+      name: id,
+      type: type as 'COLOR',
+      collectionId,
+      valuesByMode: valuesByMode as never,
+      description: '',
+      hiddenFromPublishing: false
+    })
+  add('surface-comfy', 'mode', { light: LIGHT, dark: DARK })
+  add('surface-compact', 'mode', { light: LIGHT_DENSE, dark: DARK_DENSE })
+  add('surface', 'density', { comfy: { aliasId: 'surface-comfy' }, compact: { aliasId: 'surface-compact' } })
+  add('gap', 'density', { comfy: 16, compact: 8 }, 'FLOAT')
+  const page = graph.getPages()[0].id
+  const outer = graph.createNode('FRAME', page, { name: 'Outer' })
+  const inner = graph.createNode('FRAME', outer.id, { name: 'Inner' })
+  const leaf = graph.createNode('RECTANGLE', inner.id, { name: 'Leaf' })
+  return { graph, outer, inner, leaf }
+}
+
+function fakeStore(graph: SceneGraph): EditorStore {
+  return {
+    graph,
+    snapshotPage: () => null,
+    restorePageFromSnapshot: () => {},
+    pushUndoEntry: () => {},
+    requestRender: () => {}
+  } as unknown as EditorStore
+}
+
+describe('theme axes', () => {
+  test('an alias into another collection follows that collection’s mode for the node', () => {
+    const { graph, outer, inner, leaf } = twoAxes()
+    expect(graph.resolveColorVariableForNode(leaf.id, 'surface')).toEqual(LIGHT)
+    graph.updateNode(outer.id, { variableModes: { mode: 'dark' } })
+    expect(graph.resolveColorVariableForNode(leaf.id, 'surface')).toEqual(DARK)
+    graph.updateNode(inner.id, { variableModes: { density: 'compact' } })
+    // Dark from Outer, Compact from Inner: both axes apply.
+    expect(graph.resolveColorVariableForNode(leaf.id, 'surface')).toEqual(DARK_DENSE)
+    expect(graph.resolveNumberVariableForNode(leaf.id, 'gap')).toBe(8)
+    // Without a node, each collection's active mode is used.
+    graph.setActiveMode('density', 'compact')
+    expect(graph.resolveColorVariable('surface')).toEqual(LIGHT_DENSE)
+  })
+
+  test('telecode_theme_set / _get: pin, inherit, clear', async () => {
+    const { graph, outer, leaf } = twoAxes()
+    const store = fakeStore(graph)
+    await setTheme(store, outer.id, { Mode: 'Dark', Density: 'Compact' })
+    const t = themeOf(store, leaf.id)
+    expect(t.explicit).toEqual({})
+    expect(t.resolved.Mode).toEqual({ mode: 'Dark', from: 'Outer', from_id: outer.id })
+    expect(t.resolved.Density.mode).toBe('Compact')
+    expect(graph.resolveColorVariableForNode(leaf.id, 'surface')).toEqual(DARK_DENSE)
+    await setTheme(store, outer.id, { Density: null })
+    expect(themeOf(store, outer.id).explicit).toEqual({ Mode: 'Dark' })
+    expect(themeOf(store, leaf.id).resolved.Density).toEqual({ mode: 'Comfortable', from: null, from_id: null })
+    await expect(setTheme(store, outer.id, { Mode: 'Sepia' })).rejects.toThrow(/no mode "Sepia"/)
+    await expect(setTheme(store, outer.id, { Nope: 'x' })).rejects.toThrow(/No variable collection/)
+  })
+})

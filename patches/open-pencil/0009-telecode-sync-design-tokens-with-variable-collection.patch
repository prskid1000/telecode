 src/app/integrations/telecode/commands.ts  |   9 +
 src/app/integrations/telecode/variables.ts | 213 +++++++++++++++++++++
 3 files changed, 248 insertions(+)
 create mode 100644 src/app/integrations/telecode/variables.ts


From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Prithwiraj Samanta <app@datainsights.ae>
Date: Fri, 25 Sep 2026 08:10:00 +0530
Subject: [PATCH 1/7] telecode: serve the router under import.meta.env.BASE_URL

The editor is mounted at /design/editor/ inside the telecode proxy; a
root-anchored history would rewrite the address bar to / on the first
navigation and break a reload.
---
 src/router.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/router.ts b/src/router.ts
index eeed3900..7bdcd790 100644
--- a/src/router.ts
+++ b/src/router.ts
@@ -3,7 +3,7 @@ import { createRouter, createWebHistory } from 'vue-router'
 import WorkspaceView from './views/WorkspaceView.vue'
 
 const router = createRouter({
-  history: createWebHistory(),
+  history: createWebHistory(import.meta.env.BASE_URL),
   routes: [
     { path: '/', component: WorkspaceView },
     { path: '/storage', redirect: '/' },

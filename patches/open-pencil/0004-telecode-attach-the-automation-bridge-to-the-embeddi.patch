diff --git a/src/app/integrations/telecode/automation.ts b/src/app/integrations/telecode/automation.ts
new file mode 100644
index 00000000..1ef3cfed
--- /dev/null
+++ b/src/app/integrations/telecode/automation.ts
@@ -0,0 +1,56 @@
+/**
+ * Attach the automation bridge to telecode instead of a spawned MCP server.
+ *
+ * Upstream only connects the bridge in dev builds or the desktop app, where it
+ * can spawn `openpencil-mcp-http`. Under telecode the server side of the same
+ * register/request/response protocol lives in the proxy (WebSocket at
+ * /api/design/editor-bridge), so there is nothing to spawn: the handle is
+ * external and the connection is always allowed.
+ */
+import { connectAutomation } from '@/app/automation/bridge/server'
+import type { MCPRuntimeDependencies } from '@/app/automation/mcp/runtime'
+import { setMCPToolDescriptors } from '@/app/automation/mcp/preferences'
+import { mcpFailure, type MCPFailure } from '@/app/automation/mcp/failure'
+import { parseAutomationHealth } from '@/app/automation/mcp/spawn'
+
+import type { TelecodeConfig } from './config'
+
+export function createTelecodeMCPDependencies(config: TelecodeConfig): MCPRuntimeDependencies {
+  let healthFailure: MCPFailure | null = null
+  return {
+    connect: (getStore, authToken) =>
+      connectAutomation(getStore, authToken ?? config.bridgeToken, config.bridgeURL).disconnect,
+    canConnect: () => true,
+    async readHealth() {
+      try {
+        const headers: Record<string, string> = config.bridgeToken
+          ? { Authorization: `Bearer ${config.bridgeToken}` }
+          : {}
+        const res = await fetch(config.bridgeHealthURL, {
+          headers,
+          signal: AbortSignal.timeout(3000)
+        })
+        if (!res.ok) {
+          healthFailure = mcpFailure(
+            res.status === 401 || res.status === 403 ? 'rejected' : 'malformed',
+            `HTTP ${res.status}`
+          )
+          return null
+        }
+        const health = parseAutomationHealth(await res.json())
+        healthFailure = health ? null : mcpFailure('malformed', config.bridgeHealthURL)
+        return health
+      } catch (error) {
+        healthFailure = mcpFailure(
+          'unreachable',
+          error instanceof Error ? error.message : String(error)
+        )
+        return null
+      }
+    },
+    setToolDescriptors: setMCPToolDescriptors,
+    spawn: async () => ({ disconnect: () => undefined, authToken: config.bridgeToken, managed: false }),
+    getStartupFailure: () => null,
+    getHealthFailure: () => healthFailure
+  }
+}
diff --git a/src/app/integrations/telecode/config.ts b/src/app/integrations/telecode/config.ts
new file mode 100644
index 00000000..397716b3
--- /dev/null
+++ b/src/app/integrations/telecode/config.ts
@@ -0,0 +1,71 @@
+/**
+ * TeleDesign embedding (telecode).
+ *
+ * The editor runs inside the telecode proxy at /design/editor/ and is told which
+ * project to open with `?project=<32-hex id>`. Everything telecode-specific keys
+ * off this config: when it is null the editor behaves exactly like upstream.
+ */
+import { IS_BROWSER, IS_TAURI } from '@open-pencil/core/constants'
+
+export interface TelecodeConfig {
+  /** TeleDesign project id (32 lowercase hex characters). */
+  projectId: string
+  /** Origin that serves the REST API — always the page's own origin. */
+  apiOrigin: string
+  /** WebSocket URL of the automation bridge (register/request/response). */
+  bridgeURL: string
+  /** HTTP URL of the bridge health endpoint. */
+  bridgeHealthURL: string
+  /** Token sent in the bridge `register` message. */
+  bridgeToken: string | null
+}
+
+const PROJECT_ID = /^[0-9a-f]{32}$/
+const BRIDGE_PATH = '/api/design/editor-bridge'
+
+let cached: TelecodeConfig | null | undefined
+
+function sameOriginWebSocketURL(raw: string | null, fallback: string): string {
+  if (!raw) return fallback
+  try {
+    const parsed = new window.URL(raw, window.location.href)
+    // The bridge can drive the whole document (including eval), so it is only
+    // ever the server that served this page — never a URL a link supplies.
+    const expectedHost = window.location.host
+    if (parsed.host !== expectedHost) return fallback
+    if (parsed.protocol !== 'ws:' && parsed.protocol !== 'wss:') return fallback
+    return parsed.toString()
+  } catch {
+    return fallback
+  }
+}
+
+function readMetaToken(): string | null {
+  const meta = document.querySelector('meta[name="td-bridge-token"]')
+  const value = meta?.getAttribute('content')?.trim()
+  return value ? value : null
+}
+
+export function readTelecodeConfig(search?: string): TelecodeConfig | null {
+  if (search === undefined && cached !== undefined) return cached
+  if (!IS_BROWSER || IS_TAURI) return (cached = null)
+  const params = new URLSearchParams(search ?? window.location.search)
+  const projectId = params.get('project')?.trim().toLowerCase() ?? ''
+  if (!PROJECT_ID.test(projectId)) return (cached = null)
+  const apiOrigin = window.location.origin
+  const wsOrigin = apiOrigin.replace(/^http/, 'ws')
+  const defaultBridge = `${wsOrigin}${BRIDGE_PATH}?project=${projectId}`
+  const config: TelecodeConfig = {
+    projectId,
+    apiOrigin,
+    bridgeURL: sameOriginWebSocketURL(params.get('bridge'), defaultBridge),
+    bridgeHealthURL: `${apiOrigin}${BRIDGE_PATH}/health?project=${projectId}`,
+    bridgeToken: params.get('bridge_token')?.trim() || readMetaToken()
+  }
+  if (search === undefined) cached = config
+  return config
+}
+
+export function isTelecodeEmbed(): boolean {
+  return readTelecodeConfig() !== null
+}

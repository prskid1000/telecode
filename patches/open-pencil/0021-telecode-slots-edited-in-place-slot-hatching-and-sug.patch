+        next.onEditorEvent('viewport:changed', schedule),
+        next.onEditorEvent('node:created', (node: { id: string }) => {
+          maybeAdopt(node.id)
+          queueSlots()
+          refreshAnimated()
+        }),
+        next.onEditorEvent('node:reparented', (id: string) => {
+          maybeAdopt(id)
+          queueSlots()
+        }),
+        next.onEditorEvent('node:deleted', () => {
+          queueSlots()
+          refreshAnimated()
+        }),
+        next.onEditorEvent('node:updated', (_id: string, changes: Record<string, unknown>) => {
+          if ('fills' in changes || 'pluginData' in changes || 'visible' in changes) refreshAnimated()
+          if ('pluginData' in changes || 'width' in changes || 'height' in changes || 'x' in changes || 'y' in changes) queueSlots()
+        })
+      ]
+      queueSlots()
+      refreshAnimated()
+    },
+    post() {
+      postSlots()
+    },
+    cleanup() {
+      stop()
+      for (const off of offs) off()
+      offs = []
+      document.removeEventListener('visibilitychange', onVisibility)
+      window.removeEventListener('pointermove', onPointer)
+      document.removeEventListener('pointerleave', onLeave)
+      setProceduralRasterizer(null)
+      setProceduralTextures(null)
+      setProceduralMouse(null)
+      setProceduralTime(null)
+    }
+  }
+}

+/**
+ * Shader and mesh-gradient fills in the HTML export (telecode / TeleDesign).
+ *
+ * The exported element keeps a PNG of the fill (rendered by the editor's own
+ * renderer) as its CSS background, so the page looks right without script or
+ * WebGL; `data-td-fx` carries what the small runtime below needs to draw the
+ * real thing live in a <canvas> behind the element's children:
+ *
+ *  - shaders run as WebGL fragment shaders — GLSL sources as written (the
+ *    Shadertoy inputs declared), SkSL translated to GLSL ES 1.0 — with the same
+ *    uniforms; `@time` animates and `@mouse` follows the pointer while the
+ *    element is on screen and the tab is visible; `@backdrop` and `sdf()` are
+ *    textures rendered at export time (the page behind a static HTML export is
+ *    whatever the export put there, so the backdrop is frozen);
+ *  - meshes are tessellated Coons patches drawn with per-vertex colours.
+ *
+ * When a shader cannot be expressed in GLSL ES 1.0 the export keeps the PNG
+ * only and says so in `fx_warnings`.
+ */
+import {
+  glslForWebGL,
+  meshPatches,
+  prepareShader,
+  proceduralFillOf,
+  proceduralRasterizer,
+  proceduralTextures,
+  SHADER_PRESETS,
+  skslToGLSL,
+  type ProceduralFillDef
+} from '@open-pencil/core/canvas'
+import type { Fill, SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+function base64(bytes: Uint8Array): string {
+  let s = ''
+  for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode(...bytes.subarray(i, i + 0x8000))
+  return btoa(s)
+}
+
+const png = (bytes: Uint8Array | null | undefined) => (bytes ? `data:image/png;base64,${base64(bytes)}` : null)
+
+function shaderConfig(graph: SceneGraph, node: SceneNode, def: Extract<ProceduralFillDef, { kind: 'shader' }>) {
+  const p = prepareShader(def)
+  if (p.error) throw new Error(p.error)
+  const glsl = p.lang === 'glsl' ? glslForWebGL(p.source) : skslToGLSL(p.sksl)
+  const presetUniforms = def.preset ? (SHADER_PRESETS[def.preset]?.uniforms ?? {}) : {}
+  const uniforms = p.uniforms
+    .filter((u) => u.floats > 0)
+    .map((u) => {
+      const v = def.uniforms?.[u.name] ?? presetUniforms[u.name] ?? u.default ?? []
+      return { name: u.name, role: u.name === '_td_sdf_range' ? 'sdf_range' : u.role, floats: u.floats, value: Array.isArray(v) ? v : [v] }
+    })
+  const textures: Record<string, string> = {}
+  const tex = proceduralTextures()
+  let sdfRange: number | undefined
+  for (const u of p.uniforms) {
+    if (u.floats > 0) continue
+    if (u.role === 'backdrop') {
+      const t = png(tex?.backdrop(graph, node))
+      if (t) textures[u.name] = t
+    } else if (u.name === '_td_sdf' || u.role === 'sdf') {
+      const sdf = tex?.sdf(node)
+      if (sdf) {
+        const t = png(sdf.png)
+        if (t) textures[u.name] = t
+        sdfRange = sdf.range
+      }
+    }
+  }
+  return { kind: 'shader' as const, glsl, uniforms, textures, sdf_range: sdfRange, glsl_coords: p.lang === 'glsl' }
+}
+
+function meshConfig(node: SceneNode, def: Extract<ProceduralFillDef, { kind: 'mesh' }>) {
+  const round = (v: number) => Math.round(v * 100) / 100
+  return {
+    kind: 'mesh' as const,
+    patches: meshPatches(def, node.width, node.height).map((patch) => ({
+      c: patch.cubics.map(round),
+      k: patch.corners.map((i) => def.points[i].color.map((v) => Math.round(v * 1000) / 1000))
+    }))
+  }
+}
+
+/**
+ * For one node: the CSS background (PNG of its procedural fills, top fill
+ * first) and the `data-td-fx` payload of the topmost one the runtime can draw.
+ */
+export function fxForNode(graph: SceneGraph, node: SceneNode): { backgrounds: string[]; fx: object | null; warnings: string[] } {
+  const backgrounds: string[] = []
+  const warnings: string[] = []
+  let fx: object | null = null
+  const raster = proceduralRasterizer()
+  const fills: Fill[] = node.fills ?? []
+  for (let i = fills.length - 1; i >= 0; i--) {
+    const fill = fills[i]
+    if (fill.visible === false) continue
+    const def = proceduralFillOf(node, fill)
+    if (!def) continue
+    const image = png(raster?.(graph, node, fill))
+    if (image) backgrounds.push(`url("${image}")`)
+    if (fx) continue

@@ -0,0 +1,159 @@
+/**
+ * `telecode` storage provider: TeleDesign projects stored by the telecode proxy.
+ *
+ * A project's canvas is one .fig at GET/PUT /api/design/projects/{id}/canvas.
+ * The proxy is authoritative (it versions and restores doc.fig itself), so a
+ * write goes straight to it instead of through the local-first IndexedDB mirror
+ * the S3 provider uses — a mirror would shadow a restore made on the server.
+ */
+import { defineStorageProvider } from '@/app/integrations/storage/registry'
+import type {
+  StorageAdapter,
+  StorageDocument,
+  StorageDocumentMetadata,
+  StorageTransferProgress
+} from '@/app/integrations/storage/types'
+
+export const TELECODE_STORAGE_PROVIDER_ID = 'telecode'
+
+const PROJECT_ID = /^[0-9a-f]{32}$/
+
+type ProjectRecord = { id: string; title?: string; updated_at?: string; archived?: boolean }
+
+type SavedListener = (projectId: string, bytes: number) => void
+const savedListeners = new Set<SavedListener>()
+
+/** Notified after every successful PUT of a project's canvas. */
+export function onTelecodeCanvasSaved(listener: SavedListener): () => void {
+  savedListeners.add(listener)
+  return () => savedListeners.delete(listener)
+}
+
+function apiURL(path: string): string {
+  return `${window.location.origin}/api/design${path}`
+}
+
+function projectPath(id: string, suffix = ''): string {
+  if (!PROJECT_ID.test(id)) throw new Error(`Invalid TeleDesign project id: ${id}`)
+  return `/projects/${id}${suffix}`
+}
+
+async function readJSON<T>(res: Response): Promise<T> {
+  if (!res.ok) throw new Error(`TeleDesign API ${res.status} ${res.statusText}`)
+  return (await res.json()) as T
+}
+
+function toDocument(project: ProjectRecord): StorageDocument {
+  return {
+    id: project.id,
+    name: project.title || 'Untitled design',
+    updatedAt: project.updated_at ?? new Date(0).toISOString(),
+    metadataAuthoritative: true
+  }
+}
+
+/** The project's saved canvas, or null when it has never been saved. */
+export async function fetchTelecodeCanvas(
+  id: string,
+  onProgress?: (progress: StorageTransferProgress) => void,
+  signal?: AbortSignal
+): Promise<Uint8Array | null> {
+  // Ask first whether a canvas exists, so a never-saved project does not log a
+  // failed request (a 404) in the console on every open.
+  const probe = await fetch(apiURL(projectPath(id, '/editor')), { signal, cache: 'no-store' })
+  if (probe.status === 404) throw new Error('TeleDesign project not found')
+  if (probe.ok) {
+    const { editor } = (await probe.json()) as { editor?: { has_canvas?: boolean } }
+    if (editor?.has_canvas === false) return null
+  }
+  const res = await fetch(apiURL(projectPath(id, '/canvas')), { signal, cache: 'no-store' })
+  if (res.status === 404) {
+    // 404 means either "no canvas yet" or "no such project"; tell them apart.
+    const project = await fetch(apiURL(projectPath(id)), { signal, cache: 'no-store' })
+    if (project.status === 404) throw new Error('TeleDesign project not found')
+    return null
+  }
+  if (!res.ok) throw new Error(`Canvas download failed: HTTP ${res.status}`)
+  const bytes = new Uint8Array(await res.arrayBuffer())
+  onProgress?.({ transferredBytes: bytes.byteLength, totalBytes: bytes.byteLength })
+  return bytes
+}
+
+export async function putTelecodeCanvas(
+  id: string,
+  bytes: Uint8Array,
+  onProgress?: (progress: StorageTransferProgress) => void
+): Promise<void> {
+  const body = new Uint8Array(bytes.byteLength)
+  body.set(bytes)
+  // application/octet-stream is not CORS-simple: the proxy relies on that so a
+  // page from the preview origin cannot forge this write.
+  const res = await fetch(apiURL(projectPath(id, '/canvas')), {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/octet-stream' },
+    body
+  })
+  if (!res.ok) {
+    let detail = `${res.status}`
+    try {
+      detail = ((await res.json()) as { error?: string }).error ?? detail
+    } catch {
+      // keep the status code
+    }
+    throw new Error(`Canvas save failed: ${detail}`)
+  }
+  onProgress?.({ transferredBytes: bytes.byteLength, totalBytes: bytes.byteLength })
+  for (const listener of savedListeners) listener(id, bytes.byteLength)
+}
+
+export function createTelecodeStorageAdapter(): StorageAdapter {
+  return {
+    async testConnection() {
+      try {
+        const res = await fetch(apiURL('/projects'), { cache: 'no-store' })
+        return res.ok
+          ? { ok: true, message: 'Connected to TeleDesign' }
+          : { ok: false, message: `HTTP ${res.status}` }
+      } catch (error) {
+        return { ok: false, message: error instanceof Error ? error.message : String(error) }
+      }
+    },
+    async listDocuments() {
+      const res = await fetch(apiURL('/projects'), { cache: 'no-store' })
+      const { projects } = await readJSON<{ projects: ProjectRecord[] }>(res)
+      return projects.filter((project) => !project.archived).map(toDocument)
+    },
+    async getDocument(id, onProgress, signal) {
+      const bytes = await fetchTelecodeCanvas(id, onProgress, signal)
+      if (!bytes) throw new Error('This project has no saved canvas yet')
+      return bytes
+    },
+    async putDocument(id, bytes, _metadata: StorageDocumentMetadata, onProgress) {
+      await putTelecodeCanvas(id, bytes, onProgress)
+    },
+    async deleteDocument() {
+      throw new Error('Delete TeleDesign projects from the TeleDesign gallery')
+    },
+    async getDocumentMetadata(id) {
+      const res = await fetch(apiURL(projectPath(id)), { cache: 'no-store' })
+      if (res.status === 404) return null
+      const { project } = await readJSON<{ project: ProjectRecord }>(res)
+      const doc = toDocument(project)
+      return { name: doc.name, updatedAt: doc.updatedAt }
+    },
+    async getUsage() {
+      const res = await fetch(apiURL('/projects'), { cache: 'no-store' })
+      const { projects } = await readJSON<{ projects: ProjectRecord[] }>(res)
+      return { bytesUsed: 0, objectCount: projects.length, documentCount: projects.length }
+    }
+  }
+}
+
+export const TELECODE_STORAGE_PROVIDER = defineStorageProvider({
+  id: TELECODE_STORAGE_PROVIDER_ID,
+  label: 'TeleDesign',
+  description: 'Projects stored by the telecode proxy (TeleDesign)',
+  preferenceFields: [],
+  credentialFields: [],
+  createAdapter: () => createTelecodeStorageAdapter()
+})

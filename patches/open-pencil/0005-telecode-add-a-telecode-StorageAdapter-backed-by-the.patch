+/**
+ * Open a TeleDesign project's canvas (telecode embedding) bound to the `telecode`
+ * storage provider, so Save and autosave write it back to the proxy. A project
+ * that has never been saved opens as an empty document with the same binding.
+ */
+export async function openTelecodeProject(projectId: string, name: string): Promise<EditorStore> {
+  const binding = { providerId: TELECODE_STORAGE_PROVIDER_ID, documentId: projectId }
+  const existing = findStorageTab(binding.providerId, projectId)
+  if (existing) {
+    switchTab(existing.id)
+    return existing.store
+  }
+
+  const { store } = reusableTabStore()
+  store.state.documentName = name
+  const load = store.preparationController.begin({ kind: 'storage-open', subject: name })
+  let succeeded = false
+  try {
+    load.update({ phase: 'reading', detail: name })
+    const bytes = await fetchTelecodeCanvas(
+      projectId,
+      (progress) =>
+        load.update({
+          phase: 'reading',
+          detail: name,
+          completed: progress.transferredBytes,
+          total: progress.totalBytes,
+          unit: 'bytes'
+        }),
+      load.signal
+    )
+    load.signal.throwIfAborted()
+    if (bytes) {
+      const fileBytes = new Uint8Array(bytes.byteLength)
+      fileBytes.set(bytes)
+      const file = new File([fileBytes.buffer], `${name}.fig`, { type: 'application/octet-stream' })
+      load.update({ phase: 'decoding', detail: name })
+      const imported = await readFigForTab(file, load.signal)
+      await showImportedGraph(
+        store,
+        imported,
+        () => store.setStorageDocumentSource(binding, name),
+        load
+      )
+    } else {
+      store.setStorageDocumentSource(binding, name)
+    }
+    succeeded = true
+    return store
+  } catch (error) {
+    if (!load.signal.aborted) {
+      load.fail({
+        code: 'read-failed',
+        message: error instanceof Error ? error.message : String(error),
+        retryable: true
+      })
+      toast.error(
+        notificationMessages.get().openFileFailed({
+          name,
+          error: error instanceof Error ? error.message : String(error)
+        })
+      )
+    }
+    throw error
+  } finally {
+    if (succeeded) load.complete()
+  }
+}

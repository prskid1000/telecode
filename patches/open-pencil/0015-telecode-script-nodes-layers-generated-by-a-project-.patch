+/** null, "", [] and {} all mean "not set" — the .fig round trip turns one into another. */
+function isEmpty(value: Json): boolean {
+  if (value === null || value === '') return true
+  if (Array.isArray(value)) return value.length === 0
+  if (typeof value === 'object') return Object.keys(value).length === 0
+  return false
+}
+
+const PAINT_FIELDS = new Set(['fills', 'strokes', 'effects', 'textDecorationFills'])
+const CORNER_FIELDS = new Set(['topLeftRadius', 'topRightRadius', 'bottomRightRadius', 'bottomLeftRadius'])
+
+/**
+ * Spellings that mean the same document: what a node looks like right after it
+ * is created and after the .fig round trip must mirror identically.
+ */
+function canonicalField(key: string, value: Json, node: Record<string, unknown>): Json {
+  if (PAINT_FIELDS.has(key) && Array.isArray(value)) {
+    return value.map((paint) => {
+      if (!paint || typeof paint !== 'object' || Array.isArray(paint)) return paint
+      const { blendMode, ...rest } = paint
+      return sortedObject(Object.entries(blendMode === 'NORMAL' || blendMode === undefined ? rest : paint))
+    })
+  }
+  // Per-corner radii only mean something when the corners are independent.
+  if (CORNER_FIELDS.has(key) && !node.independentCorners) return null
+  if (key === 'pluginData' && Array.isArray(value)) {
+    // open-pencil's own entries carry format round-trip state (and raw ids), not design.
+    return value.filter(
+      (entry) => !(entry && typeof entry === 'object' && !Array.isArray(entry) && entry.pluginId === 'open-pencil')
+    )
+  }
+  if (key === 'fontFeatures' && Array.isArray(value)) {
+    // Ligatures on is what "no features set" renders as.
+    return value.filter(
+      (f) =>
+        !(f && typeof f === 'object' && !Array.isArray(f) && f.enabled === true && (f.tag === 'LIGA' || f.tag === 'CALT'))
+    )
+  }
+  if ((key === 'componentId' || key === 'booleanOperation') && (value === '' || value === null)) return null
+  return value
+}

+/**
+ * Script-node source headers (telecode / TeleDesign).
+ *
+ * A script node is a frame backed by a `.js` file in the project. The file's
+ * comment header declares the inputs the canvas turns into property controls:
+ *
+ *   // @schema 1
+ *   // @name Bar chart
+ *   // @input bars: number(min=1, max=40, step=1) = 8 -- Bar count
+ *   // @input color: color = #4f46e5
+ *   // @input title: string = "Revenue"
+ *   // @input rounded: boolean = true
+ *   // @input style: enum(flat, outline, glass) = flat
+ *   // @input card: ref = Button          (a component, by name)
+ *
+ * The same lines work inside a block comment (` * @input …`). `-- text` is the
+ * control's label. Any value may instead be `$Collection/name`, binding the input
+ * to a variable (colours stay live bindings; other types read the variable's value).
+ */
+
+export const SCRIPT_SCHEMA_VERSION = 1
+
+export type ScriptInputType = 'number' | 'string' | 'boolean' | 'color' | 'enum' | 'ref'
+
+export interface ScriptInputSpec {
+  name: string
+  type: ScriptInputType
+  label: string
+  default: string | number | boolean
+  min?: number
+  max?: number
+  step?: number
+  options?: string[]
+}
+
+export interface ScriptHeader {
+  schema: number
+  name: string | null
+  description: string | null
+  inputs: ScriptInputSpec[]
+  warnings: string[]
+}
+
+export type ScriptInputValue = string | number | boolean
+
+const INPUT_RE = /^([A-Za-z_$][\w$]*)\s*:\s*([a-z]+)\s*(?:\(([^)]*)\))?\s*(?:=\s*(.*?))?\s*(?:--\s*(.*))?$/
+const COLOR_RE = /^#(?:[0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i
+export const VARIABLE_REF_RE = /^\$[^/\s][^/]*\/.+$/
+const TYPES = new Set<ScriptInputType>(['number', 'string', 'boolean', 'color', 'enum', 'ref'])
+const MAX_INPUTS = 64
+
+function tagLines(source: string): Array<{ tag: string; rest: string }> {
+  const out: Array<{ tag: string; rest: string }> = []
+  for (const raw of source.split(/\r?\n/)) {
+    const line = raw.trim().replace(/^(?:\/\/+|\/\*+|\*+)\s?/, '').replace(/\*\/\s*$/, '').trim()
+    const match = /^@([a-z]+)\b\s*(.*)$/i.exec(line)
+    if (match) out.push({ tag: match[1].toLowerCase(), rest: match[2].trim() })
+  }
+  return out
+}
+
+function unquote(value: string): string {
+  const v = value.trim()
+  if (v.length >= 2 && (v[0] === '"' || v[0] === "'") && v.at(-1) === v[0]) return v.slice(1, -1)
+  return v
+}
+
+function parseOptions(raw: string | undefined): Record<string, string> & { list?: string[] } {
+  const out: Record<string, string> & { list?: string[] } = {}
+  if (!raw) return out
+  const parts = raw.split(/[,|]/).map((p) => p.trim()).filter(Boolean)
+  const list: string[] = []
+  for (const part of parts) {
+    const kv = /^(min|max|step)\s*=\s*(.+)$/i.exec(part)
+    if (kv) out[kv[1].toLowerCase()] = kv[2].trim()
+    else list.push(unquote(part))
+  }
+  if (list.length) out.list = list
+  return out
+}
+
+function finite(value: string | undefined): number | undefined {
+  if (value === undefined) return undefined
+  const n = Number(value)
+  return Number.isFinite(n) ? n : undefined
+}
+
+function parseInput(rest: string, warnings: string[]): ScriptInputSpec | null {
+  const m = INPUT_RE.exec(rest)
+  if (!m) {
+    warnings.push(`Unreadable @input: ${rest}`)
+    return null
+  }
+  const [, name, rawType, rawOpts, rawDefault, rawLabel] = m
+  const type = rawType.toLowerCase() as ScriptInputType
+  if (!TYPES.has(type)) {
+    warnings.push(`@input ${name}: unknown type "${rawType}"`)
+    return null
+  }
+  const opts = parseOptions(rawOpts)
+  const spec: ScriptInputSpec = { name, type, label: rawLabel?.trim() || name, default: '' }
+  const dflt = rawDefault === undefined || rawDefault === '' ? undefined : unquote(rawDefault)
+  if (type === 'number') {
+    spec.min = finite(opts.min)
+    spec.max = finite(opts.max)
+    spec.step = finite(opts.step)
+    spec.default = dflt !== undefined && VARIABLE_REF_RE.test(dflt) ? dflt : (finite(dflt) ?? spec.min ?? 0)
+  } else if (type === 'boolean') {
+    spec.default = dflt !== undefined && VARIABLE_REF_RE.test(dflt) ? dflt : dflt === 'true'
+  } else if (type === 'color') {
+    spec.default = dflt && (COLOR_RE.test(dflt) || VARIABLE_REF_RE.test(dflt)) ? dflt : '#000000'
+  } else if (type === 'enum') {
+    spec.options = opts.list ?? []
+    if (!spec.options.length) warnings.push(`@input ${name}: enum without options`)
+    spec.default = dflt !== undefined && spec.options.includes(dflt) ? dflt : (spec.options[0] ?? '')
+  } else {
+    spec.default = dflt ?? ''
+  }
+  return spec
+}
+
+export function parseScriptHeader(source: string): ScriptHeader {
+  const header: ScriptHeader = { schema: SCRIPT_SCHEMA_VERSION, name: null, description: null, inputs: [], warnings: [] }
+  const seen = new Set<string>()
+  for (const { tag, rest } of tagLines(source)) {
+    if (tag === 'schema') {
+      const n = Number(rest)
+      if (!Number.isInteger(n) || n < 1) header.warnings.push(`Unreadable @schema: ${rest}`)
+      else if (n > SCRIPT_SCHEMA_VERSION) {
+        header.warnings.push(`@schema ${n} is newer than this editor (${SCRIPT_SCHEMA_VERSION})`)
+        header.schema = n
+      } else header.schema = n
+    } else if (tag === 'name') {
+      header.name = rest.slice(0, 120) || null
+    } else if (tag === 'description') {
+      header.description = rest.slice(0, 500) || null
+    } else if (tag === 'input') {
+      if (header.inputs.length >= MAX_INPUTS) continue
+      const spec = parseInput(rest, header.warnings)
+      if (!spec) continue
+      if (seen.has(spec.name)) {
+        header.warnings.push(`@input ${spec.name} declared twice`)
+        continue
+      }
+      seen.add(spec.name)
+      header.inputs.push(spec)
+    }
+  }
+  return header
+}
+
+function clamp(n: number, spec: ScriptInputSpec): number {
+  let v = n
+  if (spec.min !== undefined) v = Math.max(spec.min, v)
+  if (spec.max !== undefined) v = Math.min(spec.max, v)
+  return v
+}
+
+/**
+ * The inputs a run uses: every declared input, from `given` when it is valid for
+ * its type, else the default. Unknown keys are dropped. `$Collection/name` values
+ * are kept as they are (the runner resolves them).
+ */
+export function resolveScriptInputs(
+  header: ScriptHeader,
+  given: Record<string, unknown> | null | undefined
+): Record<string, ScriptInputValue> {
+  const out: Record<string, ScriptInputValue> = {}
+  for (const spec of header.inputs) {
+    const raw = given && Object.hasOwn(given, spec.name) ? given[spec.name] : undefined
+    if (typeof raw === 'string' && VARIABLE_REF_RE.test(raw) && spec.type !== 'enum' && spec.type !== 'ref') {
+      out[spec.name] = raw
+      continue
+    }
+    switch (spec.type) {
+      case 'number': {
+        const n = typeof raw === 'number' ? raw : typeof raw === 'string' ? Number(raw) : Number.NaN
+        out[spec.name] = Number.isFinite(n)
+          ? clamp(n, spec)
+          : typeof spec.default === 'number'
+            ? clamp(spec.default, spec)
+            : spec.default
+        break
+      }
+      case 'boolean':
+        out[spec.name] = typeof raw === 'boolean' ? raw : raw === 'true' ? true : raw === 'false' ? false : spec.default
+        break
+      case 'color':
+        out[spec.name] = typeof raw === 'string' && COLOR_RE.test(raw) ? raw : spec.default
+        break
+      case 'enum':
+        out[spec.name] = typeof raw === 'string' && spec.options?.includes(raw) ? raw : spec.default
+        break
+      default:
+        out[spec.name] = typeof raw === 'string' ? raw.slice(0, 10_000) : spec.default
+    }
+  }
+  return out
+}
+
+/** Deterministic 32-bit PRNG (mulberry32) — the same one the sandbox installs as Math.random. */
+export function seededRandom(seed: number): () => number {
+  let state = seed >>> 0
+  return () => {
+    state = (state + 0x6d2b79f5) | 0
+    let t = Math.imul(state ^ (state >>> 15), 1 | state)
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
+  }
+}

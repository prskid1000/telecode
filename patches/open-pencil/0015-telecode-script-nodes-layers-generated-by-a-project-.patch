+import { describe, expect, test } from 'bun:test'
+
+import {
+  parseScriptHeader,
+  resolveScriptInputs,
+  seededRandom
+} from '@/app/integrations/telecode/script-header'
+import { compileScript } from '@/app/integrations/telecode/script-sandbox'
+import { isScriptPath, STARTER_SCRIPT } from '@/app/integrations/telecode/scripts'
+
+const SOURCE = `/**
+ * @schema 1
+ * @name Bars
+ * @input count: number(min=1, max=40, step=1) = 8 -- Bar count
+ * @input color: color = #4f46e5
+ * @input title: string = "Revenue"
+ * @input rounded: boolean = true
+ * @input style: enum(flat, outline | glass) = outline
+ * @input card: ref = Button
+ * @input accent: color = $Brand/primary
+ */
+return []
+`
+
+describe('script node headers', () => {
+  test('parses every input type', () => {
+    const h = parseScriptHeader(SOURCE)
+    expect(h.schema).toBe(1)
+    expect(h.name).toBe('Bars')
+    expect(h.warnings).toEqual([])
+    const by = Object.fromEntries(h.inputs.map((i) => [i.name, i]))
+    expect(by.count).toMatchObject({ type: 'number', min: 1, max: 40, step: 1, default: 8, label: 'Bar count' })
+    expect(by.color).toMatchObject({ type: 'color', default: '#4f46e5', label: 'color' })
+    expect(by.title).toMatchObject({ type: 'string', default: 'Revenue' })
+    expect(by.rounded).toMatchObject({ type: 'boolean', default: true })
+    expect(by.style).toMatchObject({ type: 'enum', options: ['flat', 'outline', 'glass'], default: 'outline' })
+    expect(by.card).toMatchObject({ type: 'ref', default: 'Button' })
+    expect(by.accent.default).toBe('$Brand/primary')
+  })
+
+  test('line comments work too, bad lines become warnings', () => {
+    const h = parseScriptHeader('// @input n: number = 3\n// @input bad line\n// @input x: vector = 1\n// @input n: string\n')
+    expect(h.inputs.map((i) => i.name)).toEqual(['n'])
+    expect(h.warnings.length).toBe(3)
+  })
+
+  test('resolves values: clamps, coerces, falls back, keeps $variable refs', () => {
+    const h = parseScriptHeader(SOURCE)
+    const v = resolveScriptInputs(h, {
+      count: 999,
+      color: 'red',
+      rounded: 'false',
+      style: 'glass',
+      extra: 1,
+      title: '$Copy/headline'
+    })
+    expect(v.count).toBe(40)
+    expect(v.color).toBe('#4f46e5')
+    expect(v.rounded).toBe(false)
+    expect(v.style).toBe('glass')
+    expect(v.title).toBe('$Copy/headline')
+    expect('extra' in v).toBe(false)
+    expect(resolveScriptInputs(h, {}).count).toBe(8)
+  })
+
+  test('seeded random is reproducible', () => {
+    const a = seededRandom(42)
+    const b = seededRandom(42)
+    const xs = [a(), a(), a()]
+    expect([b(), b(), b()]).toEqual(xs)
+    expect(xs.every((x) => x >= 0 && x < 1)).toBe(true)
+    expect(seededRandom(43)()).not.toBe(xs[0])
+  })

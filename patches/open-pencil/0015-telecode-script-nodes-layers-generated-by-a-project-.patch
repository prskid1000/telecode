@@ -0,0 +1,224 @@
+/**
+ * Script-node sandbox (telecode / TeleDesign).
+ *
+ * Runs one script-node program the way open-pencil runs Design JSX
+ * (src/app/code/sandbox): inside a hidden `sandbox="allow-scripts"` iframe — an
+ * opaque origin with a CSP that allows nothing but inline script, eval and a blob:
+ * worker — in a dedicated Web Worker, so the code has no DOM, no network, no
+ * storage and no access to the editor. On top of that sandbox:
+ *
+ *  - synchronous only: the program is a function body; its return value (Design JSX
+ *    elements, or an array of them) is posted back once;
+ *  - `Math.random` (and `ctx.random`) is a seeded PRNG, so a run is reproducible;
+ *  - a hard wall-clock limit (default 2 s): the iframe — and with it the worker —
+ *    is destroyed when it expires, which also stops an infinite loop;
+ *  - at most `maxNodes` (default 1000) elements in the output.
+ */
+import { IS_BROWSER } from '@open-pencil/core/constants'
+import {
+  DESIGN_JSX_ELEMENTS,
+  DESIGN_JSX_HELPERS,
+  transformDesignJSXProgram
+} from '@open-pencil/core/design-jsx'
+
+import { resolveDesignJSXValidationLimits } from '@/app/code/sandbox/types'
+import { validateDesignJSXOutput } from '@/app/code/sandbox/validate'
+
+export const SCRIPT_MAX_NODES = 1000
+export const SCRIPT_TIMEOUT_MS = 2000
+export const SCRIPT_MAX_SOURCE_BYTES = 256_000
+const READY_TIMEOUT_MS = 5000
+
+export type ScriptRunResult =
+  | { ok: true; roots: unknown[]; ms: number }
+  | { ok: false; error: string; ms: number; timedOut?: boolean }
+
+export interface ScriptRunContext {
+  width: number
+  height: number
+  seed: number
+  name: string
+}
+
+const workerSource = String.raw`
+self.onmessage = ({ data }) => {
+  const { id, code, elements, helpers: helperNames, limits, input, ctx } = data
+  const blocked = () => { throw new Error('Script nodes have no network access.') }
+  self.fetch = blocked
+  self.XMLHttpRequest = undefined
+  self.WebSocket = undefined
+  self.EventSource = undefined
+  self.importScripts = blocked
+  self.indexedDB = undefined
+  self.caches = undefined
+  self.BroadcastChannel = undefined
+  self.Worker = undefined
+
+  let state = (ctx.seed >>> 0)
+  const random = () => {
+    state = (state + 0x6d2b79f5) | 0
+    let t = Math.imul(state ^ (state >>> 15), 1 | state)
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
+  }
+  Math.random = random
+
+  const normalizeChildren = (children) => children.flat(Infinity).filter((child) => child != null && child !== false)
+  const __fragment = ''
+  const __h = (type, props, ...children) => {
+    const normalizedProps = props == null ? {} : props
+    const normalizedChildren = normalizeChildren(children)
+    if (typeof type === 'function') return type({ ...normalizedProps, children: normalizedChildren })
+    if (type === __fragment) return normalizedChildren
+    return { type, props: normalizedProps, children: normalizedChildren }
+  }
+  const helper = (name) => (...args) => ({ __openPencilHelper: name, args })
+  const helperRuntime = (name) => {
+    if (name === 'defineVars') return (vars) => Object.fromEntries(Object.entries(vars).map(([key, value]) => [key, { __openPencilHelper: 'designVar', args: [value] }]))
+    return helper(name)
+  }
+  const names = Object.keys(elements)
+  const helpers = Object.fromEntries(helperNames.map((name) => [name, helperRuntime(name)]))
+  const count = (value, depth, seen) => {
+    if (depth > limits.depth) throw new Error('Script output is nested too deeply.')
+    if (Array.isArray(value)) { for (const item of value) count(item, depth + 1, seen); return }
+    if (value && typeof value === 'object') {
+      if ('type' in value && 'props' in value && 'children' in value) {
+        seen.n++
+        if (seen.n > limits.elements) throw new Error('Script output has more than ' + limits.elements + ' nodes.')
+        count(value.children, depth + 1, seen)
+      }
+    }
+  }
+  try {
+    const frozenCtx = Object.freeze({ ...ctx, random })
+    const argumentNames = ['input', 'ctx', 'h', '__h', '__fragment', ...names, ...helperNames]
+    const argumentValues = [Object.freeze(input), frozenCtx, __h, __h, __fragment, ...names.map((name) => elements[name]), ...helperNames.map((name) => helpers[name])]
+    const run = new Function(...argumentNames, '"use strict";\n' + code)
+    let value = run(...argumentValues)
+    if (value && typeof value.then === 'function') throw new Error('Script nodes run synchronously: return elements, not a Promise.')
+    if (value == null || value === false) value = []
+    if (!Array.isArray(value)) value = [value]
+    value = value.flat(Infinity).filter((item) => item != null && item !== false)
+    count(value, 0, { n: 0 })
+    self.postMessage({ id, ok: true, value: JSON.parse(JSON.stringify(value)) })
+  } catch (error) {
+    self.postMessage({ id, ok: false, error: error instanceof Error ? error.message : String(error) })
+  }
+}
+`
+
+function sandboxDocument(): string {
+  const escapedWorkerSource = JSON.stringify(workerSource)
+  return `<!doctype html><html><head><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; connect-src 'none'; img-src 'none'; media-src 'none'; font-src 'none'; style-src 'none'; object-src 'none'; frame-src 'none'; worker-src blob:; base-uri 'none'; form-action 'none'"></head><body><script>
+  const workerURL = URL.createObjectURL(new Blob([${escapedWorkerSource}], { type: 'text/javascript' }))
+  addEventListener('message', (event) => {
+    const message = event.data
+    if (!message || message.type !== 'td-script-run') return
+    const worker = new Worker(workerURL)
+    worker.onmessage = ({ data }) => {
+      parent.postMessage({ type: 'td-script-result', ...data }, '*')
+      worker.terminate()
+    }
+    worker.onerror = (e) => {
+      parent.postMessage({ type: 'td-script-result', id: message.id, ok: false, error: (e && e.message) || 'Script failed to run.' }, '*')
+      worker.terminate()
+    }
+    worker.postMessage(message.payload)
+  })
+  parent.postMessage({ type: 'td-script-ready' }, '*')
+  </script></body></html>`
+}
+
+/** Script source → a function body (JSX allowed; TypeScript syntax stripped). */
+export function compileScript(source: string): string {
+  return transformDesignJSXProgram(source)
+}
+
+export async function runScriptSandbox(
+  source: string,
+  input: Record<string, unknown>,
+  ctx: ScriptRunContext,
+  options: { timeoutMs?: number; maxNodes?: number } = {}
+): Promise<ScriptRunResult> {
+  const started = performance.now()
+  const elapsed = () => Math.round(performance.now() - started)
+  if (!IS_BROWSER) return { ok: false, error: 'Script nodes need a browser.', ms: 0 }
+  if (new TextEncoder().encode(source).byteLength > SCRIPT_MAX_SOURCE_BYTES) {
+    return { ok: false, error: 'Script source is too large (256 KB max).', ms: 0 }
+  }
+  let code: string
+  try {
+    code = compileScript(source)
+  } catch (error) {
+    return { ok: false, error: `Syntax error: ${error instanceof Error ? error.message : String(error)}`, ms: elapsed() }
+  }
+  const maxNodes = options.maxNodes ?? SCRIPT_MAX_NODES
+  const limits = resolveDesignJSXValidationLimits({ elements: maxNodes })
+  const iframe = document.createElement('iframe')
+  iframe.hidden = true
+  iframe.setAttribute('sandbox', 'allow-scripts')
+  iframe.setAttribute('aria-hidden', 'true')
+  iframe.srcdoc = sandboxDocument()
+  document.body.append(iframe)
+
+  return new Promise((resolve) => {
+    const id = crypto.randomUUID()
+    const timeoutMs = options.timeoutMs ?? SCRIPT_TIMEOUT_MS
+    let settled = false
+    let timer: ReturnType<typeof setTimeout>
+    const finish = (result: ScriptRunResult) => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      window.removeEventListener('message', onMessage)
+      // Discarding the document also terminates its worker (runaway loops included).
+      iframe.remove()
+      resolve(result)
+    }
+    const onMessage = (event: MessageEvent) => {
+      if (event.source !== iframe.contentWindow || event.origin !== 'null') return
+      const message = event.data as { type?: string; id?: string; ok?: boolean; value?: unknown; error?: string }
+      if (message.type === 'td-script-ready') {
+        clearTimeout(timer)
+        timer = setTimeout(
+          () => finish({ ok: false, error: `Script ran longer than ${timeoutMs / 1000} s and was stopped.`, ms: elapsed(), timedOut: true }),
+          timeoutMs
+        )
+        iframe.contentWindow?.postMessage(
+          {
+            type: 'td-script-run',
+            id,
+            payload: {
+              id,
+              code,
+              elements: Object.fromEntries(DESIGN_JSX_ELEMENTS.map(({ name, runtimeType }) => [name, runtimeType])),
+              helpers: DESIGN_JSX_HELPERS.map(({ name }) => name),
+              limits,
+              input,
+              ctx
+            }
+          },
+          '*'
+        )
+        return
+      }
+      if (message.type !== 'td-script-result' || message.id !== id) return
+      if (!message.ok) {
+        finish({ ok: false, error: message.error ?? 'Script failed.', ms: elapsed() })
+        return
+      }
+      try {
+        const roots = validateDesignJSXOutput(message.value, limits)
+        finish({ ok: true, roots, ms: elapsed() })
+      } catch (error) {
+        finish({ ok: false, error: error instanceof Error ? error.message : String(error), ms: elapsed() })
+      }
+    }
+    timer = setTimeout(
+      () => finish({ ok: false, error: 'Script sandbox did not start.', ms: elapsed() }),
+      READY_TIMEOUT_MS
+    )
+    window.addEventListener('message', onMessage)
+  })
+}

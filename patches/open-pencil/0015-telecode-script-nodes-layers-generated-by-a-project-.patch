@@ -0,0 +1,620 @@
+/**
+ * Script nodes: code on the canvas (telecode / TeleDesign).
+ *
+ * A script node is an ordinary FRAME carrying shared plugin data `telecode` /
+ * `script` = JSON {v, file, inputs, seed, status}. `file` is a project-relative
+ * `.js` file (TeleDesign project files, next to the canvas documents). Running the
+ * node:
+ *
+ *   1. reads the file (GET …/editor/scripts), parses its `@schema` / `@input`
+ *      header (script-header.ts) and resolves the node's input values against it;
+ *   2. runs the program in the script sandbox (script-sandbox.ts: sandboxed iframe
+ *      + Web Worker, no DOM or network, ≤ 2 s, ≤ 1000 nodes, seeded Math.random)
+ *      with `input`, `ctx` {width, height, seed, name, random} and every Design JSX
+ *      element and helper in scope;
+ *   3. replaces the frame's children with what it returned (Design JSX → layers,
+ *      open-pencil's own renderTree).
+ *
+ * A failed run leaves the previous output in place and records the error in
+ * `status`, which the TeleDesign shell draws on the node. The node re-runs when its
+ * inputs change, when it is resized, and when its file changes (polled while the
+ * document is open). "Convert to layers" drops the plugin data: the children stay
+ * as ordinary layers.
+ */
+import { convertDesignJSXRoots } from '@/app/code/sandbox/convert'
+import { renderTree } from '@open-pencil/core/design-jsx'
+import { computeAllLayouts } from '@open-pencil/core/layout'
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+import { makeFigmaFromStore } from '@/app/automation/bridge/figma-factory'
+import type { EditorStore } from '@/app/editor/session'
+import { ensureGraphFonts } from '@/app/editor/fonts'
+
+import { readTelecodeConfig } from './config'
+import {
+  parseScriptHeader,
+  resolveScriptInputs,
+  VARIABLE_REF_RE,
+  type ScriptHeader,
+  type ScriptInputValue
+} from './script-header'
+import { runScriptSandbox, SCRIPT_MAX_NODES, SCRIPT_TIMEOUT_MS } from './script-sandbox'
+
+export const SCRIPT_NAMESPACE = 'telecode'
+export const SCRIPT_FIELD = 'script'
+const ENCODED = `${SCRIPT_NAMESPACE}/${SCRIPT_FIELD}`
+const SCRIPT_PATH = /^(?!\/)(?!.*(?:^|\/)\.\.?(?:\/|$))[^\\:*?"<>|#%]{1,400}\.(?:js|jsx|mjs|ts|tsx)$/
+const POLL_MS = 2000
+
+export interface ScriptStatus {
+  ok: boolean
+  error: string | null
+  nodes: number
+  ms: number
+  at: number
+  hash: string | null
+  width: number
+  height: number
+  warnings: string[]
+}
+
+export interface ScriptBinding {
+  v: 1
+  file: string
+  inputs: Record<string, ScriptInputValue>
+  seed: number
+  status?: ScriptStatus
+}
+
+interface LoadedScript {
+  exists: boolean
+  text: string
+  hash: string | null
+  header: ScriptHeader
+}
+
+const listeners = new Set<() => void>()
+const sources = new Map<string, LoadedScript>()
+const running = new Map<string, Promise<ScriptStatus | null>>()
+const rerunQueued = new Set<string>()
+
+export function onScriptsChanged(listener: () => void): () => void {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+function emit(): void {
+  for (const listener of listeners) listener()
+}
+
+export function isScriptPath(value: unknown): value is string {
+  return typeof value === 'string' && SCRIPT_PATH.test(value) && !value.includes('\\')
+}
+
+export function newSeed(): number {
+  return crypto.getRandomValues(new Uint32Array(1))[0]
+}
+
+export function scriptBindingOf(node: SceneNode): ScriptBinding | null {
+  const entry = node.pluginData.find(
+    (e) => e.pluginId === SCRIPT_NAMESPACE && (e.key === ENCODED || e.key === SCRIPT_FIELD)
+  )
+  if (!entry?.value) return null
+  try {
+    const parsed = JSON.parse(entry.value) as Partial<ScriptBinding>
+    if (!isScriptPath(parsed.file)) return null
+    return {
+      v: 1,
+      file: parsed.file,
+      inputs: parsed.inputs && typeof parsed.inputs === 'object' ? parsed.inputs : {},
+      seed: typeof parsed.seed === 'number' ? parsed.seed >>> 0 : 1,
+      status: parsed.status
+    }
+  } catch {
+    return null
+  }
+}
+
+async function writeBinding(store: EditorStore, nodeId: string, binding: ScriptBinding | null) {
+  const pageId = store.state.currentPageId
+  await store.runMutationWithLayout(() => {
+    makeFigmaFromStore(store, pageId)
+      .getNodeById(nodeId)
+      ?.setSharedPluginData(SCRIPT_NAMESPACE, SCRIPT_FIELD, binding ? JSON.stringify(binding) : '')
+  }, pageId)
+}
+
+function pageOf(store: EditorStore, node: SceneNode | undefined): string | null {
+  let current = node
+  while (current) {
+    if (current.type === 'CANVAS') return current.id
+    current = current.parentId ? store.graph.getNode(current.parentId) : undefined
+  }
+  return null
+}
+
+// ── Script files (served by the proxy) ─────────────────────────────────
+
+function scriptsURL(paths: string[], withText: boolean): string {
+  const config = readTelecodeConfig()
+  if (!config) throw new Error('Script nodes need the TeleDesign embedding')
+  const q = new URLSearchParams()
+  for (const p of paths) q.append('path', p)
+  if (withText) q.set('text', '1')
+  return `${config.apiOrigin}/api/design/projects/${config.projectId}/editor/scripts?${q}`
+}
+
+type FileInfo = { exists: boolean; sha256: string | null; text?: string | null }
+
+async function fetchFiles(paths: string[], withText: boolean): Promise<Record<string, FileInfo>> {
+  const res = await fetch(scriptsURL(paths, withText), { cache: 'no-store' })
+  if (!res.ok) throw new Error(`Script files unavailable: HTTP ${res.status}`)
+  return ((await res.json()) as { files?: Record<string, FileInfo> }).files ?? {}
+}
+
+async function loadScript(file: string, force = false): Promise<LoadedScript> {
+  const cached = sources.get(file)
+  if (cached && !force) return cached
+  const info = (await fetchFiles([file], true))[file]
+  const text = info?.exists && typeof info.text === 'string' ? info.text : ''
+  const loaded: LoadedScript = {
+    exists: !!info?.exists,
+    text,
+    hash: info?.sha256 ?? null,
+    header: parseScriptHeader(text)
+  }
+  sources.set(file, loaded)
+  return loaded
+}
+
+/** Write a script file into the project (the editor's own "New script" and the create tool). */
+export async function writeScriptFile(file: string, source: string): Promise<void> {
+  const config = readTelecodeConfig()
+  if (!config) throw new Error('Script nodes need the TeleDesign embedding')
+  if (!isScriptPath(file)) throw new Error(`Not a script path: ${file}`)
+  const res = await fetch(
+    `${config.apiOrigin}/api/design/projects/${config.projectId}/files/${file.split('/').map(encodeURIComponent).join('/')}`,
+    { method: 'PUT', headers: { 'Content-Type': 'application/octet-stream' }, body: new TextEncoder().encode(source) }
+  )
+  if (!res.ok) throw new Error(`Could not write ${file}: HTTP ${res.status}`)
+  sources.delete(file)
+}
+
+// ── Inputs → run values ────────────────────────────────────────────────
+
+function findVariable(store: EditorStore, ref: string) {
+  const body = ref.slice(1)
+  const slash = body.indexOf('/')
+  const collectionName = body.slice(0, slash)
+  const name = body.slice(slash + 1)
+  for (const collection of store.graph.variableCollections.values()) {
+    if (collection.name !== collectionName) continue
+    for (const id of collection.variableIds) {
+      const variable = store.graph.variables.get(id)
+      if (variable?.name === name) return variable
+    }
+  }
+  return undefined
+}
+
+function findComponent(store: EditorStore, name: string): SceneNode | undefined {
+  if (!name) return undefined
+  const byId = store.graph.getNode(name)
+  if (byId && (byId.type === 'COMPONENT' || byId.type === 'COMPONENT_SET')) return byId
+  for (const node of store.graph.getAllNodes()) {
+    if ((node.type === 'COMPONENT' || node.type === 'COMPONENT_SET') && node.name === name) return node
+  }
+  return undefined
+}
+
+export function listComponents(store: EditorStore): Array<{ id: string; name: string; type: string }> {
+  const out: Array<{ id: string; name: string; type: string }> = []
+  for (const node of store.graph.getAllNodes()) {
+    if (node.type === 'COMPONENT_SET' || (node.type === 'COMPONENT' && store.graph.getNode(node.parentId ?? '')?.type !== 'COMPONENT_SET')) {
+      out.push({ id: node.id, name: node.name, type: node.type })
+    }
+  }
+  return out.sort((a, b) => a.name.localeCompare(b.name)).slice(0, 500)
+}
+
+function runValues(
+  store: EditorStore,
+  node: SceneNode,
+  header: ScriptHeader,
+  values: Record<string, ScriptInputValue>,
+  problems: string[]
+): Record<string, unknown> {
+  const out: Record<string, unknown> = {}
+  for (const spec of header.inputs) {
+    const value = values[spec.name]
+    if (spec.type === 'ref') {
+      const component = typeof value === 'string' ? findComponent(store, value) : undefined
+      if (value && !component) problems.push(`@input ${spec.name}: no component named "${value}"`)
+      out[spec.name] = component?.id ?? null
+      continue
+    }
+    if (typeof value === 'string' && VARIABLE_REF_RE.test(value)) {
+      const variable = findVariable(store, value)
+      if (!variable) {
+        problems.push(`@input ${spec.name}: no variable ${value}`)
+        out[spec.name] = spec.default
+        continue
+      }
+      if (spec.type === 'color') {
+        // Stays a live binding in the output.
+        out[spec.name] = { __openPencilHelper: 'designVar', args: [variable.id] }
+        continue
+      }
+      const modeId = store.graph.getNodeVariableModeId(node.id, variable.collectionId)
+      const resolved = store.graph.resolveVariable(variable.id, modeId)
+      out[spec.name] = typeof resolved === 'object' ? spec.default : resolved
+      continue
+    }
+    out[spec.name] = value
+  }
+  return out
+}
+
+// ── Running ────────────────────────────────────────────────────────────
+
+async function replaceChildren(store: EditorStore, nodeId: string, roots: unknown[]): Promise<number> {
+  const trees = convertDesignJSXRoots(roots)
+  const graph = store.graph
+  for (const childId of [...(graph.getNode(nodeId)?.childIds ?? [])]) graph.deleteNode(childId)
+  const created: string[] = []
+  for (const tree of trees) {
+    const result = await renderTree(graph, tree, { parentId: nodeId })
+    created.push(result.id)
+  }
+  const pageId = pageOf(store, graph.getNode(nodeId)) ?? store.state.currentPageId
+  computeAllLayouts(graph, pageId)
+  if (created.length) await ensureGraphFonts(graph, created, store.renderer)
+  let count = 0
+  const walk = (id: string) => {
+    count++
+    for (const child of graph.getNode(id)?.childIds ?? []) walk(child)
+  }
+  for (const id of created) walk(id)
+  return count
+}
+
+async function runOnce(store: EditorStore, nodeId: string, forceReload: boolean): Promise<ScriptStatus | null> {
+  const node = store.graph.getNode(nodeId)
+  const binding = node ? scriptBindingOf(node) : null
+  if (!node || !binding) return null
+  const problems: string[] = []
+  let status: ScriptStatus
+  try {
+    const script = await loadScript(binding.file, forceReload)
+    if (!script.exists) throw new Error(`Script file not found: ${binding.file}`)
+    const inputs = resolveScriptInputs(script.header, binding.inputs)
+    const values = runValues(store, node, script.header, inputs, problems)
+    const result = await runScriptSandbox(script.text, values, {
+      width: node.width,
+      height: node.height,
+      seed: binding.seed,
+      name: node.name
+    })
+    if (!result.ok) {
+      status = {
+        ...(binding.status ?? { nodes: 0 }),
+        ok: false,
+        error: result.error,
+        ms: result.ms,
+        at: Date.now(),
+        hash: script.hash,
+        width: node.width,
+        height: node.height,
+        warnings: [...script.header.warnings, ...problems]
+      } as ScriptStatus
+    } else {
+      const nodes = await replaceChildren(store, nodeId, result.roots)
+      status = {
+        ok: true,
+        error: null,
+        nodes,
+        ms: result.ms,
+        at: Date.now(),
+        hash: script.hash,
+        width: node.width,
+        height: node.height,
+        warnings: [...script.header.warnings, ...problems]
+      }
+    }
+    binding.inputs = inputs
+  } catch (error) {
+    status = {
+      ok: false,
+      error: error instanceof Error ? error.message : String(error),
+      nodes: binding.status?.nodes ?? 0,
+      ms: 0,
+      at: Date.now(),
+      hash: sources.get(binding.file)?.hash ?? null,
+      width: node.width,
+      height: node.height,
+      warnings: problems
+    }
+  }
+  // The node may have been deleted or converted while the sandbox ran.
+  const current = store.graph.getNode(nodeId)
+  if (current && scriptBindingOf(current)) {
+    await writeBinding(store, nodeId, { ...binding, status })
+  }
+  store.requestRender()
+  emit()
+  return status
+}
+
+/** Run a script node now (one run at a time per node; a request during a run queues one more). */
+export async function runScriptNode(
+  store: EditorStore,
+  nodeId: string,
+  opts: { reload?: boolean } = {}
+): Promise<ScriptStatus | null> {
+  const inFlight = running.get(nodeId)
+  if (inFlight) {
+    rerunQueued.add(nodeId)
+    await inFlight
+    return running.get(nodeId) ?? inFlight
+  }
+  const job = (async () => {
+    let status = await runOnce(store, nodeId, opts.reload ?? false)
+    while (rerunQueued.delete(nodeId)) status = await runOnce(store, nodeId, false)
+    return status
+  })()
+  running.set(nodeId, job)
+  try {
+    return await job
+  } finally {
+    running.delete(nodeId)
+  }
+}
+
+// ── Tool-facing operations ─────────────────────────────────────────────
+
+export const STARTER_SCRIPT = `// @schema 1
+// @name Bars
+// @input count: number(min=1, max=40, step=1) = 8 -- Bars
+// @input color: color = #4f46e5 -- Colour
+// @input gap: number(min=0, max=40) = 8 -- Gap
+// @input rounded: boolean = true -- Rounded
+//
+// A script node: return Design JSX elements (or an array of them). They become
+// the node's layers. \`input\` holds the values above, \`ctx\` is
+// {width, height, seed, name, random}; Math.random is seeded (see "Reseed").
+const w = (ctx.width - input.gap * (input.count - 1)) / input.count
+return Array.from({ length: input.count }, (_, i) => {
+  const h = Math.max(4, Math.round(ctx.height * (0.2 + 0.8 * Math.random())))
+  return <Rectangle x={i * (w + input.gap)} y={ctx.height - h} w={w} h={h} bg={input.color} rounded={input.rounded ? Math.min(8, w / 2) : 0} />
+})
+`
+
+export interface CreateScriptOptions {
+  file: string
+  source?: string
+  name?: string
+  x?: number
+  y?: number
+  width?: number
+  height?: number
+  parentId?: string
+  inputs?: Record<string, unknown>
+  seed?: number
+}
+
+export async function createScriptNode(store: EditorStore, opts: CreateScriptOptions) {
+  if (!isScriptPath(opts.file)) throw new Error('"file" must be a project-relative .js path (e.g. scripts/chart.js)')
+  if (typeof opts.source === 'string') await writeScriptFile(opts.file, opts.source)
+  let script = await loadScript(opts.file, true)
+  if (!script.exists && typeof opts.source !== 'string') {
+    // A new node on a file that does not exist yet starts from the starter program.
+    await writeScriptFile(opts.file, STARTER_SCRIPT)
+    script = await loadScript(opts.file, true)
+  }
+  if (!script.exists) throw new Error(`Script file not found: ${opts.file}`)
+  const pageId = store.state.currentPageId
+  const parentId = opts.parentId && store.graph.getNode(opts.parentId) ? opts.parentId : pageId
+  const width = Math.max(1, opts.width ?? 400)
+  const height = Math.max(1, opts.height ?? 300)
+  let x = opts.x
+  let y = opts.y
+  if (x === undefined || y === undefined) {
+    let right = Number.NEGATIVE_INFINITY
+    let top = 0
+    for (const child of store.graph.getChildren(parentId)) {
+      if (child.x + child.width > right) {
+        right = child.x + child.width
+        top = child.y
+      }
+    }
+    x ??= Number.isFinite(right) ? Math.round(right + 100) : 0
+    y ??= Number.isFinite(right) ? Math.round(top) : 0
+  }
+  const before = store.snapshotPage()
+  const node = await store.runMutationWithLayout(
+    () =>
+      store.graph.createNode('FRAME', parentId, {
+        name: (opts.name || script.header.name || opts.file.split('/').pop() || 'Script').slice(0, 120),
+        x,
+        y,
+        width,
+        height,
+        clipsContent: true,
+        fills: []
+      }),
+    pageId
+  )
+  const binding: ScriptBinding = {
+    v: 1,
+    file: opts.file,
+    inputs: resolveScriptInputs(script.header, opts.inputs ?? {}),
+    seed: typeof opts.seed === 'number' ? opts.seed >>> 0 : newSeed()
+  }
+  await writeBinding(store, node.id, binding)
+  const status = await runScriptNode(store, node.id)
+  const after = store.snapshotPage()
+  store.pushUndoEntry({
+    label: 'Add script node',
+    forward: () => store.restorePageFromSnapshot(after),
+    inverse: () => store.restorePageFromSnapshot(before)
+  })
+  store.select([node.id])
+  return { id: node.id, name: node.name, file: opts.file, status, schema: script.header }
+}
+
+export async function updateScriptNode(
+  store: EditorStore,
+  nodeId: string,
+  patch: { inputs?: Record<string, unknown>; file?: string; seed?: number | 'new' }
+) {
+  const node = store.graph.getNode(nodeId)
+  const binding = node ? scriptBindingOf(node) : null
+  if (!node || !binding) throw new Error(`Not a script node: ${nodeId}`)
+  const next: ScriptBinding = { ...binding }
+  if (patch.file !== undefined) {
+    if (!isScriptPath(patch.file)) throw new Error('"file" must be a project-relative .js path')
+    next.file = patch.file
+  }
+  if (patch.inputs && typeof patch.inputs === 'object') next.inputs = { ...binding.inputs, ...(patch.inputs as ScriptBinding['inputs']) }
+  if (patch.seed === 'new') next.seed = newSeed()
+  else if (typeof patch.seed === 'number') next.seed = patch.seed >>> 0
+  await writeBinding(store, nodeId, next)
+  const status = await runScriptNode(store, nodeId, { reload: patch.file !== undefined })
+  return describeScript(store, nodeId, status)
+}
+
+export async function convertScriptNode(store: EditorStore, nodeId: string) {
+  const node = store.graph.getNode(nodeId)
+  if (!node || !scriptBindingOf(node)) throw new Error(`Not a script node: ${nodeId}`)
+  const before = store.snapshotPage()
+  await writeBinding(store, nodeId, null)
+  const after = store.snapshotPage()
+  store.pushUndoEntry({
+    label: 'Convert script to layers',
+    forward: () => store.restorePageFromSnapshot(after),
+    inverse: () => store.restorePageFromSnapshot(before)
+  })
+  store.requestRender()
+  emit()
+  return { id: nodeId, name: node.name, children: node.childIds.length }
+}
+
+export function describeScript(store: EditorStore, nodeId: string, status?: ScriptStatus | null) {
+  const node = store.graph.getNode(nodeId)
+  const binding = node ? scriptBindingOf(node) : null
+  if (!node || !binding) return null
+  const abs = store.graph.getAbsolutePosition(node.id)
+  const header = sources.get(binding.file)?.header ?? null
+  return {
+    node_id: node.id,
+    name: node.name,
+    file: binding.file,
+    inputs: binding.inputs,
+    seed: binding.seed,
+    status: status ?? binding.status ?? null,
+    schema: header ? { name: header.name, description: header.description, inputs: header.inputs } : null,
+    page_id: pageOf(store, node),
+    x: abs.x,
+    y: abs.y,
+    width: node.width,
+    height: node.height
+  }
+}
+
+export function listScripts(store: EditorStore, pageId?: string) {
+  const out = []
+  for (const node of store.graph.getAllNodes()) {
+    if (!scriptBindingOf(node)) continue
+    const info = describeScript(store, node.id)
+    if (info && (!pageId || info.page_id === pageId)) out.push(info)
+  }
+  return out
+}
+
+export async function runAllScripts(store: EditorStore, opts: { reload?: boolean } = {}) {
+  const results = []
+  for (const info of listScripts(store)) {
+    results.push({ node_id: info.node_id, status: await runScriptNode(store, info.node_id, opts) })
+  }
+  return results
+}
+
+/** Make sure every script node's schema is loaded (for the host's property controls). */
+export async function primeScriptSchemas(store: EditorStore): Promise<void> {
+  const files = new Set(listScripts(store).map((s) => s.file))
+  let loaded = false
+  for (const file of files) {
+    if (sources.has(file)) continue
+    try {
+      await loadScript(file)
+      loaded = true
+    } catch (error) {
+      console.warn('[TeleDesign] script not loaded:', file, error)
+    }
+  }
+  if (loaded) emit()
+}
+
+// ── Watching: file changes and resizes ─────────────────────────────────
+
+export function watchScripts(getStore: () => EditorStore | null): () => void {
+  let stopped = false
+  let timer = 0
+  const poll = async () => {
+    if (stopped) return
+    const store = getStore()
+    try {
+      if (store && readTelecodeConfig()) {
+        const scripts = listScripts(store)
+        const files = [...new Set(scripts.map((s) => s.file))]
+        if (files.length) {
+          const infos = await fetchFiles(files, false)
+          for (const file of files) {
+            const info = infos[file]
+            const known = sources.get(file)
+            const sha = info?.exists ? info.sha256 : null
+            const changedSinceLoad = known !== undefined && known.hash !== sha
+            if (changedSinceLoad) sources.delete(file)
+            for (const s of scripts) {
+              if (s.file !== file) continue
+              // Re-run when the file changed while open, or differs from what the
+              // stored output was made from (edited while the document was closed).
+              const stale = (s.status?.hash ?? null) !== sha
+              if (changedSinceLoad || (known === undefined && stale)) {
+                void runScriptNode(store, s.node_id, { reload: true })
+              }
+            }
+            if (known === undefined && !changedSinceLoad) {
+              try {
+                await loadScript(file)
+                emit()
+              } catch {
+                // reported by the next run
+              }
+            }
+          }
+        }
+      }
+    } catch (error) {
+      console.warn('[TeleDesign] script watch failed:', error)
+    } finally {
+      if (!stopped) timer = window.setTimeout(() => void poll(), POLL_MS)
+    }
+  }
+  timer = window.setTimeout(() => void poll(), 300)
+  return () => {
+    stopped = true
+    window.clearTimeout(timer)
+  }
+}
+
+/** Re-run a script node whose frame size no longer matches its last run. */
+export function rerunIfResized(store: EditorStore, nodeId: string): void {
+  const node = store.graph.getNode(nodeId)
+  const binding = node ? scriptBindingOf(node) : null
+  if (!node || !binding?.status || running.has(nodeId)) return
+  if (Math.abs(binding.status.width - node.width) < 0.5 && Math.abs(binding.status.height - node.height) < 0.5) return
+  void runScriptNode(store, nodeId)
+}
+
+export const SCRIPT_LIMITS = { maxNodes: SCRIPT_MAX_NODES, timeoutMs: SCRIPT_TIMEOUT_MS }

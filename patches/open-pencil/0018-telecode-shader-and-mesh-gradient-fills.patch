diff --git a/src/app/integrations/telecode/fills.ts b/src/app/integrations/telecode/fills.ts
new file mode 100644
index 00000000..bda37d04
--- /dev/null
+++ b/src/app/integrations/telecode/fills.ts
@@ -0,0 +1,185 @@
+/**
+ * Shader and mesh-gradient fills (telecode / TeleDesign).
+ *
+ * The renderer side lives in @open-pencil/core (canvas/gradients/procedural): a
+ * procedural fill is a CUSTOM paint whose customEffectId links to a JSON
+ * definition in the node's shared plugin data (`telecode` / `fill:<id>`), and
+ * whose own colour is the fallback wherever the definition is not understood
+ * (other .fig readers, the HTML export). This module is the editing surface:
+ * validate (shaders are compiled first, so an agent gets the SkSL error back),
+ * write the paint and its definition together, list and remove them.
+ */
+import type { CanvasKit } from 'canvaskit-wasm'
+
+import {
+  compileShaderFill,
+  listShaderPresets,
+  normalizeProceduralFill,
+  parseProceduralColor,
+  proceduralFillOf,
+  PROCEDURAL_KEY_PREFIX,
+  PROCEDURAL_NAMESPACE,
+  SHADER_PRESETS,
+  shaderSource,
+  type ProceduralFillDef
+} from '@open-pencil/core/canvas'
+import type { Fill, SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+export { listShaderPresets }
+
+const ENCODED_PREFIX = `${PROCEDURAL_NAMESPACE}/${PROCEDURAL_KEY_PREFIX}`
+
+type PluginEntry = SceneNode['pluginData'][number]
+
+function newEffectId(graph: SceneGraph): string {
+  const used = new Set<string>()
+  for (const node of graph.getAllNodes()) {
+    for (const fill of node.fills) if (fill.customEffectId) used.add(fill.customEffectId)
+  }
+  for (;;) {
+    const words = crypto.getRandomValues(new Uint32Array(2))
+    const id = `${9000 + (words[0] % 1000000)}:${1 + (words[1] % 1000000)}`
+    if (!used.has(id)) return id
+  }
+}
+
+/** `colors` (rows of colours) is shorthand for an evenly spaced mesh. */
+function expandShorthand(input: Record<string, unknown>): Record<string, unknown> {
+  if (input.kind !== 'mesh' || input.points || !Array.isArray(input.colors)) return input
+  const rows = input.colors as unknown[]
+  if (!rows.every((row) => Array.isArray(row))) throw new Error('"colors" must be rows of colours')
+  const grid = rows as unknown[][]
+  const columns = grid[0]?.length ?? 0
+  if (!grid.every((row) => row.length === columns)) {
+    throw new Error('Every "colors" row needs the same length')
+  }
+  return { ...input, columns, rows: grid.length, points: grid.flat().map((color) => ({ color })) }
+}
+
+function fallbackColor(def: ProceduralFillDef): Fill['color'] {
+  const colors: number[][] = []
+  if (def.kind === 'mesh') colors.push(...def.points.map((p) => p.color))
+  else {
+    const uniforms = { ...(def.preset ? SHADER_PRESETS[def.preset]?.uniforms : {}), ...def.uniforms }
+    for (const value of Object.values(uniforms)) {
+      if (Array.isArray(value) && value.length === 4) colors.push(value)
+    }
+  }
+  if (!colors.length) return { r: 0.5, g: 0.5, b: 0.5, a: 1 }
+  const avg = (i: number) => colors.reduce((sum, c) => sum + c[i], 0) / colors.length
+  return { r: avg(0), g: avg(1), b: avg(2), a: 1 }
+}
+
+/** Plugin data with `defs` written and definitions no fill links to any more dropped. */
+function withDefinitions(node: SceneNode, fills: Fill[], defs: Map<string, string>): PluginEntry[] {
+  const live = new Set(fills.filter((f) => f.type === 'CUSTOM').map((f) => f.customEffectId))
+  const kept = node.pluginData.filter((e) => {
+    if (e.pluginId !== PROCEDURAL_NAMESPACE || !e.key.startsWith(ENCODED_PREFIX)) return true
+    const id = e.key.slice(ENCODED_PREFIX.length)
+    return live.has(id) && !defs.has(id)
+  })
+  for (const [id, value] of defs) {
+    kept.push({ pluginId: PROCEDURAL_NAMESPACE, key: `${ENCODED_PREFIX}${id}`, value })
+  }
+  return kept
+}
+
+export interface SetFillOptions {
+  /** Replace the fill at this index (default: add on top). */
+  index?: number
+  /** Fallback colour other renderers show. */
+  fallback?: unknown
+}
+
+/**
+ * Add or replace a shader / mesh fill. `ck` (the editor's CanvasKit) compiles a
+ * shader first, so a broken one is refused with the compiler's message.
+ */
+export function setProceduralFill(
+  graph: SceneGraph,
+  nodeId: string,
+  input: Record<string, unknown>,
+  opts: SetFillOptions = {},
+  ck?: CanvasKit | null
+) {
+  const node = graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  if (node.type === 'CANVAS' || node.type === 'GROUP') throw new Error(`A ${node.type} has no fills`)
+  const def = normalizeProceduralFill(expandShorthand(input))
+  if (def.kind === 'shader' && ck) {
+    const program = compileShaderFill(ck, shaderSource(def))
+    if (program.error) throw new Error(`Shader does not compile: ${program.error}`)
+  }
+  const fills = node.fills.map((f) => ({ ...f }))
+  const index = opts.index
+  const replacing =
+    index !== undefined && index >= 0 && index < fills.length ? fills[index] : undefined
+  const id =
+    replacing?.type === 'CUSTOM' && replacing.customEffectId
+      ? replacing.customEffectId
+      : newEffectId(graph)
+  const fallback = opts.fallback !== undefined ? parseProceduralColor(opts.fallback) : null
+  const fill: Fill = {
+    type: 'CUSTOM',
+    color: fallback
+      ? { r: fallback[0], g: fallback[1], b: fallback[2], a: fallback[3] }
+      : fallbackColor(def),
+    opacity: replacing?.opacity ?? 1,
+    visible: true,
+    blendMode: replacing?.blendMode ?? 'NORMAL',
+    customEffectId: id
+  }
+  if (replacing) fills[index as number] = fill
+  else fills.push(fill)
+  const pluginData = withDefinitions(node, fills, new Map([[id, JSON.stringify(def)]]))
+  graph.updateNode(nodeId, { fills, pluginData })
+  return describeFills(graph, nodeId, ck)
+}
+
+export function removeFill(graph: SceneGraph, nodeId: string, index: number) {
+  const node = graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  if (!(index >= 0 && index < node.fills.length)) {
+    throw new Error(`No fill ${index} (the node has ${node.fills.length})`)
+  }
+  const fills = node.fills.filter((_, i) => i !== index).map((f) => ({ ...f }))
+  graph.updateNode(nodeId, { fills, pluginData: withDefinitions(node, fills, new Map()) })
+  return describeFills(graph, nodeId)
+}
+
+/** Every fill of a node; procedural ones with their definition (and compile error, if any). */
+export function describeFills(graph: SceneGraph, nodeId: string, ck?: CanvasKit | null) {
+  const node = graph.getNode(nodeId)
+  if (!node) throw new Error(`Node not found: ${nodeId}`)
+  return {
+    node_id: node.id,
+    name: node.name,
+    fills: node.fills.map((fill, index) => {
+      const def = proceduralFillOf(node, fill)
+      const base = { index, type: fill.type, visible: fill.visible, opacity: fill.opacity }
+      if (!def) return fill.type === 'CUSTOM' ? { ...base, kind: 'unknown-custom' } : base
+      const error =
+        def.kind === 'shader' && ck ? compileShaderFill(ck, shaderSource(def)).error : null
+      return { ...base, kind: def.kind, id: fill.customEffectId, definition: def, error }
+    })
+  }
+}
+
+/** Nodes carrying a procedural fill (for the shell's list and error badges). */
+export function listProceduralFills(graph: SceneGraph, ck?: CanvasKit | null) {
+  const out: Array<{ node_id: string; name: string; kinds: string[]; errors: string[] }> = []
+  for (const node of graph.getAllNodes()) {
+    const kinds: string[] = []
+    const errors: string[] = []
+    for (const fill of node.fills) {
+      const def = proceduralFillOf(node, fill)
+      if (!def) continue
+      kinds.push(def.kind === 'shader' ? `shader${def.preset ? `:${def.preset}` : ''}` : 'mesh')
+      const error =
+        def.kind === 'shader' && ck ? compileShaderFill(ck, shaderSource(def)).error : null
+      if (error) errors.push(error)
+    }
+    if (kinds.length) out.push({ node_id: node.id, name: node.name, kinds, errors })
+  }
+  return out
+}

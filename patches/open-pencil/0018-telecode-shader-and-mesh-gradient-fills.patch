+/**
+ * Procedural fills: SkSL shader fills and mesh gradients.
+ *
+ * Neither exists in the .fig paint model, so a procedural fill is stored as a
+ * `CUSTOM` paint (whose own colour is the fallback every other renderer shows)
+ * linked by `customEffectId` to a definition in the node's shared plugin data,
+ * `telecode` / `fill:<customEffectId>` (JSON). Both round-trip through .fig.
+ *
+ *  - shader: `{kind:'shader', sksl | preset, uniforms}` — a Skia runtime effect,
+ *    `half4 main(float2 p)` with `p` in the node's pixel space. `uniform float2
+ *    u_size` (the node size) is supplied; other uniforms come from `uniforms`
+ *    by name (float / float2..4, missing = 0).
+ *  - mesh: `{kind:'mesh', columns, rows, points:[{x, y, color}]}` — a grid of
+ *    control points (row-major, x/y normalised to the node box, so the grid can
+ *    be warped), drawn as one Coons patch per cell (Catmull-Rom edges unless
+ *    `smooth:false`), colours interpolated across each patch.
+ */
+import type { CanvasKit, RuntimeEffect, Shader } from 'canvaskit-wasm'
+
+import type { Fill, SceneNode } from '@open-pencil/scene-graph'
+
+import type { SkiaRenderer } from '#core/canvas/renderer'
+
+export const PROCEDURAL_NAMESPACE = 'telecode'
+export const PROCEDURAL_KEY_PREFIX = 'fill:'
+
+export type ProceduralColor = [number, number, number, number]
+
+export interface ShaderFillDef {
+  v: 1
+  kind: 'shader'
+  sksl?: string
+  preset?: string
+  uniforms?: Record<string, number | number[]>
+}
+
+export interface MeshPoint {
+  x: number
+  y: number
+  color: ProceduralColor
+}
+
+export interface MeshFillDef {
+  v: 1
+  kind: 'mesh'
+  columns: number
+  rows: number
+  points: MeshPoint[]
+  smooth?: boolean
+}
+
+export type ProceduralFillDef = ShaderFillDef | MeshFillDef
+
+export const MESH_MAX_POINTS = 64
+
+// ── Presets (original shaders) ───────────────────────────────────────────
+
+interface Preset {
+  description: string
+  uniforms: Record<string, number | number[]>
+  sksl: string
+}
+
+const HASH = `
+float hash(float2 p) { return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453); }
+float vnoise(float2 p) {
+  float2 i = floor(p);
+  float2 f = fract(p);
+  float2 u = f * f * (3.0 - 2.0 * f);
+  return mix(mix(hash(i), hash(i + float2(1, 0)), u.x), mix(hash(i + float2(0, 1)), hash(i + float2(1, 1)), u.x), u.y);
+}
+`
+
+export const SHADER_PRESETS: Record<string, Preset> = {
+  grain: {
+    description: 'Film grain over a base colour (u_color, u_amount 0..1, u_seed)',
+    uniforms: { u_color: [0.95, 0.94, 0.9, 1], u_amount: 0.12, u_seed: 0 },
+    sksl: `
+uniform float2 u_size;
+uniform float4 u_color;
+uniform float u_amount;
+uniform float u_seed;
+${HASH}
+half4 main(float2 p) {
+  float n = hash(p + u_seed * 17.0) - 0.5;
+  float3 c = clamp(u_color.rgb + n * u_amount, 0.0, 1.0);
+  return half4(half3(c * u_color.a), half(u_color.a));
+}`
+  },
+  aurora: {
+    description: 'Soft flowing colour field of three colours (u_a, u_b, u_c, u_scale, u_seed)',
+    uniforms: { u_a: [0.1, 0.1, 0.35, 1], u_b: [0.2, 0.8, 0.7, 1], u_c: [0.8, 0.3, 0.9, 1], u_scale: 2.5, u_seed: 0 },
+    sksl: `
+uniform float2 u_size;
+uniform float4 u_a;
+uniform float4 u_b;
+uniform float4 u_c;
+uniform float u_scale;
+uniform float u_seed;
+${HASH}
+half4 main(float2 p) {
+  float2 q = p / max(u_size.x, u_size.y) * u_scale + u_seed;
+  float n1 = vnoise(q + vnoise(q * 1.7 + 3.1));
+  float n2 = vnoise(q * 0.8 - 5.2 + n1);
+  float4 c = mix(mix(u_a, u_b, smoothstep(0.2, 0.8, n1)), u_c, smoothstep(0.35, 0.9, n2) * 0.8);
+  return half4(half3(c.rgb * c.a), half(c.a));
+}`
+  },
+  stripes: {
+    description: 'Straight stripes (u_a, u_b, u_width px, u_angle degrees)',
+    uniforms: { u_a: [0.1, 0.1, 0.1, 1], u_b: [0.95, 0.8, 0.2, 1], u_width: 16, u_angle: 45 },
+    sksl: `
+uniform float2 u_size;
+uniform float4 u_a;
+uniform float4 u_b;
+uniform float u_width;
+uniform float u_angle;
+half4 main(float2 p) {
+  float r = radians(u_angle);
+  float d = dot(p, float2(cos(r), sin(r)));
+  float t = step(0.5, fract(d / max(u_width * 2.0, 1.0)));
+  float4 c = mix(u_a, u_b, t);
+  return half4(half3(c.rgb * c.a), half(c.a));
+}`
+  },
+  dots: {
+    description: 'Dot grid (u_background, u_dot, u_spacing px, u_radius px)',
+    uniforms: { u_background: [1, 1, 1, 1], u_dot: [0.2, 0.2, 0.25, 1], u_spacing: 16, u_radius: 2 },
+    sksl: `
+uniform float2 u_size;
+uniform float4 u_background;
+uniform float4 u_dot;
+uniform float u_spacing;
+uniform float u_radius;
+half4 main(float2 p) {
+  float s = max(u_spacing, 1.0);
+  float2 cell = (fract(p / s) - 0.5) * s;
+  float t = 1.0 - smoothstep(u_radius - 0.75, u_radius + 0.75, length(cell));
+  float4 c = mix(u_background, u_dot, t);
+  return half4(half3(c.rgb * c.a), half(c.a));
+}`
+  },
+  radial_glow: {
+    description: 'Glow from a point (u_inner, u_outer, u_center 0..1, u_radius 0..1 of the larger side)',
+    uniforms: { u_inner: [1, 0.85, 0.5, 1], u_outer: [0.05, 0.05, 0.12, 1], u_center: [0.5, 0.4], u_radius: 0.7 },
+    sksl: `
+uniform float2 u_size;
+uniform float4 u_inner;
+uniform float4 u_outer;
+uniform float2 u_center;
+uniform float u_radius;
+half4 main(float2 p) {
+  float d = length(p - u_center * u_size) / max(max(u_size.x, u_size.y) * u_radius, 1.0);
+  float4 c = mix(u_inner, u_outer, smoothstep(0.0, 1.0, d));
+  return half4(half3(c.rgb * c.a), half(c.a));
+}`
+  }
+}
+
+export function listShaderPresets() {
+  return Object.entries(SHADER_PRESETS).map(([name, preset]) => ({
+    name,
+    description: preset.description,
+    uniforms: preset.uniforms
+  }))
+}
+
+// ── Parsing ──────────────────────────────────────────────────────────────
+
+const parsed = new Map<string, ProceduralFillDef | null>()
+
+function finite(value: unknown, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) ? value : fallback
+}
+
+function clamp01(value: number): number {
+  return Math.min(1, Math.max(0, value))
+}
+
+/** A colour as [r, g, b, a] floats, #rgb / #rrggbb / #rrggbbaa, or {r, g, b, a}. */
+export function parseProceduralColor(value: unknown): ProceduralColor | null {
+  if (Array.isArray(value) && value.length >= 3) {
+    return [0, 1, 2, 3].map((i) => clamp01(finite(value[i], i === 3 ? 1 : 0))) as ProceduralColor
+  }
+  if (typeof value === 'string') {
+    const hex = value.trim().replace(/^#/, '')
+    const full =
+      hex.length === 3 || hex.length === 4 ? [...hex].map((c) => c + c).join('') : hex
+    if (!/^[0-9a-f]{6}([0-9a-f]{2})?$/i.test(full)) return null
+    const n = (i: number) => Number.parseInt(full.slice(i, i + 2), 16) / 255
+    return [n(0), n(2), n(4), full.length === 8 ? n(6) : 1]
+  }
+  if (value && typeof value === 'object') {
+    const c = value as Record<string, unknown>
+    if (typeof c.r === 'number') {
+      return [clamp01(finite(c.r, 0)), clamp01(finite(c.g, 0)), clamp01(finite(c.b, 0)), clamp01(finite(c.a, 1))]
+    }
+  }
+  return null
+}
+
+/** Validate and normalise a definition; throws with a readable message. */
+export function normalizeProceduralFill(input: unknown): ProceduralFillDef {
+  if (!input || typeof input !== 'object') throw new Error('A fill definition must be an object')
+  const raw = input as Record<string, unknown>
+  if (raw.kind === 'shader') {
+    const preset = typeof raw.preset === 'string' && raw.preset ? raw.preset : undefined
+    const sksl = typeof raw.sksl === 'string' && raw.sksl.trim() ? raw.sksl : undefined
+    if (!preset && !sksl) throw new Error('A shader fill needs "sksl" or "preset"')
+    if (preset && !SHADER_PRESETS[preset]) {
+      throw new Error(`Unknown shader preset "${preset}" (${Object.keys(SHADER_PRESETS).join(', ')})`)
+    }
+    if (sksl && sksl.length > 20000) throw new Error('"sksl" is limited to 20000 characters')
+    const uniforms: Record<string, number | number[]> = {}
+    if (raw.uniforms && typeof raw.uniforms === 'object') {
+      for (const [name, value] of Object.entries(raw.uniforms as Record<string, unknown>)) {
+        if (!/^[A-Za-z_]\w{0,63}$/.test(name)) throw new Error(`Bad uniform name "${name}"`)
+        if (typeof value === 'number' && Number.isFinite(value)) uniforms[name] = value
+        else if (Array.isArray(value) && value.length <= 16 && value.every((x) => typeof x === 'number' && Number.isFinite(x)))
+          uniforms[name] = value as number[]
+        else {
+          const color = parseProceduralColor(value)
+          if (!color) throw new Error(`Uniform "${name}" must be a number, a number array or a colour`)
+          uniforms[name] = color
+        }
+      }
+    }
+    return { v: 1, kind: 'shader', ...(sksl ? { sksl } : { preset }), uniforms }
+  }
+  if (raw.kind === 'mesh') {
+    const columns = Math.round(finite(raw.columns, 0))
+    const rows = Math.round(finite(raw.rows, 0))
+    if (columns < 2 || rows < 2) throw new Error('A mesh needs at least 2 columns and 2 rows')
+    if (columns * rows > MESH_MAX_POINTS) throw new Error(`A mesh has at most ${MESH_MAX_POINTS} points`)
+    const pointsIn = Array.isArray(raw.points) ? raw.points : []
+    if (pointsIn.length !== columns * rows) {
+      throw new Error(`A ${columns}x${rows} mesh needs ${columns * rows} points (got ${pointsIn.length})`)
+    }
+    const points = pointsIn.map((p, index) => {
+      const point = (p ?? {}) as Record<string, unknown>
+      const color = parseProceduralColor(point.color)
+      if (!color) throw new Error(`Point ${index} needs a colour`)
+      const col = index % columns
+      const row = Math.floor(index / columns)
+      return {
+        x: finite(point.x, col / (columns - 1)),
+        y: finite(point.y, row / (rows - 1)),
+        color
+      }
+    })
+    return { v: 1, kind: 'mesh', columns, rows, points, ...(raw.smooth === false ? { smooth: false } : {}) }
+  }
+  throw new Error('"kind" must be "shader" or "mesh"')
+}
+
+export function proceduralKey(fill: Fill): string | null {
+  return fill.type === 'CUSTOM' && fill.customEffectId
+    ? `${PROCEDURAL_KEY_PREFIX}${fill.customEffectId}`
+    : null
+}
+
+/** The definition a CUSTOM fill links to, or null (then it paints its fallback colour). */
+export function proceduralFillOf(node: SceneNode, fill: Fill): ProceduralFillDef | null {
+  const key = proceduralKey(fill)
+  if (!key) return null
+  const encoded = `${PROCEDURAL_NAMESPACE}/${key}`
+  const entry = node.pluginData.find(
+    (e) => e.pluginId === PROCEDURAL_NAMESPACE && (e.key === encoded || e.key === key)
+  )
+  if (!entry?.value) return null
+  if (parsed.has(entry.value)) return parsed.get(entry.value) ?? null
+  let def: ProceduralFillDef | null = null
+  try {
+    def = normalizeProceduralFill(JSON.parse(entry.value))
+  } catch {
+    def = null
+  }
+  if (parsed.size > 256) parsed.clear()
+  parsed.set(entry.value, def)
+  return def
+}
+
+// ── Shaders ──────────────────────────────────────────────────────────────
+
+interface CompiledEffect {
+  effect: RuntimeEffect | null
+  error: string | null
+  uniforms: Array<{ name: string; floats: number }>
+}
+
+const compiled = new WeakMap<CanvasKit, Map<string, CompiledEffect>>()
+
+export function shaderSource(def: ShaderFillDef): string {
+  return def.sksl ?? SHADER_PRESETS[def.preset ?? '']?.sksl ?? ''
+}
+
+/** Compile (cached per CanvasKit instance) and describe an effect's uniforms. */
+export function compileShaderFill(ck: CanvasKit, sksl: string): CompiledEffect {
+  let cache = compiled.get(ck)
+  if (!cache) {
+    cache = new Map()
+    compiled.set(ck, cache)
+  }
+  const hit = cache.get(sksl)
+  if (hit) return hit
+  let error = ''
+  const effect = ck.RuntimeEffect.Make(sksl, (message) => {
+    error = message
+  })
+  const uniforms: CompiledEffect['uniforms'] = []
+  if (effect) {
+    for (let i = 0; i < effect.getUniformCount(); i++) {
+      const u = effect.getUniform(i)
+      uniforms.push({ name: effect.getUniformName(i), floats: u.columns * u.rows })
+    }
+  }
+  const result = { effect: effect ?? null, error: effect ? null : error || 'compile failed', uniforms }
+  if (cache.size > 64) {
+    for (const entry of cache.values()) entry.effect?.delete()
+    cache.clear()
+  }
+  cache.set(sksl, result)
+  return result
+}
+
+/** Delete every compiled effect for this CanvasKit instance (renderer teardown). */
+export function disposeShaderFills(ck: CanvasKit): void {
+  const cache = compiled.get(ck)
+  if (!cache) return
+  for (const entry of cache.values()) entry.effect?.delete()
+  compiled.delete(ck)
+}
+
+function uniformData(def: ShaderFillDef, layout: CompiledEffect['uniforms'], width: number, height: number) {
+  const defaults = def.preset ? (SHADER_PRESETS[def.preset]?.uniforms ?? {}) : {}
+  const values: Record<string, number | number[]> = { ...defaults, ...def.uniforms, u_size: [width, height] }
+  const data: number[] = []
+  for (const { name, floats } of layout) {
+    const value = values[name]
+    for (let i = 0; i < floats; i++) {
+      data.push(Array.isArray(value) ? (value[i] ?? 0) : i === 0 && typeof value === 'number' ? value : 0)
+    }
+  }
+  return data
+}
+
+export function makeShaderFill(r: SkiaRenderer, def: ShaderFillDef, width: number, height: number): Shader | null {
+  const program = compileShaderFill(r.ck, shaderSource(def))
+  if (!program.effect) return null
+  return program.effect.makeShader(uniformData(def, program.uniforms, width, height))
+}
+
+// ── Mesh gradients ───────────────────────────────────────────────────────
+
+type P = [number, number]
+
+function meshGrid(def: MeshFillDef, width: number, height: number): P[][] {
+  const grid: P[][] = []
+  for (let row = 0; row < def.rows; row++) {
+    const line: P[] = []
+    for (let col = 0; col < def.columns; col++) {
+      const p = def.points[row * def.columns + col]
+      line.push([p.x * width, p.y * height])
+    }
+    grid.push(line)
+  }
+  return grid
+}
+
+/** Coons-patch cubics (12 points, clockwise from the top-left corner) for every cell. */
+export function meshPatches(def: MeshFillDef, width: number, height: number) {
+  const g = meshGrid(def, width, height)
+  const smooth = def.smooth !== false
+  const at = (row: number, col: number) => g[Math.min(def.rows - 1, Math.max(0, row))][Math.min(def.columns - 1, Math.max(0, col))]
+  // Catmull-Rom tangent along a row (dc) or a column (dr), one-sided at the edges.
+  const tangent = (row: number, col: number, dr: number, dc: number): P => {
+    const a = at(row - dr, col - dc)
+    const b = at(row + dr, col + dc)
+    const edge = row - dr < 0 || col - dc < 0 || row + dr >= def.rows || col + dc >= def.columns
+    const k = edge ? 1 : 0.5
+    return [(b[0] - a[0]) * k, (b[1] - a[1]) * k]
+  }
+  const handle = (row: number, col: number, dr: number, dc: number, towardRow: number, towardCol: number, sign: number): P => {
+    const p = at(row, col)
+    if (!smooth) {
+      const q = at(towardRow, towardCol)
+      return [p[0] + (q[0] - p[0]) / 3, p[1] + (q[1] - p[1]) / 3]
+    }
+    const t = tangent(row, col, dr, dc)
+    return [p[0] + (sign * t[0]) / 3, p[1] + (sign * t[1]) / 3]
+  }
+  const patches: Array<{ cubics: number[]; corners: [number, number, number, number] }> = []
+  for (let row = 0; row < def.rows - 1; row++) {
+    for (let col = 0; col < def.columns - 1; col++) {
+      const tl = at(row, col)
+      const tr = at(row, col + 1)
+      const br = at(row + 1, col + 1)
+      const bl = at(row + 1, col)
+      const pts: P[] = [
+        tl,
+        handle(row, col, 0, 1, row, col + 1, 1),
+        handle(row, col + 1, 0, 1, row, col, -1),
+        tr,
+        handle(row, col + 1, 1, 0, row + 1, col + 1, 1),
+        handle(row + 1, col + 1, 1, 0, row, col + 1, -1),
+        br,
+        handle(row + 1, col + 1, 0, 1, row + 1, col, -1),
+        handle(row + 1, col, 0, 1, row + 1, col + 1, 1),
+        bl,
+        handle(row + 1, col, 1, 0, row, col, -1),
+        handle(row, col, 1, 0, row + 1, col, 1)
+      ]
+      patches.push({
+        cubics: pts.flat(),
+        corners: [row * def.columns + col, row * def.columns + col + 1, (row + 1) * def.columns + col + 1, (row + 1) * def.columns + col]
+      })
+    }
+  }
+  return patches
+}
+
+export function makeMeshFill(r: SkiaRenderer, def: MeshFillDef, width: number, height: number): Shader | null {
+  if (width <= 0 || height <= 0) return null
+  const ck = r.ck
+  const bounds = ck.LTRBRect(0, 0, width, height)
+  const recorder = new ck.PictureRecorder()
+  const canvas = recorder.beginRecording(bounds)
+  const paint = new ck.Paint()
+  paint.setAntiAlias(true)
+  try {
+    for (const patch of meshPatches(def, width, height)) {
+      const colors = patch.corners.map((i) => {
+        const c = def.points[i].color
+        // drawPatch interpolates colours; the paint's alpha is applied by the fill pass.
+        return ck.Color4f(c[0], c[1], c[2], c[3])
+      })
+      canvas.drawPatch(patch.cubics, colors, null, ck.BlendMode.Dst, paint)
+    }
+  } finally {
+    paint.delete()
+  }
+  const picture = recorder.finishRecordingAsPicture()
+  recorder.delete()
+  try {
+    return picture.makeShader(ck.TileMode.Clamp, ck.TileMode.Clamp, ck.FilterMode.Linear, undefined, bounds)
+  } finally {
+    picture.delete()
+  }
+}
+
+/** Set `r.fillPaint`'s shader for a procedural fill; false = paint the fallback colour. */
+export function applyProceduralFill(r: SkiaRenderer, fill: Fill, node: SceneNode): boolean {
+  const def = proceduralFillOf(node, fill)
+  if (!def) return false
+  const shader =
+    def.kind === 'shader'
+      ? makeShaderFill(r, def, node.width, node.height)
+      : makeMeshFill(r, def, node.width, node.height)
+  if (!shader) return false
+  try {
+    r.fillPaint.setColor(r.ck.Color4f(1, 1, 1, 1))
+    r.fillPaint.setShader(shader)
+  } finally {
+    shader.delete()
+  }
+  return true
+}

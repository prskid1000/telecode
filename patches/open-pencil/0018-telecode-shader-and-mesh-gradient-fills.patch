+import { expect, test } from 'bun:test'
+
+import type { Fill } from '@open-pencil/scene-graph'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { CanvasKit } from 'canvaskit-wasm'
+import {
+  compileShaderFill,
+  meshPatches,
+  normalizeProceduralFill
+} from '#core/canvas/gradients/procedural'
+import { SkiaRenderer } from '#core/canvas/renderer'
+
+import { expectDefined } from '#tests/helpers/assert'
+
+let cachedCk: CanvasKit | null = null
+
+/** Like #cli/headless initCanvasKit, but with a wasm path that also resolves on Windows. */
+async function initCanvasKit(): Promise<CanvasKit> {
+  if (cachedCk) return cachedCk
+  const CanvasKitInit = (await import('canvaskit-wasm/full')).default
+  const dir = dirname(fileURLToPath(import.meta.resolve('canvaskit-wasm/full')))
+  cachedCk = await CanvasKitInit({ locateFile: (file: string) => join(dir, file) })
+  return cachedCk
+}
+
+const FALLBACK = { r: 0, g: 0, b: 1, a: 1 }
+
+function customFill(id: string): Fill {
+  return { type: 'CUSTOM', color: FALLBACK, opacity: 1, visible: true, customEffectId: id }
+}
+
+async function render(def: unknown, size = 100) {
+  const ck = await initCanvasKit()
+  const renderer = new SkiaRenderer(ck, expectDefined(ck.MakeSurface(size, size), 'surface'))
+  const graph = new SceneGraph()
+  const page = expectDefined(graph.getPages()[0], 'page')
+  const node = graph.createNode('RECTANGLE', page.id, {
+    width: size,
+    height: size,
+    fills: [customFill('7:1')],
+    pluginData: def === undefined ? [] : [{ pluginId: 'telecode', key: 'telecode/fill:7:1', value: JSON.stringify(def) }]
+  })
+  try {
+    const canvas = renderer.surface.getCanvas()
+    canvas.clear(ck.TRANSPARENT)
+    renderer.renderShape(canvas, node, graph)
+    renderer.surface.flush()
+    const image = renderer.surface.makeImageSnapshot()
+    try {
+      const pixels = expectDefined(
+        image.readPixels(0, 0, {
+          width: size,
+          height: size,
+          colorType: ck.ColorType.RGBA_8888,
+          alphaType: ck.AlphaType.Unpremul,
+          colorSpace: ck.ColorSpace.SRGB
+        }),
+        'pixels'
+      )
+      return (x: number, y: number) => Array.from(pixels.slice((y * size + x) * 4, (y * size + x) * 4 + 4))
+    } finally {
+      image.delete()
+    }
+  } finally {
+    renderer.destroy()
+  }
+}
+
+test('a CUSTOM fill without a definition paints its fallback colour', async () => {
+  const pixel = await render(undefined)
+  expect(pixel(50, 50)).toEqual([0, 0, 255, 255])
+})
+
+test('SkSL shader fill: custom source with u_size and named uniforms', async () => {
+  const pixel = await render({
+    kind: 'shader',
+    sksl: `uniform float2 u_size; uniform float4 u_left; uniform float4 u_right;
+half4 main(float2 p) { return half4(p.x < u_size.x * 0.5 ? u_left : u_right); }`,
+    uniforms: { u_left: '#ff0000', u_right: [0, 1, 0, 1] }
+  })
+  expect(pixel(10, 50)).toEqual([255, 0, 0, 255])
+  expect(pixel(90, 50)).toEqual([0, 255, 0, 255])
+})
+
+test('shader presets render and a broken shader falls back', async () => {
+  const stripes = await render({ kind: 'shader', preset: 'stripes', uniforms: { u_a: '#000000', u_b: '#ffffff', u_width: 10, u_angle: 0 } })
+  expect(stripes(5, 50)).toEqual([0, 0, 0, 255])
+  expect(stripes(15, 50)).toEqual([255, 255, 255, 255])
+  const broken = await render({ kind: 'shader', sksl: 'half4 main(float2 p) { return nope; }' })
+  expect(broken(50, 50)).toEqual([0, 0, 255, 255])
+  const ck = await initCanvasKit()
+  expect(compileShaderFill(ck, 'half4 main(float2 p) { return nope; }').error).toMatch(/nope/)
+  expect(compileShaderFill(ck, 'uniform float2 u_size; half4 main(float2 p) { return half4(1); }').uniforms).toEqual([
+    { name: 'u_size', floats: 2 }
+  ])
+})
+
+test('mesh gradient: corner colours, interpolation in between', async () => {
+  const pixel = await render({
+    kind: 'mesh',
+    columns: 2,
+    rows: 2,
+    points: [{ color: '#ff0000' }, { color: '#00ff00' }, { color: '#0000ff' }, { color: '#ffffff' }]
+  })
+  const near = (a: number[], b: number[]) => a.every((v, i) => Math.abs(v - b[i]) <= 12)
+  expect(near(pixel(1, 1), [255, 0, 0, 255])).toBe(true)
+  expect(near(pixel(98, 1), [0, 255, 0, 255])).toBe(true)
+  expect(near(pixel(1, 98), [0, 0, 255, 255])).toBe(true)
+  expect(near(pixel(98, 98), [255, 255, 255, 255])).toBe(true)
+  const mid = pixel(50, 50)
+  expect(mid[3]).toBe(255)
+  for (const channel of mid.slice(0, 3)) {
+    expect(channel).toBeGreaterThan(80)
+    expect(channel).toBeLessThan(180)
+  }
+})
+
+test('mesh definitions are validated and warped grids build one patch per cell', () => {
+  expect(() => normalizeProceduralFill({ kind: 'mesh', columns: 2, rows: 2, points: [] })).toThrow(/needs 4 points/)
+  expect(() => normalizeProceduralFill({ kind: 'shader', preset: 'nope' })).toThrow(/Unknown shader preset/)
+  expect(() => normalizeProceduralFill({ kind: 'gloss' })).toThrow(/"kind"/)
+  const def = normalizeProceduralFill({
+    kind: 'mesh',
+    columns: 3,
+    rows: 2,
+    points: ['#000', '#111', '#222', '#333', '#444', '#555'].map((color, i) => ({ color, ...(i === 1 ? { x: 0.3, y: 0.1 } : {}) }))
+  })
+  if (def.kind !== 'mesh') throw new Error('mesh expected')
+  expect(def.points[0]).toMatchObject({ x: 0, y: 0 })
+  expect(def.points[5]).toMatchObject({ x: 1, y: 1 })
+  const patches = meshPatches(def, 200, 100)
+  expect(patches).toHaveLength(2)
+  expect(patches[0].cubics).toHaveLength(24)
+  expect(patches[0].cubics.slice(6, 8)).toEqual([60, 10])
+  expect(patches[1].corners).toEqual([1, 2, 5, 4])
+})

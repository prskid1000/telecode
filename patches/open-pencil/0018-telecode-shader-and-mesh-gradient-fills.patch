+++ b/tests/engine/app/telecode/fills.test.ts
@@ -0,0 +1,81 @@
+import { beforeAll, describe, expect, test } from 'bun:test'
+
+import { exportFigFile, initCodec } from '@open-pencil/core'
+import { proceduralFillOf } from '@open-pencil/core/canvas'
+import { parseFigBuffer } from '@open-pencil/fig'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { importNodeChanges } from '#core/kiwi/fig/import'
+
+import {
+  describeFills,
+  listProceduralFills,
+  removeFill,
+  setProceduralFill
+} from '@/app/integrations/telecode/fills'
+
+beforeAll(async () => {
+  await initCodec()
+})
+
+function rect() {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const node = graph.createNode('RECTANGLE', page.id, {
+    name: 'Hero',
+    width: 200,
+    height: 100,
+    fills: [{ type: 'SOLID', color: { r: 1, g: 1, b: 1, a: 1 }, opacity: 1, visible: true }]
+  })
+  return { graph, node }
+}
+
+describe('procedural fills (telecode)', () => {
+  test('mesh shorthand: a CUSTOM paint on top, its definition in plugin data', () => {
+    const { graph, node } = rect()
+    const out = setProceduralFill(graph, node.id, {
+      kind: 'mesh',
+      colors: [
+        ['#ff0000', '#00ff00'],
+        ['#0000ff', '#ffffff']
+      ]
+    })
+    expect(out.fills).toHaveLength(2)
+    const fill = graph.getNode(node.id)!.fills[1]
+    expect(fill.type).toBe('CUSTOM')
+    expect(fill.color.r).toBeCloseTo(0.5)
+    const def = proceduralFillOf(graph.getNode(node.id)!, fill)
+    expect(def).toMatchObject({ kind: 'mesh', columns: 2, rows: 2 })
+    expect(out.fills[1]).toMatchObject({ kind: 'mesh', index: 1 })
+    expect(listProceduralFills(graph)).toEqual([{ node_id: node.id, name: 'Hero', kinds: ['mesh'], errors: [] }])
+  })
+
+  test('replace keeps the link id, remove drops the definition', () => {
+    const { graph, node } = rect()
+    setProceduralFill(graph, node.id, { kind: 'shader', preset: 'grain' }, { index: 0, fallback: '#123456' })
+    const first = graph.getNode(node.id)!.fills[0]
+    expect(first.color.r).toBeCloseTo(0x12 / 255)
+    setProceduralFill(graph, node.id, { kind: 'shader', preset: 'stripes' }, { index: 0 })
+    const again = graph.getNode(node.id)!.fills[0]
+    expect(again.customEffectId).toBe(first.customEffectId)
+    expect(graph.getNode(node.id)!.pluginData.filter((e) => e.key.startsWith('telecode/fill:'))).toHaveLength(1)
+    expect(describeFills(graph, node.id).fills[0]).toMatchObject({ kind: 'shader', definition: { preset: 'stripes' } })
+    removeFill(graph, node.id, 0)
+    expect(graph.getNode(node.id)!.fills).toHaveLength(0)
+    expect(graph.getNode(node.id)!.pluginData.filter((e) => e.key.startsWith('telecode/fill:'))).toHaveLength(0)
+    expect(() => setProceduralFill(graph, node.id, { kind: 'mesh', colors: [['#fff']] })).toThrow(/at least 2 columns/)
+  })
+
+  test('shader and mesh fills survive a .fig round trip', async () => {
+    const { graph, node } = rect()
+    setProceduralFill(graph, node.id, { kind: 'shader', preset: 'aurora', uniforms: { u_seed: 3 } })
+    setProceduralFill(graph, node.id, { kind: 'mesh', colors: [['#000', '#fff'], ['#f00', '#00f']] })
+    const bytes = await exportFigFile(graph)
+    const parsed = parseFigBuffer(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength))
+    const g2 = importNodeChanges(parsed.nodeChanges, parsed.blobs, undefined, { populate: 'all' })
+    const n2 = [...g2.getAllNodes()].find((n) => n.name === 'Hero')!
+    const kinds = describeFills(g2, n2.id).fills.map((f) => ('kind' in f ? f.kind : f.type))
+    expect(kinds).toEqual(['SOLID', 'shader', 'mesh'])
+    expect(proceduralFillOf(n2, n2.fills[1])).toMatchObject({ preset: 'aurora', uniforms: { u_seed: 3 } })
+  })
+})

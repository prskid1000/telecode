+// n host-to-device copies in one driver call (CUDA 13 cudaMemcpyBatchAsync), plain async copies if that is not available or fails
+static void ggml_backend_cuda_set_tensor_batch_async(ggml_backend_t backend, ggml_tensor ** tensors, const void * const * srcs, const size_t * offsets, const size_t * sizes, size_t n) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *)backend->context;
+    std::vector<void *> dsts(n);
+    for (size_t i = 0; i < n; ++i) {
+        GGML_ASSERT(ggml_backend_buffer_is_cuda(tensors[i]->buffer));
+        dsts[i] = (char *) tensors[i]->data + offsets[i];
+    }
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA) && defined(CUDART_VERSION) && CUDART_VERSION >= 13000
+    static bool batch_ok = true;
+    if (batch_ok) {
+        cudaMemcpyAttributes attr = {};
+        attr.srcAccessOrder = cudaMemcpySrcAccessOrderAny;
+        size_t attr_idx = 0;
+        if (cudaMemcpyBatchAsync(dsts.data(), srcs, sizes, n, &attr, &attr_idx, 1, cuda_ctx->stream()) == cudaSuccess) {
+            return;
+        }
+        (void) cudaGetLastError();
+        batch_ok = false;
+    }
+#endif
+    for (size_t i = 0; i < n; ++i) {
+        CUDA_CHECK(cudaMemcpyAsync(dsts[i], srcs[i], sizes[i], cudaMemcpyHostToDevice, cuda_ctx->stream()));
+    }
+}

diff --git a/src/llama-head-subset.cpp b/src/llama-head-subset.cpp
new file mode 100644
index 0000000..bdc920d
--- /dev/null
+++ b/src/llama-head-subset.cpp
@@ -0,0 +1,103 @@
+#include "llama-head-subset.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+struct llama_head_subset::impl {
+    const ggml_tensor * src = nullptr;
+
+    ggml_context_ptr ctx;
+    ggml_backend_buffer_ptr buf;
+
+    ggml_tensor * w   = nullptr;
+    ggml_tensor * ids = nullptr;
+
+    int64_t n_rows = 0;
+
+    impl(const llama_model & model, ggml_backend_buffer_type_t buft, int32_t n_req) {
+        src = model.output;
+        if (src == nullptr || src->buffer == nullptr || !ggml_backend_buffer_is_host(src->buffer)) {
+            throw std::runtime_error("the output head is not in host memory");
+        }
+        if (model.output_s != nullptr || src->ne[2] != 1 || src->ne[3] != 1 || ggml_is_transposed(src)) {
+            throw std::runtime_error("the output head cannot be split by rows");
+        }
+
+        const int64_t n_vocab = src->ne[1];
+        // the special tokens of the common vocabularies are the last ones
+        const int64_t n_last  = std::min<int64_t>(1024, n_vocab/4);
+        const int64_t n_first = std::min<int64_t>(std::max<int64_t>(n_req, 1), n_vocab - n_last);
+        n_rows = n_first + n_last;
+        if (n_rows >= n_vocab) {
+            throw std::runtime_error("the subset would be the whole head");
+        }
+
+        ggml_init_params params = {
+            /*.mem_size   =*/ 2*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ctx.reset(ggml_init(params));
+        if (!ctx) {
+            throw std::runtime_error("failed to create the head subset context");
+        }
+        w   = ggml_new_tensor_2d(ctx.get(), src->type, src->ne[0], n_rows);
+        ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, n_rows);
+        ggml_set_name(w,   "head_subset.weight");
+        ggml_set_name(ids, "head_subset.ids");
+        GGML_ASSERT(w->nb[1] == src->nb[1]);
+
+        buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+        if (!buf) {
+            throw std::runtime_error("failed to allocate the head subset");
+        }
+        // as weights, the ops that read it run on the device that holds it
+        ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+        const size_t row = src->nb[1];
+        ggml_backend_tensor_set(w, src->data, 0, n_first*row);
+        ggml_backend_tensor_set(w, (const uint8_t *) src->data + (n_vocab - n_last)*row, n_first*row, n_last*row);
+
+        std::vector<int32_t> tokens(n_rows);
+        for (int64_t i = 0; i < n_first; ++i) {
+            tokens[i] = (int32_t) i;
+        }
+        for (int64_t i = 0; i < n_last; ++i) {
+            tokens[n_first + i] = (int32_t) (n_vocab - n_last + i);
+        }
+        ggml_backend_tensor_set(ids, tokens.data(), 0, ggml_nbytes(ids));
+
+        LLAMA_LOG_INFO("%s: %" PRId64 " of %" PRId64 " rows of the output head on the device, %.2f MiB\n", __func__,
+                n_rows, n_vocab, ggml_backend_buffer_get_size(buf.get())/1024.0/1024.0);
+    }
+};
+
+llama_head_subset::llama_head_subset(const llama_model & model, ggml_backend_buffer_type_t buft, int32_t n_rows) :
+    pimpl(new impl(model, buft, n_rows)) {
+}
+
+llama_head_subset::~llama_head_subset() = default;
+
+const ggml_tensor * llama_head_subset::source() const {
+    return pimpl->src;
+}
+
+ggml_tensor * llama_head_subset::weights() const {
+    return pimpl->w;
+}
+
+ggml_tensor * llama_head_subset::ids() const {
+    return pimpl->ids;
+}
+
+int64_t llama_head_subset::n_rows() const {
+    return pimpl->n_rows;
+}
diff --git a/src/llama-head-subset.h b/src/llama-head-subset.h
new file mode 100644
index 0000000..9ee3c51
--- /dev/null
+++ b/src/llama-head-subset.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <memory>
+
+struct llama_model;
+
+// the first rows of the output head (the most frequent tokens of a BPE vocabulary) and the last ones (the special tokens) in device memory
+// a draft head step that only needs likely tokens then does not read the whole output matrix from host memory
+class llama_head_subset {
+public:
+    // throws if the model has no output head in host memory that can be split by rows
+    llama_head_subset(const llama_model & model, ggml_backend_buffer_type_t buft, int32_t n_rows);
+    ~llama_head_subset();
+
+    // the full output head the subset was taken from
+    const ggml_tensor * source() const;
+
+    // [n_embd, n_rows] same type as the full head
+    ggml_tensor * weights() const;
+
+    // I32 [n_rows], the token of each row
+    ggml_tensor * ids() const;
+
+    int64_t n_rows() const;
+
+private:
+    struct impl;
+    std::unique_ptr<impl> pimpl;
+};
+
+using llama_head_subset_ptr = std::unique_ptr<llama_head_subset>;

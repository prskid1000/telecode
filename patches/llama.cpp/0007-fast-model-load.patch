diff --git a/include/llama-fast-read.h b/include/llama-fast-read.h
new file mode 100644
index 0000000..331228b
--- /dev/null
+++ b/include/llama-fast-read.h
@@ -0,0 +1,70 @@
+#pragma once
+
+// Fast reader for large weight files.
+//
+// Reads a set of byte ranges of one file with several workers in parallel and hands every piece to a
+// callback. On Windows each worker owns a handle opened with FILE_FLAG_NO_BUFFERING and reads at an
+// explicit offset, so the reads run at the drive's own speed and nothing is left in the system file
+// cache afterwards (unloading a model really frees its RAM). The number of workers is tuned while the
+// file is read: it starts at 4 and doubles (up to 8) while the throughput still rises by 10 %.
+//
+// Environment:
+//   LLAMA_FAST_READ=0            disable (callers use their ordinary reader)
+//   LLAMA_FAST_READ_THREADS=N    fixed number of workers, no tuning
+//   LLAMA_FAST_READ_CHUNK_MB=N   size of one read (default 32)
+//
+// Other platforms report LLAMA_FAST_READ_UNAVAILABLE for now.
+
+#include "llama.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct llama_fast_read_range {
+    uint64_t offset; // in the file
+    uint64_t size;
+};
+
+// called from the worker threads, concurrently, with disjoint pieces: range index, offset of the piece
+// inside the range, the bytes; it must not throw
+typedef void (*llama_fast_read_sink)(void * user, size_t range, uint64_t offset_in_range, const void * data, size_t size);
+
+// called from the calling thread only; return false to cancel
+typedef bool (*llama_fast_read_progress)(void * user, uint64_t bytes_done, uint64_t bytes_total);
+
+struct llama_fast_read_stats {
+    uint64_t bytes;   // bytes handed to the sink
+    uint64_t read;    // bytes read from the drive (alignment and small gaps included)
+    double   seconds;
+    int      threads; // workers in use at the end
+    int      chunk_mb; // size of one read
+};
+
+enum llama_fast_read_status {
+    LLAMA_FAST_READ_UNAVAILABLE = 0, // nothing was read: use the ordinary reader
+    LLAMA_FAST_READ_OK          = 1,
+    LLAMA_FAST_READ_CANCELLED   = 2, // the progress callback returned false; ranges may be partly written
+    LLAMA_FAST_READ_ERROR       = 3, // see err; ranges may be partly written
+};
+
+// ranges must not overlap; min_bytes: below this total the reader declines (UNAVAILABLE)
+LLAMA_API enum llama_fast_read_status llama_fast_read(
+        const char                         * path,
+        const struct llama_fast_read_range * ranges,
+        size_t                               n_ranges,
+        uint64_t                             min_bytes,
+        llama_fast_read_sink                 sink,
+        void                               * sink_user,
+        llama_fast_read_progress             progress,
+        void                               * progress_user,
+        struct llama_fast_read_stats       * stats,
+        char                               * err,
+        size_t                               err_size);
+
+#ifdef __cplusplus
+}
+#endif

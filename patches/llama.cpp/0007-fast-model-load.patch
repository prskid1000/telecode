+static HANDLE fast_read_open(const std::wstring & wpath) {
+    return CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+                       OPEN_EXISTING, FILE_FLAG_NO_BUFFERING, nullptr);
+}
+
+// one aligned read of the file, covering [chunk_begin, chunk_end) of what is needed
+struct fast_read_chunk {
+    uint64_t begin;     // aligned
+    uint64_t end;       // what is needed ends here (not aligned)
+    size_t   first;     // first range (in offset order) that may intersect the chunk
+};
+
+enum llama_fast_read_status llama_fast_read(
+        const char                         * path,
+        const struct llama_fast_read_range * ranges,
+        size_t                               n_ranges,
+        uint64_t                             min_bytes,
+        llama_fast_read_sink                 sink,
+        void                               * sink_user,
+        llama_fast_read_progress             progress,
+        void                               * progress_user,
+        struct llama_fast_read_stats       * stats,
+        char                               * err,
+        size_t                               err_size) {
+    if (stats) {
+        *stats = {};
+    }
+    if (fast_read_env_long("LLAMA_FAST_READ", 1) == 0 || path == nullptr || *path == '\0' || n_ranges == 0 || sink == nullptr) {
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+
+    uint64_t total = 0;
+    std::vector<size_t> order(n_ranges);
+    for (size_t i = 0; i < n_ranges; ++i) {
+        order[i] = i;
+        total += ranges[i].size;
+    }
+    if (total == 0 || total < min_bytes) {
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+    std::sort(order.begin(), order.end(), [&](size_t a, size_t b) { return ranges[a].offset < ranges[b].offset; });
+    for (size_t k = 1; k < n_ranges; ++k) {
+        const auto & prev = ranges[order[k - 1]];
+        if (ranges[order[k]].offset < prev.offset + prev.size) {
+            return LLAMA_FAST_READ_UNAVAILABLE; // overlapping ranges: not what this reader is for
+        }
+    }
+
+    const int wlen = MultiByteToWideChar(CP_UTF8, 0, path, -1, nullptr, 0);
+    if (wlen <= 0) {
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+    std::wstring wpath(wlen, L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, path, -1, &wpath[0], wlen);
+    wpath.resize(wlen - 1);
+
+    HANDLE h0 = fast_read_open(wpath);
+    if (h0 == INVALID_HANDLE_VALUE) {
+        LLAMA_LOG_DEBUG("%s: cannot open %s unbuffered: %s\n", __func__, path, fast_read_win_err(GetLastError()).c_str());
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+
+    LARGE_INTEGER fsize;
+    if (!GetFileSizeEx(h0, &fsize)) {
+        CloseHandle(h0);
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+    const uint64_t file_size = (uint64_t) fsize.QuadPart;
+    const auto & last = ranges[order.back()];
+    if (last.offset + last.size > file_size) {
+        CloseHandle(h0);
+        fast_read_set_err(err, err_size, "a range ends past the end of the file");
+        return LLAMA_FAST_READ_ERROR;
+    }
+
+    // unbuffered reads need offset, size and buffer aligned to the sector size
+    uint64_t align = 4096;
+    FILE_STORAGE_INFO si;
+    if (GetFileInformationByHandleEx(h0, FileStorageInfo, &si, sizeof(si))) {
+        align = std::max<uint64_t>(align, si.PhysicalBytesPerSectorForPerformance);
+        align = std::max<uint64_t>(align, si.LogicalBytesPerSector);
+    }
+    if ((align & (align - 1)) != 0) {
+        CloseHandle(h0);
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+
+    uint64_t chunk_size = (uint64_t) std::max(1L, fast_read_env_long("LLAMA_FAST_READ_CHUNK_MB", 32)) * 1024 * 1024;
+    chunk_size = (chunk_size + align - 1) & ~(align - 1);
+
+    // spans of needed bytes (gaps up to 1 MiB are read through), cut into aligned chunks in file order
+    const uint64_t max_gap = 1024 * 1024;
+    std::vector<fast_read_chunk> chunks;
+    uint64_t read_total = 0;
+    for (size_t k = 0; k < n_ranges; ) {
+        const size_t   span_first = k;
+        const uint64_t span_begin = ranges[order[k]].offset;
+        uint64_t       span_end   = span_begin + ranges[order[k]].size;
+        for (++k; k < n_ranges && ranges[order[k]].offset <= span_end + max_gap; ++k) {
+            span_end = std::max(span_end, ranges[order[k]].offset + ranges[order[k]].size);
+        }
+        size_t first = span_first;
+        for (uint64_t b = span_begin & ~(align - 1); b < span_end; b += chunk_size) {
+            const uint64_t e = std::min(span_end, b + chunk_size);
+            while (first + 1 < k && ranges[order[first]].offset + ranges[order[first]].size <= b) {
+                ++first;
+            }
+            chunks.push_back({ b, e, first });
+            read_total += ((e + align - 1) & ~(align - 1)) - b;
+        }
+    }
+
+    int max_threads = (int) std::min<unsigned>(8, std::max(2u, std::thread::hardware_concurrency()));
+    const long fixed = fast_read_env_long("LLAMA_FAST_READ_THREADS", 0);
+    if (fixed > 0) {
+        max_threads = (int) std::min<long>(fixed, 64);
+    }
+    max_threads = (int) std::min<size_t>(max_threads, chunks.size());
+
+    std::vector<HANDLE> handles(max_threads, INVALID_HANDLE_VALUE);
+    std::vector<void *> bufs(max_threads, nullptr);
+    handles[0] = h0;
+    bool setup_ok = true;
+    for (int i = 0; i < max_threads && setup_ok; ++i) {
+        if (handles[i] == INVALID_HANDLE_VALUE) {
+            handles[i] = fast_read_open(wpath);
+        }
+        bufs[i] = VirtualAlloc(nullptr, chunk_size + align, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        setup_ok = handles[i] != INVALID_HANDLE_VALUE && bufs[i] != nullptr;
+    }
+    auto cleanup = [&]() {
+        for (int i = 0; i < max_threads; ++i) {
+            if (handles[i] != INVALID_HANDLE_VALUE) {
+                CloseHandle(handles[i]);
+            }
+            if (bufs[i]) {
+                VirtualFree(bufs[i], 0, MEM_RELEASE);
+            }
+        }
+    };
+    if (!setup_ok) {
+        cleanup();
+        return LLAMA_FAST_READ_UNAVAILABLE;
+    }
+
+    std::atomic<size_t>   next_chunk{0};
+    std::atomic<int>      allowed{fixed > 0 ? max_threads : std::min(4, max_threads)};
+    std::atomic<uint64_t> done{0};
+    std::atomic<bool>     stop{false};
+    std::atomic<int>      running{max_threads};
+    std::mutex            mtx;
+    std::condition_variable cv;
+    std::string           error;
+
+    auto fail = [&](const std::string & msg) {
+        std::lock_guard<std::mutex> lock(mtx);
+        if (error.empty()) {
+            error = msg;
+        }
+        stop = true;
+    };
+
+    auto worker = [&](int id) {
+        uint8_t * buf = (uint8_t *) bufs[id];
+        while (!stop) {
+            if (id >= allowed.load()) {
+                if (next_chunk.load() >= chunks.size()) {
+                    break;
+                }
+                std::unique_lock<std::mutex> lock(mtx);
+                cv.wait_for(lock, std::chrono::milliseconds(5));
+                continue;
+            }
+            const size_t ci = next_chunk.fetch_add(1);
+            if (ci >= chunks.size()) {
+                break;
+            }
+            const fast_read_chunk & c = chunks[ci];
+            const uint64_t want = ((c.end + align - 1) & ~(align - 1)) - c.begin;
+            uint64_t got = 0;
+            while (got < want) {
+                OVERLAPPED ov = {};
+                const uint64_t off = c.begin + got;
+                ov.Offset     = (DWORD) (off & 0xFFFFFFFFu);
+                ov.OffsetHigh = (DWORD) (off >> 32);
+                DWORD n = 0;
+                if (!ReadFile(handles[id], buf + got, (DWORD) (want - got), &n, &ov)) {
+                    const DWORD code = GetLastError();
+                    if (code == ERROR_HANDLE_EOF) {
+                        break;
+                    }
+                    fail(std::string("read error: ") + fast_read_win_err(code));
+                    break;
+                }
+                got += n;
+                if (n < (DWORD) (want - (got - n))) {
+                    break; // short read = end of file (its byte count need not be aligned, so never read on from there)
+                }
+            }
+            if (stop) {
+                break;
+            }
+            if (c.begin + got < c.end) {
+                fail("unexpected end of file");
+                break;
+            }
+            uint64_t handed = 0;
+            for (size_t k = c.first; k < n_ranges; ++k) {
+                const size_t   ri = order[k];
+                const uint64_t rb = ranges[ri].offset;
+                const uint64_t re = rb + ranges[ri].size;
+                if (rb >= c.end) {
+                    break;
+                }
+                const uint64_t a = std::max(rb, c.begin);
+                const uint64_t b = std::min(re, c.end);
+                if (a < b) {
+                    sink(sink_user, ri, a - rb, buf + (a - c.begin), (size_t) (b - a));
+                    handed += b - a;
+                }
+            }
+            done += handed;
+        }
+        if (--running == 0) {
+            cv.notify_all();
+        }
+    };
+
+    const auto t0 = std::chrono::steady_clock::now();
+    auto seconds = [&]() { return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(); };
+
+    std::vector<std::thread> threads;
+    threads.reserve(max_threads);
+    for (int i = 0; i < max_threads; ++i) {
+        threads.emplace_back(worker, i);
+    }
+
+    // controller: progress, cancellation and the tuning of the number of workers
+    bool     tuning     = fixed <= 0 && max_threads > 4;
+    int      best_level = allowed.load();
+    double   best_rate  = 0.0;
+    double   win_t      = 0.15; // the first window starts after a short settle
+    uint64_t win_b      = 0;
+    bool     win_open   = false;
+    const double window = 0.3;
+    bool cancelled = false;
+    while (running.load() > 0) {
+        {
+            std::unique_lock<std::mutex> lock(mtx);
+            cv.wait_for(lock, std::chrono::milliseconds(50));
+        }
+        const double   t = seconds();
+        const uint64_t d = done.load();
+        if (progress && !cancelled && !stop && !progress(progress_user, d, total)) {
+            cancelled = true;
+            stop      = true;
+        }
+        if (!tuning || stop) {
+            continue;
+        }
+        if (!win_open) {
+            if (t >= win_t) {
+                win_t    = t;
+                win_b    = d;
+                win_open = true;
+            }
+            continue;
+        }
+        if (t - win_t < window) {
+            continue;
+        }
+        const double rate  = (d - win_b) / (t - win_t);
+        const int    level = allowed.load();
+        if (rate > best_rate * 1.10) {
+            best_rate  = rate;
+            best_level = level;
+            if (level < max_threads) {
+                allowed  = std::min(level * 2, max_threads);
+                cv.notify_all();
+                win_t    = t + 0.1;
+                win_open = false;
+                continue;
+            }
+        }
+        allowed = best_level;
+        tuning  = false;
+    }
+    for (auto & th : threads) {
+        th.join();
+    }
+    cleanup();
+
+    if (stats) {
+        stats->bytes   = done.load();
+        stats->read    = read_total;
+        stats->seconds = seconds();
+        stats->threads = allowed.load();
+        stats->chunk_mb = (int) (chunk_size >> 20);
+    }
+    if (!error.empty()) {
+        fast_read_set_err(err, err_size, error);
+        return LLAMA_FAST_READ_ERROR;
+    }
+    if (cancelled) {
+        return LLAMA_FAST_READ_CANCELLED;
+    }
+    if (progress) {
+        progress(progress_user, total, total);
+    }
+    return LLAMA_FAST_READ_OK;
+}
+
+#else
+
+enum llama_fast_read_status llama_fast_read(
+        const char                         * path,
+        const struct llama_fast_read_range * ranges,
+        size_t                               n_ranges,
+        uint64_t                             min_bytes,
+        llama_fast_read_sink                 sink,
+        void                               * sink_user,
+        llama_fast_read_progress             progress,
+        void                               * progress_user,
+        struct llama_fast_read_stats       * stats,
+        char                               * err,
+        size_t                               err_size) {
+    (void) path; (void) ranges; (void) n_ranges; (void) min_bytes; (void) sink; (void) sink_user;
+    (void) progress; (void) progress_user; (void) err; (void) err_size;
+    (void) fast_read_set_err; (void) fast_read_env_long;
+    if (stats) {
+        *stats = {};
+    }
+    return LLAMA_FAST_READ_UNAVAILABLE;
+}
+
+#endif

+// Large pinned buffers on Windows: cudaMallocHost commits and locks the pages one at a time on one thread
+// (about 2 GiB/s on a laptop, seconds per model load); allocating the memory, touching its pages from several
+// threads and registering it is several times faster and gives the same page-locked memory.
+// GGML_CUDA_HOST_REGISTER_ALLOC=0 restores cudaMallocHost.
+static std::mutex               ggml_cuda_host_registered_mutex;
+static std::unordered_set<void *> ggml_cuda_host_registered;
+
+static void * ggml_cuda_host_malloc_registered(size_t size) {
+#if defined(_WIN32) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    static const bool disabled = [] {
+        const char * v = getenv("GGML_CUDA_HOST_REGISTER_ALLOC");
+        return v != nullptr && strcmp(v, "0") == 0;
+    }();
+    const size_t page = 4096;
+    if (disabled || size < 64ull*1024*1024) {
+        return nullptr;
+    }
+    const size_t alloc_size = (size + page - 1) & ~(page - 1);
+    char * ptr = (char *) _aligned_malloc(alloc_size, page);
+    if (ptr == nullptr) {
+        return nullptr;
+    }
+    const int n_threads = (int) std::min<unsigned>(16, std::max(1u, std::thread::hardware_concurrency()));
+    const size_t per = ((alloc_size / page + n_threads - 1) / n_threads) * page;
+    std::vector<std::thread> threads;
+    for (int i = 0; i < n_threads; ++i) {
+        threads.emplace_back([=] {
+            const size_t begin = i * per;
+            const size_t end   = std::min(alloc_size, begin + per);
+            for (size_t o = begin; o < end; o += page) {
+                ptr[o] = 0;
+            }
+        });
+    }
+    for (auto & t : threads) {
+        t.join();
+    }
+    cudaError_t err = cudaHostRegister(ptr, alloc_size, cudaHostRegisterPortable);
+    if (err != cudaSuccess) {
+        (void)cudaGetLastError();
+        GGML_LOG_DEBUG("%s: failed to register %.2f MiB of host memory: %s\n", __func__, size / 1024.0 / 1024.0, cudaGetErrorString(err));
+        _aligned_free(ptr);
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(ggml_cuda_host_registered_mutex);
+    ggml_cuda_host_registered.insert(ptr);
+    return ptr;
+#else
+    GGML_UNUSED(size);
+    return nullptr;
+#endif
+}
+
+static void ggml_cuda_host_free(void * ptr) {
+#if defined(_WIN32) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_registered_mutex);
+        auto it = ggml_cuda_host_registered.find(ptr);
+        if (it != ggml_cuda_host_registered.end()) {
+            ggml_cuda_host_registered.erase(it);
+            CUDA_CHECK(cudaHostUnregister(ptr));
+            _aligned_free(ptr);
+            return;
+        }
+    }
+#endif
+    CUDA_CHECK(cudaFreeHost(ptr));
+}
+
 static void ggml_backend_cuda_host_buffer_free_buffer(ggml_backend_buffer_t buffer) {
-    CUDA_CHECK(cudaFreeHost(buffer->context));
+    ggml_cuda_host_free(buffer->context);
 }
 

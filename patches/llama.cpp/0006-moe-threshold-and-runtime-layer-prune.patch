+    if (config.weight_threshold > 0.0f) {
+        // the ids above were written by other lanes
+        __syncwarp();
+        // the top expert is always kept; the weights of a normalised routing are normalised again over the kept experts
+        float kept = 0.0f;
+#pragma unroll
+        for (int i = 0; i < experts_per_thread; i++) {
+            const int idx = i * WARP_SIZE + threadIdx.x;
+            if (idx < n_expert_used && (idx == 0 || output_weights[i] >= config.weight_threshold)) {

+void llama_model::init_prune_layers() {
+    if (prune_layer_start != -1 || prune_layer_end != -1) {
+        return;
+    }
+    const char * env_prune = getenv("LLAMA_PRUNE_LAYERS");
+    const char * env_ratio = getenv("LLAMA_KEEP_RATIO");
+    const int total_layers = (int) hparams.n_layer();
+    if (total_layers <= 0) return;
+
+    if (env_prune && *env_prune) {
+        int s = -1, e = -1;
+        if (sscanf(env_prune, "%d-%d", &s, &e) == 2 || sscanf(env_prune, "%d:%d", &s, &e) == 2) {
+            // the last layer selects the output rows (inp_out_ids), it always runs
+            prune_layer_start = std::max(0, s);
+            prune_layer_end   = std::min(total_layers - 2, e);
+            if (prune_layer_start > prune_layer_end) {
+                prune_layer_start = prune_layer_end = -1;
+                LLAMA_LOG_WARN("%s: LLAMA_PRUNE_LAYERS=%s selects no prunable layer, pruning is off\n", __func__, env_prune);
+                return;
+            }
+            static bool logged = false;
+            if (!logged) {
+                LLAMA_LOG_INFO("%s: runtime ShortGPT layer pruning active: skipping layers %d to %d (%d/%d layers active, ~%.1f%% bandwidth saved)\n",
+                               __func__, prune_layer_start, prune_layer_end,
+                               total_layers - (prune_layer_end - prune_layer_start + 1), total_layers,
+                               100.0f * (prune_layer_end - prune_layer_start + 1) / total_layers);
+                logged = true;
+            }
+        }
+    } else if (env_ratio && *env_ratio) {
+        float ratio = (float) atof(env_ratio);
+        if (ratio > 0.0f && ratio < 1.0f) {
+            int drop_count = (int) std::round(total_layers * (1.0f - ratio));
+            if (drop_count > 0 && drop_count < total_layers) {
+                prune_layer_start = (total_layers - drop_count) / 2;
+                prune_layer_end   = prune_layer_start + drop_count - 1;
+                static bool logged = false;
+                if (!logged) {
+                    LLAMA_LOG_INFO("%s: runtime ShortGPT keep-ratio %.2f active: skipping middle layers %d to %d (%d/%d layers active, ~%.1f%% bandwidth saved)\n",
+                                   __func__, ratio, prune_layer_start, prune_layer_end,
+                                   total_layers - drop_count, total_layers,
+                                   100.0f * drop_count / total_layers);
+                    logged = true;
+                }
+            }
+        }
+    }
+}

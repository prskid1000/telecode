index a187c27..95f1fe3 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -856,6 +856,15 @@ struct llama_model {
     int64_t t_load_us  = 0;
     int64_t t_start_us = 0;
 

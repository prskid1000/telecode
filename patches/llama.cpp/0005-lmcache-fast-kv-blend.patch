diff --git a/src/llama-lmcache.cpp b/src/llama-lmcache.cpp
new file mode 100644
index 0000000..133f2f6
--- /dev/null
+++ b/src/llama-lmcache.cpp
@@ -0,0 +1,254 @@
+#include "llama-lmcache.h"
+#include "llama-impl.h"
+#define XXH_INLINE_ALL
+#include "../vendor/hash/xxhash/xxhash.h"
+
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+
+namespace fs = std::filesystem;
+
+static inline int64_t get_now_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static inline uint64_t fast_xxh3_tokens(const llama_token * tokens, size_t n_tokens, uint64_t seed) {
+    if (n_tokens == 0) return seed;
+    return XXH3_64bits_withSeed(reinterpret_cast<const void *>(tokens), n_tokens * sizeof(llama_token), seed);
+}
+
+llama_lmcache & llama_lmcache::instance() {
+    static llama_lmcache inst;
+    return inst;
+}
+
+llama_lmcache::llama_lmcache() {
+    // Start persistent background disk worker
+    m_disk_worker = std::thread(&llama_lmcache::disk_worker_loop, this);
+}
+
+llama_lmcache::~llama_lmcache() {
+    shutdown();
+}
+
+void llama_lmcache::shutdown() {
+    if (!m_stop_worker.exchange(true)) {
+        m_disk_cv.notify_all();
+        if (m_disk_worker.joinable()) {
+            m_disk_worker.join();
+        }
+    }
+}
+
+void llama_lmcache::init(const llama_lmcache_params & params) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_params = params;
+    if (m_params.disk_enabled && !m_params.disk_dir.empty()) {
+        try {
+            fs::create_directories(m_params.disk_dir);
+        } catch (...) {
+            // directory creation failure handled gracefully
+        }
+    }
+}
+
+uint64_t llama_lmcache::hash_chunk(const llama_token * tokens, size_t n_tokens, uint64_t prev_seed) const {
+    return fast_xxh3_tokens(tokens, n_tokens, prev_seed);
+}
+
+lmcache_match_plan llama_lmcache::match_prompt(const std::vector<llama_token> & tokens) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    lmcache_match_plan plan;
+    if (!m_params.enabled || tokens.empty() || m_params.chunk_size <= 0) {
+        return plan;
+    }
+
+    const size_t chunk_sz = static_cast<size_t>(m_params.chunk_size);
+    size_t pos = 0;
+    uint64_t chain_hash = 0;
+
+    // 1. Chained prefix scan (exact historical dependency)
+    while (pos + chunk_sz <= tokens.size()) {
+        chain_hash = fast_xxh3_tokens(tokens.data() + pos, chunk_sz, chain_hash);
+        if (m_index.find(chain_hash) != m_index.end()) {
+            plan.n_prefix_tokens += static_cast<int32_t>(chunk_sz);
+            pos += chunk_sz;
+        } else {
+            break;
+        }
+    }
+
+    // 2. CacheBlend non-prefix chunk scan (isolated block content matching)
+    if (m_params.blend && pos + static_cast<size_t>(m_params.blend_min_tokens) <= tokens.size()) {
+        while (pos + chunk_sz <= tokens.size()) {
+            uint64_t isolated_hash = fast_xxh3_tokens(tokens.data() + pos, chunk_sz, 0);
+            if (m_index.find(isolated_hash) != m_index.end()) {
+                plan.blended_ranges.push_back({pos, chunk_sz});
+                plan.n_blended_tokens += static_cast<int32_t>(chunk_sz);
+                pos += chunk_sz;
+            } else {
+                pos += chunk_sz;
+            }
+        }
+    }
+
+    return plan;
+}
+
+bool llama_lmcache::get_chunk(uint64_t hash, lmcache_chunk & out_chunk) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_index.find(hash);
+    if (it != m_index.end()) {
+        // Move to front of LRU list
+        m_ram_chunks.splice(m_ram_chunks.begin(), m_ram_chunks, it->second);
+        it->second->last_used = get_now_ms();
+        out_chunk = *it->second;
+        return true;
+    }
+
+    if (m_params.disk_enabled) {
+        if (load_from_disk(hash, out_chunk)) {
+            // Populate L2 RAM cache from L3 NVMe disk
+            m_ram_chunks.push_front(out_chunk);
+            m_index[hash] = m_ram_chunks.begin();
+            m_current_ram_bytes += out_chunk.size_bytes;
+            evict_if_needed();
+            return true;
+        }
+    }
+
+    return false;
+}
+
+void llama_lmcache::put_chunk(uint64_t hash, const llama_token * tokens, size_t n_tokens, const uint8_t * data, size_t data_size) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_params.enabled || data_size == 0) {
+        return;
+    }
+
+    auto it = m_index.find(hash);
+    if (it != m_index.end()) {
+        // Update existing chunk in RAM
+        m_current_ram_bytes -= it->second->size_bytes;
+        it->second->data.assign(data, data + data_size);
+        it->second->tokens.assign(tokens, tokens + n_tokens);
+        it->second->size_bytes = data_size;
+        it->second->last_used = get_now_ms();
+        m_current_ram_bytes += data_size;
+        m_ram_chunks.splice(m_ram_chunks.begin(), m_ram_chunks, it->second);
+    } else {
+        // Insert new chunk into LRU
+        lmcache_chunk chunk;
+        chunk.hash = hash;
+        chunk.tokens.assign(tokens, tokens + n_tokens);
+        chunk.data.assign(data, data + data_size);
+        chunk.size_bytes = data_size;
+        chunk.last_used = get_now_ms();
+
+        m_ram_chunks.push_front(std::move(chunk));
+        m_index[hash] = m_ram_chunks.begin();
+        m_current_ram_bytes += data_size;
+    }
+
+    evict_if_needed();
+
+    // Queue for NVMe SSD storage via dedicated worker thread
+    if (m_params.disk_enabled && !m_params.disk_dir.empty()) {
+        std::lock_guard<std::mutex> qlock(m_disk_mutex);
+        lmcache_disk_task task;
+        task.hash = hash;
+        task.data.assign(data, data + data_size);
+        m_disk_queue.push(std::move(task));
+        m_disk_cv.notify_one();
+    }
+}
+
+void llama_lmcache::evict_if_needed() {
+    const size_t max_ram_bytes = static_cast<size_t>(m_params.ram_mb) * 1024ULL * 1024ULL;
+    if (max_ram_bytes == 0) return;
+
+    // Watermark eviction: if exceeding high watermark (95%), trim down to 85%
+    if (m_current_ram_bytes > max_ram_bytes) {
+        const size_t target_bytes = static_cast<size_t>(max_ram_bytes * 0.85);
+        while (m_current_ram_bytes > target_bytes && !m_ram_chunks.empty()) {
+            auto & victim = m_ram_chunks.back();
+            m_current_ram_bytes -= victim.size_bytes;
+            m_index.erase(victim.hash);
+            m_ram_chunks.pop_back();
+        }
+    }
+}
+
+void llama_lmcache::clear() {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_ram_chunks.clear();
+    m_index.clear();
+    m_current_ram_bytes = 0;
+}
+
+void llama_lmcache::disk_worker_loop() {
+    while (!m_stop_worker.load()) {
+        lmcache_disk_task task;
+        {
+            std::unique_lock<std::mutex> lock(m_disk_mutex);
+            m_disk_cv.wait(lock, [this]() {
+                return m_stop_worker.load() || !m_disk_queue.empty();
+            });
+
+            if (m_stop_worker.load() && m_disk_queue.empty()) {
+                break;
+            }
+
+            if (!m_disk_queue.empty()) {
+                task = std::move(m_disk_queue.front());
+                m_disk_queue.pop();
+            } else {
+                continue;
+            }
+        }
+
+        if (m_params.disk_dir.empty() || task.data.empty()) continue;
+
+        try {
+            fs::path p = fs::path(m_params.disk_dir) / (std::to_string(task.hash) + ".bin");
+            FILE * fp = fopen(p.string().c_str(), "wb");
+            if (fp) {
+                fwrite(task.data.data(), 1, task.data.size(), fp);
+                fclose(fp);
+            }
+        } catch (...) {
+            // Silently suppress disk write failures in hot path
+        }
+    }
+}
+
+bool llama_lmcache::load_from_disk(uint64_t hash, lmcache_chunk & out_chunk) {
+    if (m_params.disk_dir.empty()) return false;
+    try {
+        fs::path p = fs::path(m_params.disk_dir) / (std::to_string(hash) + ".bin");
+        FILE * fp = fopen(p.string().c_str(), "rb");
+        if (!fp) return false;
+
+        fseek(fp, 0, SEEK_END);
+        long sz = ftell(fp);
+        if (sz <= 0) {
+            fclose(fp);
+            return false;
+        }
+        fseek(fp, 0, SEEK_SET);
+
+        out_chunk.hash = hash;
+        out_chunk.data.resize(sz);
+        out_chunk.size_bytes = static_cast<size_t>(sz);
+        out_chunk.last_used = get_now_ms();
+
+        size_t n_read = fread(out_chunk.data.data(), 1, sz, fp);
+        fclose(fp);
+
+        return n_read == static_cast<size_t>(sz);
+    } catch (...) {
+        return false;
+    }
+}
diff --git a/src/llama-lmcache.h b/src/llama-lmcache.h
new file mode 100644
index 0000000..5a3f2c4
--- /dev/null
+++ b/src/llama-lmcache.h
@@ -0,0 +1,97 @@
+#pragma once
+
+#include "llama.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <unordered_map>
+#include <list>
+#include <mutex>
+#include <memory>
+#include <thread>
+#include <queue>
+#include <condition_variable>
+#include <atomic>
+
+struct llama_lmcache_params {
+    bool        enabled           = false;
+    int32_t     chunk_size        = 256;
+    int32_t     ram_mb            = 16384;
+    bool        disk_enabled      = false;
+    std::string disk_dir          = "./data/lmcache";
+    int32_t     disk_max_mb       = 65536;
+    bool        blend             = false;
+    float       blend_recompute   = 0.15f;
+    int32_t     blend_min_tokens  = 128;
+    std::string compression       = "q8_0";
+    bool        async_save        = true;
+};
+
+struct lmcache_match_plan {
+    int32_t n_prefix_tokens = 0;
+    int32_t n_blended_tokens = 0;
+    std::vector<std::pair<size_t, size_t>> blended_ranges; // [start_pos, count]
+};
+
+struct lmcache_chunk {
+    uint64_t hash = 0;
+    std::vector<llama_token> tokens;
+    std::vector<uint8_t> data;
+    size_t size_bytes = 0;
+    int64_t last_used = 0;
+};
+
+struct lmcache_disk_task {
+    uint64_t hash = 0;
+    std::vector<uint8_t> data;
+};
+
+class LLAMA_API llama_lmcache {
+public:
+    static llama_lmcache & instance();
+
+    void init(const llama_lmcache_params & params);
+    void shutdown();
+    bool is_enabled() const { return m_params.enabled; }
+    const llama_lmcache_params & params() const { return m_params; }
+
+    // Fast SIMD token hashing (isolated or cumulative chained)
+    uint64_t hash_chunk(const llama_token * tokens, size_t n_tokens, uint64_t prev_seed = 0) const;
+
+    // Check if prompt chunks are in cache; returns matched prefix count and blended ranges
+    lmcache_match_plan match_prompt(const std::vector<llama_token> & tokens) const;
+
+    // Retrieve chunk by hash (L2 RAM -> L3 Disk)
+    bool get_chunk(uint64_t hash, lmcache_chunk & out_chunk);
+
+    // Store chunk into L2 RAM and queue for L3 Disk
+    void put_chunk(uint64_t hash, const llama_token * tokens, size_t n_tokens, const uint8_t * data, size_t data_size);
+
+    // Prune storage to limits
+    void evict_if_needed();
+
+    // Clear all in-memory entries
+    void clear();
+
+private:
+    llama_lmcache();
+    ~llama_lmcache();
+
+    llama_lmcache_params m_params;
+    mutable std::mutex m_mutex;
+
+    std::list<lmcache_chunk> m_ram_chunks; // LRU list
+    std::unordered_map<uint64_t, std::list<lmcache_chunk>::iterator> m_index;
+    size_t m_current_ram_bytes = 0;
+
+    // Dedicated background I/O worker (zero thread-spawning overhead)
+    std::thread m_disk_worker;
+    std::queue<lmcache_disk_task> m_disk_queue;
+    std::mutex m_disk_mutex;
+    std::condition_variable m_disk_cv;
+    std::atomic<bool> m_stop_worker{false};
+
+    void disk_worker_loop();
+    bool load_from_disk(uint64_t hash, lmcache_chunk & out_chunk);
+};

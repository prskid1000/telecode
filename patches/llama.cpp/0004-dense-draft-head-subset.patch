+llama_head_subset::llama_head_subset(const llama_model & model, ggml_backend_buffer_type_t dev_buft, int32_t n_req, const std::string & ids_file) {
+    src = model.output;
+    const ggml_tensor * src_scale = model.output_s;
+    for (const auto & layer : model.layers) {
+        // a model whose MTP layer has a head of its own drafts with that one
+        if (layer.nextn.shared_head_head != nullptr) {
+            src = layer.nextn.shared_head_head;
+            src_scale = layer.nextn.shared_head_head_s;
+            break;
+        }
+    }
+    // the memory fit loads the model without weights and may place the head on the GPU: it only needs the size, so no host check there
+    if (src == nullptr || (!model.hparams.no_alloc && (src->buffer == nullptr || !ggml_backend_buffer_is_host(src->buffer)))) {
+        throw std::runtime_error("the output head is not in host memory");
+    }
+    if (src_scale != nullptr || src->ne[2] != 1 || src->ne[3] != 1 || ggml_is_transposed(src)) {
+        throw std::runtime_error("the output head cannot be split by rows");
+    }
+
+    const int64_t n_vocab = src->ne[1];
+    // the special tokens of the common vocabularies are the last ones
+    const int64_t n_last  = std::min<int64_t>(1024, n_vocab/4);
+    // the first rows: the ranked tokens of ids_file, else the first tokens of the vocabulary (the most frequent ones of a BPE vocabulary)
+    std::vector<int32_t> first;
+    if (!ids_file.empty()) {
+        std::ifstream in(ids_file);
+        std::vector<char> taken(n_vocab, 0);
+        int64_t id;
+        while ((int64_t) first.size() < std::max<int64_t>(n_req, 1) && in >> id) {
+            if (id >= 0 && id < n_vocab - n_last && !taken[id]) {
+                taken[id] = 1;
+                first.push_back((int32_t) id);
+            }
+        }
+        if (first.empty()) {
+            LLAMA_LOG_WARN("%s: no usable token ids in '%s', using the first tokens of the vocabulary\n", __func__, ids_file.c_str());
+        }
+    }
+    if (first.empty()) {
+        first.resize(std::min<int64_t>(std::max<int64_t>(n_req, 1), n_vocab - n_last));
+        std::iota(first.begin(), first.end(), 0);
+    }
+    const int64_t n_first = first.size();
+    n_rows = n_first + n_last;
+    if (n_rows >= n_vocab) {
+        throw std::runtime_error("the subset would be the whole head");
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ 2*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ctx.reset(ggml_init(params));
+    if (!ctx) {
+        throw std::runtime_error("failed to create the head subset context");
+    }
+    w   = ggml_new_tensor_2d(ctx.get(), src->type, src->ne[0], n_rows);
+    ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, n_rows);
+    ggml_set_name(w,   "head_subset.weight");
+    ggml_set_name(ids, "head_subset.ids");
+    GGML_ASSERT(w->nb[1] == src->nb[1]);
+
+    buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), dev_buft));
+    if (!buf) {
+        throw std::runtime_error("failed to allocate the head subset");
+    }
+    buft = dev_buft;
+    size = ggml_backend_buffer_get_size(buf.get());
+    // as weights, the ops that read it run on the device that holds it
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // the memory fit of the server loads the model without weights: the buffer is counted, nothing is copied
+    if (!model.hparams.no_alloc) {
+        const size_t row = src->nb[1];
+        for (int64_t i = 0; i < n_first; ) {
+            int64_t run = 1; // consecutive token ids are one copy
+            while (i + run < n_first && first[i + run] == first[i] + run) {
+                run++;
+            }
+            ggml_backend_tensor_set(w, (const uint8_t *) src->data + (size_t) first[i]*row, i*row, run*row);
+            i += run;
+        }
+        ggml_backend_tensor_set(w, (const uint8_t *) src->data + (n_vocab - n_last)*row, n_first*row, n_last*row);
+
+        std::vector<int32_t> tokens(n_rows);
+        std::copy(first.begin(), first.end(), tokens.begin());
+        for (int64_t i = 0; i < n_last; ++i) {
+            tokens[n_first + i] = (int32_t) (n_vocab - n_last + i);
+        }
+        ggml_backend_tensor_set(ids, tokens.data(), 0, ggml_nbytes(ids));
+    }
+
+    LLAMA_LOG_INFO("%s: %" PRId64 " of %" PRId64 " rows of the output head on the device, %.2f MiB\n", __func__,
+            n_rows, n_vocab, size/1024.0/1024.0);
+}
 

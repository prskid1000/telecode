+        while (output_rows.size() > 1) {
+            std::vector<ggml_tensor *> next;
+            for (size_t i = 0; i < output_rows.size(); i += 2) {
+                next.push_back(i + 1 < output_rows.size() ? ggml_concat(ctx0, output_rows[i], output_rows[i + 1], 1) :
+                                                            output_rows[i]);
+            }

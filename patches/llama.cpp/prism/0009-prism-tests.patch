+            while (first < spec_tokens.size() && first < ar_tokens.size() && spec_tokens[first] == ar_tokens[first]) {
+                ++first;
+            }
+            fprintf(stderr, "AR parity FAILED: prompt=%zu first_difference=%zu AR=%d spec=%d\n", pi, first,

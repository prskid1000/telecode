+        ggml_tensor * rows = ggml_reshape_2d(ctx0, head_subset->ids, n_rows, 1);
+        full = ggml_set_rows(ctx0, full, ggml_reshape_3d(ctx0, sub, 1, n_rows, cur->ne[1]), rows);
+        return ggml_reshape_2d(ctx0, full, n_vocab, cur->ne[1]);
+    }
+
     cur = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur);
 

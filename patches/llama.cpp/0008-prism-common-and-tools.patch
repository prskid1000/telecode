+            for (llama_seq_id seq = 0; seq < (llama_seq_id) n_seq; ++seq) {
+                std::unique_ptr<llama_sampler, decltype(&llama_sampler_free)> chain(
+                    llama_sampler_chain_init(llama_sampler_chain_default_params()), llama_sampler_free);

+// chooses the draft length of a round: the one with the best expected tokens per ms
+// estimates: acceptance of each draft position given the earlier ones, and the time of a round with a window of t tokens (draft + verify)
+struct common_spec_policy {
+    int   k_max;
+    float min_gain;
+    float ema;
+    int   probe_every;
+
+    std::vector<double> p;       // [k_max] acceptance of position i given the positions before it
+    std::vector<double> cost_ms; // [k_max + 1] round time by window size t = k + 1, index 0 unused
+    std::vector<int>    cost_n;
+    int rounds = 0;
+    int since_probe = 0;
+    int probe_dir = 1;
+    int zero_calls = 0;
+    int n_min = 0; // the smallest draft the drafter keeps

From: DeepInfer Port <support@telecode.ai>
Subject: [PATCH] DeepInfer Multi-Stream Parallelism & Asynchronous Pipeline

1. Discrete multi-batch CUDA graph runners (CudaGraphRunner) keyed on (first_node, n_nodes, batch_size)
   so alternating single and parallel slot execution does not reset or invalidate graph captures.
2. Zero-overhead asynchronous pipeline (ZOS) deferring GPU-blocking synchronization from the task yield
   loop into sampling, letting the CPU worker process task queues concurrently with GPU forward pass.

---
diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 6b36ca9..bbdf4af 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1261,6 +1261,31 @@ struct ggml_tensor_extra_gpu {
 #define USE_CUDA_GRAPH
 #endif
 
+#ifdef USE_CUDA_GRAPH
+struct ggml_cuda_graph_key {
+    const void * first_node = nullptr;
+    int64_t      n_nodes    = 0;
+    int64_t      batch_size = 1;
+
+    bool operator==(const ggml_cuda_graph_key & o) const {
+        return first_node == o.first_node && n_nodes == o.n_nodes && batch_size == o.batch_size;
+    }
+};
+
+struct ggml_cuda_graph_key_hash {
+    size_t operator()(const ggml_cuda_graph_key & k) const {
+        size_t h = std::hash<const void *>{}(k.first_node);
+        h ^= std::hash<int64_t>{}(k.n_nodes) + 0x9e3779b9 + (h << 6) + (h >> 2);
+        h ^= std::hash<int64_t>{}(k.batch_size) + 0x9e3779b9 + (h << 6) + (h >> 2);
+        return h;
+    }
+};
+#else
+struct ggml_cuda_graph_key {
+    const void * first_node = nullptr;
+};
+#endif
+
 struct ggml_cuda_graph {
 #ifdef USE_CUDA_GRAPH
     ~ggml_cuda_graph() {
@@ -1457,11 +1482,14 @@ struct ggml_backend_cuda_context {
 #ifdef USE_CUDA_GRAPH
     // Map from first_node_ptr to cuda_graph - allows multiple graphs per context
     // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe)
-    std::unordered_map<const void *, std::unique_ptr<ggml_cuda_graph>> cuda_graphs;
+    // Map from graph key (first_node, n_nodes, batch_size) to cuda_graph.
+    // DeepInfer-style bucketed multi-batch graph caching: preserves separate CUDA graphs
+    // for concurrent batch sizes (e.g. 1, 2, 4 tokens) so parallel streams don't invalidate each other.
+    std::unordered_map<ggml_cuda_graph_key, std::unique_ptr<ggml_cuda_graph>, ggml_cuda_graph_key_hash> cuda_graphs;
 
     int64_t last_graph_eviction_sweep = 0;
 
-    ggml_cuda_graph * cuda_graph(const void * first_node_ptr) {
+    ggml_cuda_graph * cuda_graph(const ggml_cuda_graph_key & key) {
         const int64_t time_now = ggml_time_us();
 
         // sweep every 5s, evicting cuda graphs unused for >=10s
@@ -1476,9 +1504,9 @@ struct ggml_backend_cuda_context {
             }
         }
 
-        auto it = cuda_graphs.find(first_node_ptr);
+        auto it = cuda_graphs.find(key);
         if (it == cuda_graphs.end()) {
-            it = cuda_graphs.emplace(first_node_ptr, std::make_unique<ggml_cuda_graph>()).first;
+            it = cuda_graphs.emplace(key, std::make_unique<ggml_cuda_graph>()).first;
         }
         it->second->last_used_time = time_now;
         return it->second.get();
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 441c102..6f8d0f9 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2839,14 +2839,29 @@ static bool ggml_cuda_graph_check_compability(ggml_cgraph * cgraph) {
     return use_cuda_graph;
 }
 
-static const void * ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
-    return cgraph->nodes[0];
+static ggml_cuda_graph_key ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
+#ifdef USE_CUDA_GRAPH
+    int64_t batch_size = 1;
+    if (cgraph->n_nodes > 0) {
+        const ggml_tensor * last_node = cgraph->nodes[cgraph->n_nodes - 1];
+        if (last_node->ne[1] > 1) {
+            batch_size = last_node->ne[1];
+        } else if (cgraph->nodes[0]->ne[1] > 1) {
+            batch_size = cgraph->nodes[0]->ne[1];
+        } else if (cgraph->nodes[0]->ne[0] > 1) {
+            batch_size = cgraph->nodes[0]->ne[0];
+        }
+    }
+    return { cgraph->nodes[0], (int64_t) cgraph->n_nodes, batch_size };
+#else
+    return { cgraph->n_nodes > 0 ? cgraph->nodes[0] : nullptr };
+#endif
 }
 

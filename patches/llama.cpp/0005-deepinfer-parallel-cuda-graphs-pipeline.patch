diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 828fad0..9abaaa5 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -4639,7 +4639,17 @@ private:
         queue_tasks.yield_to_queue([&]() {
             ret = llama_process(ctx_tgt, LLAMA_PROCESS_TYPE_DECODE, batch.view.get());
             if (ret == 0 && has_output) {
-                llama_synchronize(ctx_tgt);
+                // DeepInfer-style Asynchronous Scheduling Pipeline (ZOS):
+                // Defer blocking GPU synchronization to common_sampler_sample / llama_get_logits_ith
+                // so the CPU worker thread can overlap slot handling and queue tasks with device execution.
+                // Off by default: the wait inside yield_to_queue is when the queue is served, deferring it moves the wait out of the yield
+                static const bool defer_sync = []() {
+                    const char * env = getenv("LLAMA_SERVER_ASYNC_DECODE");
+                    return env != nullptr && atoi(env) != 0; // LLAMA_SERVER_ASYNC_DECODE=1 enables it
+                }();
+                if (!defer_sync) {
+                    llama_synchronize(ctx_tgt);
+                }
             }
         });
 

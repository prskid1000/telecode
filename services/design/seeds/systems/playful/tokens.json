  "typography": {
    "fontFamily": {
      "display": {
        "family": "Fredoka",
        "stack": "'Fredoka', ui-rounded, 'Arial Rounded MT Bold', system-ui, sans-serif"
      },
      "body": {
        "family": "Nunito",
        "stack": "'Nunito', ui-rounded, system-ui, sans-serif"
      },
      "ui": {
        "family": "Nunito",
        "stack": "'Nunito', ui-rounded, system-ui, sans-serif"
      },
      "mono": {
        "family": "DM Mono",
        "stack": "'DM Mono', ui-monospace, Consolas, monospace"
      }
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "fontSize": {
      "xs": "13px",
      "sm": "15px",
      "base": "17px",
      "lg": "19px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "36px",
      "4xl": "48px",
      "5xl": "64px"
    },
    "lineHeight": {
      "tight": "1.1",
      "snug": "1.3",
      "normal": "1.55",
      "relaxed": "1.7"
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0em",
      "wide": "0.03em"
    }
  },
  "spacing": {
    "0": "0px",
    "px": "1px",
    "0-5": "2px",
    "1": "4px",
    "1-5": "6px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "xl": "28px",
    "full": "9999px",
    "control": "9999px",
    "surface": "var(--radius-xl)",
    "input": "var(--radius-md)",
    "badge": "var(--radius-full)"
  },
  "shadow": {
    "light": {
      "xs": "0 2px 0 0 oklch(0.25 0.04 290 / 8%)",
      "sm": "0 3px 0 0 oklch(0.25 0.04 290 / 10%)",
      "md": "0 6px 0 -1px oklch(0.25 0.04 290 / 10%), 0 12px 24px -8px oklch(0.25 0.04 290 / 16%)",
      "lg": "0 10px 0 -2px oklch(0.25 0.04 290 / 10%), 0 24px 48px -12px oklch(0.25 0.04 290 / 22%)"
    },
    "dark": {
      "xs": "0 2px 0 0 oklch(0 0 0 / 30%)",
      "sm": "0 3px 0 0 oklch(0 0 0 / 35%)",
      "md": "0 6px 0 -1px oklch(0 0 0 / 35%), 0 12px 24px -8px oklch(0 0 0 / 50%)",
      "lg": "0 10px 0 -2px oklch(0 0 0 / 35%), 0 24px 48px -12px oklch(0 0 0 / 60%)"
    }
  },
  "motion": {
    "duration": {
      "fast": "140ms",
      "base": "220ms",
      "slow": "360ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.3, 0, 0.2, 1)",
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "emphasis": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "component": {
    "control-h-sm": "36px",
    "control-h-md": "44px",
    "control-h-lg": "52px",
    "control-border-width": "2px",
    "ring-width": "4px",
    "nav-h": "68px",
    "row-h-compact": "44px",
    "row-h-comfortable": "56px",
    "button-font": "var(--font-ui)",
    "button-weight": "800",
    "button-case": "none",
    "button-tracking": "0.01em",
    "button-shadow": "var(--shadow-sm)",
    "button-press": "2px",
    "card-shadow": "var(--shadow-md)",
    "badge-font": "var(--font-ui)",
    "badge-case": "none",
    "table-head-font": "var(--font-ui)",
    "table-head-case": "none"
  }

  "typography": {
    "fontFamily": {
      "display": {
        "family": "IBM Plex Sans",
        "stack": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif"
      },
      "body": {
        "family": "IBM Plex Sans",
        "stack": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif"
      },
      "ui": {
        "family": "IBM Plex Sans",
        "stack": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "family": "IBM Plex Mono",
        "stack": "'IBM Plex Mono', ui-monospace, Consolas, monospace"
      }
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "13px",
      "lg": "14px",
      "xl": "16px",
      "2xl": "20px",
      "3xl": "24px",
      "4xl": "30px",
      "5xl": "40px"
    },
    "lineHeight": {
      "tight": "1.2",
      "snug": "1.3",
      "normal": "1.5",
      "relaxed": "1.6"
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0em",
      "wide": "0.06em"
    }
  },
  "spacing": {
    "0": "0px",
    "px": "1px",
    "0-5": "2px",
    "1": "4px",
    "1-5": "6px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "sm": "3px",
    "md": "4px",
    "lg": "6px",
    "xl": "8px",
    "full": "9999px",
    "control": "var(--radius-md)",
    "surface": "var(--radius-lg)",
    "input": "var(--radius-md)",
    "badge": "var(--radius-sm)"
  },
  "shadow": {
    "light": {
      "xs": "0 1px 1px 0 oklch(0.2 0.01 250 / 6%)",
      "sm": "0 1px 2px 0 oklch(0.2 0.01 250 / 10%)",
      "md": "0 4px 10px -2px oklch(0.2 0.01 250 / 14%)",
      "lg": "0 12px 28px -8px oklch(0.2 0.01 250 / 22%)"
    },
    "dark": {
      "xs": "0 1px 1px 0 oklch(0 0 0 / 40%)",
      "sm": "0 1px 2px 0 oklch(0 0 0 / 50%)",
      "md": "0 4px 12px -2px oklch(0 0 0 / 60%)",
      "lg": "0 12px 28px -8px oklch(0 0 0 / 70%)"
    }
  },
  "motion": {
    "duration": {
      "fast": "80ms",
      "base": "120ms",
      "slow": "200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "emphasis": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "component": {
    "control-h-sm": "26px",
    "control-h-md": "30px",
    "control-h-lg": "36px",
    "control-border-width": "1px",
    "ring-width": "2px",
    "nav-h": "44px",
    "row-h-compact": "28px",
    "row-h-comfortable": "36px",
    "button-font": "var(--font-ui)",
    "button-weight": "500",
    "button-case": "none",
    "button-tracking": "0em",
    "button-shadow": "none",
    "button-press": "0px",
    "card-shadow": "none",
    "badge-font": "var(--font-mono)",
    "badge-case": "uppercase",
    "table-head-font": "var(--font-mono)",
    "table-head-case": "uppercase"
  }
}

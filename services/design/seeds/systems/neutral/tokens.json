      "5xl": "48px"
    },
    "lineHeight": {
      "tight": "1.2",
      "snug": "1.35",
      "normal": "1.5",
      "relaxed": "1.65"
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.02em"
    }
  },
  "spacing": {
    "0": "0px",
    "px": "1px",

  "typography": {
    "fontFamily": {
      "display": {
        "family": "Fraunces",
        "stack": "'Fraunces', Georgia, 'Times New Roman', serif"
      },
      "body": {
        "family": "Source Serif 4",
        "stack": "'Source Serif 4', Georgia, 'Times New Roman', serif"
      },
      "ui": {
        "family": "Instrument Sans",
        "stack": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "family": "IBM Plex Mono",
        "stack": "'IBM Plex Mono', ui-monospace, Consolas, monospace"
      }
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "fontSize": {
      "xs": "13px",
      "sm": "15px",
      "base": "18px",
      "lg": "21px",
      "xl": "24px",
      "2xl": "30px",
      "3xl": "40px",
      "4xl": "56px",
      "5xl": "76px"
    },
    "lineHeight": {
      "tight": "1.08",
      "snug": "1.25",
      "normal": "1.6",
      "relaxed": "1.75"
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "normal": "0em",
      "wide": "0.08em"
    }
  },
  "spacing": {
    "0": "0px",
    "px": "1px",
    "0-5": "2px",
    "1": "4px",
    "1-5": "6px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "sm": "2px",
    "md": "3px",
    "lg": "4px",
    "xl": "6px",
    "full": "9999px",
    "control": "var(--radius-sm)",
    "surface": "var(--radius-md)",
    "input": "var(--radius-sm)",
    "badge": "var(--radius-sm)"
  },
  "shadow": {
    "light": {
      "xs": "0 1px 0 0 oklch(0.4 0.03 60 / 8%)",
      "sm": "0 1px 2px 0 oklch(0.4 0.03 60 / 10%)",
      "md": "0 6px 16px -6px oklch(0.35 0.04 50 / 18%)",
      "lg": "0 18px 40px -12px oklch(0.3 0.04 50 / 24%)"
    },
    "dark": {
      "xs": "0 1px 0 0 oklch(0 0 0 / 30%)",
      "sm": "0 1px 2px 0 oklch(0 0 0 / 40%)",
      "md": "0 6px 16px -6px oklch(0 0 0 / 50%)",
      "lg": "0 18px 40px -12px oklch(0 0 0 / 60%)"
    }
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "240ms",
      "slow": "420ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "emphasis": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
  "component": {
    "control-h-sm": "32px",
    "control-h-md": "40px",
    "control-h-lg": "48px",
    "control-border-width": "1px",
    "ring-width": "2px",
    "nav-h": "64px",
    "row-h-compact": "40px",
    "row-h-comfortable": "52px",
    "button-font": "var(--font-ui)",
    "button-weight": "600",
    "button-case": "uppercase",
    "button-tracking": "0.08em",
    "button-shadow": "none",
    "button-press": "0px",
    "card-shadow": "none",
    "badge-font": "var(--font-ui)",
    "badge-case": "uppercase",
    "table-head-font": "var(--font-ui)",
    "table-head-case": "uppercase"
  }
}

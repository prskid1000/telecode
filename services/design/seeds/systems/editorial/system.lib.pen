  "children": [
    {
      "type": "note",
      "id": "lib-note",
      "name": "About this library",
      "x": 0,
      "y": -160,
      "width": 640,
      "height": 120,
      "content": "TeleDesign seed library — Editorial. Generated from tokens.json; every fill, radius, size and font is bound to a variable. Theme axis Mode (Light default / Dark). Components are reusable frames named Component/Variant[/Size]; instantiate with ref and override text via descendants."
    },
    {
      "type": "frame",
      "id": "btn-primary-sm",
      "name": "Button/Primary/Small",
      "reusable": true,
      "x": 0,
      "y": 0,
      "layout": "horizontal",
      "gap": "$--space-2",
      "padding": [
        0,
        "$--space-3"
      ],
      "height": "$--control-h-sm",
      "justifyContent": "center",
      "alignItems": "center",
      "cornerRadius": "$--radius-control",
      "children": [
        {
          "type": "text",
          "id": "btn-primary-sm-label",
          "name": "Label",
          "content": "BUTTON",
          "fill": "$--primary-foreground",
          "fontFamily": "$--font-ui",
          "fontSize": "$--text-xs",
          "fontWeight": "$--button-weight"
        }
      ],
      "fill": "$--primary"
    },
    {

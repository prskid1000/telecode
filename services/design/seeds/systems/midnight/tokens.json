  "typography": {
    "fontFamily": {
      "display": {
        "family": "Manrope",
        "stack": "'Manrope', ui-sans-serif, system-ui, sans-serif"
      },
      "body": {
        "family": "Manrope",
        "stack": "'Manrope', ui-sans-serif, system-ui, sans-serif"
      },
      "ui": {
        "family": "Manrope",
        "stack": "'Manrope', ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "family": "JetBrains Mono",
        "stack": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace"
      }
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "15px",
      "lg": "17px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px",
      "4xl": "44px",
      "5xl": "60px"
    },
    "lineHeight": {
      "tight": "1.1",
      "snug": "1.3",
      "normal": "1.55",
      "relaxed": "1.7"
    },
    "letterSpacing": {
      "tight": "-0.03em",
      "normal": "-0.005em",
      "wide": "0.04em"
    }
  },
  "spacing": {
    "0": "0px",
    "px": "1px",
    "0-5": "2px",
    "1": "4px",
    "1-5": "6px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px",
    "control": "var(--radius-md)",
    "surface": "var(--radius-lg)",
    "input": "var(--radius-md)",
    "badge": "var(--radius-full)"
  },
  "shadow": {
    "light": {
      "xs": "0 1px 2px 0 oklch(0.2 0.05 270 / 6%)",
      "sm": "0 1px 3px 0 oklch(0.2 0.05 270 / 10%)",
      "md": "0 8px 20px -6px oklch(0.2 0.05 270 / 16%)",
      "lg": "0 20px 44px -12px oklch(0.2 0.05 270 / 24%)"
    },
    "dark": {
      "xs": "0 0 0 1px oklch(1 0 0 / 4%)",
      "sm": "0 1px 2px 0 oklch(0 0 0 / 50%), 0 0 0 1px oklch(1 0 0 / 5%)",
      "md": "0 10px 24px -8px oklch(0 0 0 / 60%), 0 0 0 1px oklch(1 0 0 / 6%)",
      "lg": "0 24px 56px -16px oklch(0 0 0 / 70%), 0 0 0 1px oklch(1 0 0 / 7%)"
    }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "180ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "emphasis": "cubic-bezier(0.34, 1.3, 0.64, 1)"
    }
  },
  "component": {
    "control-h-sm": "32px",
    "control-h-md": "36px",
    "control-h-lg": "44px",
    "control-border-width": "1px",
    "ring-width": "3px",
    "nav-h": "60px",
    "row-h-compact": "36px",
    "row-h-comfortable": "48px",
    "button-font": "var(--font-ui)",
    "button-weight": "600",
    "button-case": "none",
    "button-tracking": "-0.005em",
    "button-shadow": "none",
    "button-press": "0px",
    "card-shadow": "none",
    "badge-font": "var(--font-ui)",
    "badge-case": "none",
    "table-head-font": "var(--font-ui)",
    "table-head-case": "none"
  }
